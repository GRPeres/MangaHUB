@page "/"

<PageTitle>MangaHub</PageTitle>

<MudStack Spacing="3" Class="mh-home">
    <MudGrid Spacing="3" Class="mh-home-grid">
        <MudItem xs="12" lg="7">
            <MudPaper Elevation="0" Outlined="true" Class="mh-home-hero-block mh-home-block">
                <MudStack Spacing="3">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">MangaHub</MudText>
                        <MudText Typo="Typo.h1">Your manga shelf, without the spreadsheet drag.</MudText>
                        <MudText Typo="Typo.body1" Class="mh-home-copy">
                            Track reading status, chapters, scores, notes, covers, MAL metadata, local files, and MangaDex links from one quiet place.
                        </MudText>
                    </MudStack>

                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories" OnClick="GoLibrary">Open shelf</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircleOutline" OnClick="GoLibrary">Add to shelf</MudButton>
                        @if (IsAdmin)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Inventory2" OnClick="GoCatalog">Catalog</MudButton>
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" lg="2">
            <MangaInfoBlock Label="Session"
                            Value="@SessionLabel"
                            Icon="@SessionIcon"
                            Tone="@SessionTone"
                            Class="mh-home-block mh-home-tall"
                            OnClick="GoAccountOrLogin" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Elevation="0" Outlined="true" Class="mh-home-block mh-home-action" @onclick="GoLibrary" role="button" tabindex="0">
                <MudIcon Icon="@Icons.Material.Filled.Bookmark" Color="Color.Primary" />
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Next step</MudText>
                    <MudText Typo="Typo.h3">Continue reading</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Your shelf shows current and latest chapters side by side.</MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MangaInfoBlock Label="Metadata"
                            Value="MAL first"
                            Icon="@Icons.Material.Filled.TravelExplore"
                            Tone="source"
                            Class="mh-home-block mh-home-wide"
                            OnClick="GoCatalog" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MangaInfoBlock Label="Fallback"
                            Value="OpenLibrary when useful"
                            Icon="@Icons.Material.Filled.LibraryBooks"
                            Class="mh-home-block" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="2">
            <MangaInfoBlock Label="Import"
                            Value="CSV to shelf"
                            Icon="@Icons.Material.Filled.UploadFile"
                            Tone="progress"
                            Class="mh-home-block mh-home-tall"
                            OnClick="GoLibrary" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="4">
            <MudPaper Elevation="0" Outlined="true" Class="mh-home-block mh-home-action mh-home-admin" @onclick="GoCatalogOrAccount" role="button" tabindex="0">
                <MudIcon Icon="@AdminIcon" Color="@AdminColor" />
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">@AdminEyebrow</MudText>
                    <MudText Typo="Typo.h3">@AdminTitle</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@AdminCopy</MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Elevation="0" Outlined="true" Class="mh-home-block mh-home-flow">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Flow</MudText>
                <MangaBlockGrid Class="mh-home-flow-grid">
                    <MangaBlockItem Size="MangaBlockSize.Wide">
                        <MangaInfoBlock Label="1" Value="Find or create catalog manga" Icon="@Icons.Material.Filled.Inventory2" />
                    </MangaBlockItem>
                    <MangaBlockItem Size="MangaBlockSize.Small">
                        <MangaInfoBlock Label="2" Value="Add it to your shelf" Icon="@Icons.Material.Filled.PlaylistAdd" />
                    </MangaBlockItem>
                    <MangaBlockItem Size="MangaBlockSize.Wide">
                        <MangaInfoBlock Label="3" Value="Track chapter, status, score" Icon="@Icons.Material.Filled.Checklist" Tone="success" />
                    </MangaBlockItem>
                </MangaBlockGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="7">
            <MudPaper Elevation="0" Outlined="true" Class="mh-home-block mh-home-action mh-home-local" @onclick="GoLibrary" role="button" tabindex="0">
                <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Secondary" />
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Reading sources</MudText>
                    <MudText Typo="Typo.h3">Use catalog metadata, then read from MangaDex or your local registry.</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        The catalog stores identity and metadata. Your shelf stores the personal reading state.
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>
