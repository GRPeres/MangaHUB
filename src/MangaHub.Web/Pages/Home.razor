@page "/"
@implements IDisposable
@inject AuthSessionService Auth
@inject NavigationManager Navigation

<PageTitle>MangaHub</PageTitle>

<MudStack Spacing="4">
    <section class="mh-home-hero">
        <MudStack Spacing="3">
            <MudStack Spacing="1">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Manga tracker</MudText>
                <MudText Typo="Typo.h1">Keep your reading life in one quiet place.</MudText>
                <MudText Typo="Typo.body1" Class="mh-hero-copy">
                    Your shelf, current chapters, scores, notes, MAL metadata, MangaDex links, and local files all meet here.
                </MudText>
            </MudStack>
            <MudStack Row="true" Spacing="2" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories" OnClick="GoLibrary">Open shelf</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircleOutline" OnClick="GoLibrary">Add manga</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ManageAccounts" OnClick="GoAccount">Account</MudButton>
            </MudStack>
        </MudStack>
       @*  <div class="mh-home-pulse">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Current build</MudText>
            <MudText Typo="Typo.h3">Home refresh</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">If you can see this panel, TrueNAS pulled the new web build.</MudText>
        </div> *@
    </section>

    <MangaBento Columns="4" Class="mh-home-bento">
        <MangaBentoTile ColSpan="2" RowSpan="2" Scheme="deep" CornerIcon="@Icons.Material.Filled.MenuBook" OnClick="GoLibrary">
            <div class="mh-home-block mh-home-block-main">
                <MudText Typo="Typo.overline">Your shelf</MudText>
                <MudText Typo="Typo.h2">Read where you left off</MudText>
                <MudText Typo="Typo.body2" Class="mh-home-detail">Track current chapter beside the latest known chapter, then filter by status when your shelf gets busy.</MudText>
            </div>
        </MangaBentoTile>

        <MangaBentoTile ColSpan="2" RowSpan="2" Scheme="primary" CornerIcon="@SessionIcon">
            <div class="mh-home-block">
                <MudStack Spacing="3">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h2">Account</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mh-home-detail">@AccountPrompt</MudText>
                    </MudStack>
                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        @if (currentUser is null)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" OnClick="OpenLogin">Log in</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenLogin">Create account</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories" OnClick="GoLibrary">Open shelf</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Logout">Log out</MudButton>
                        }
                    </MudStack>
                </MudStack>
            </div>
        </MangaBentoTile>

        <MangaBentoTile ColSpan="2" Scheme="soft" CornerIcon="@Icons.Material.Filled.TravelExplore" OnClick="GoCatalog">
            <div class="mh-home-block">
                <MudText Typo="Typo.h3">Curate the catalog</MudText>
                <MudText Typo="Typo.body2" Class="mh-home-detail">Admins can add manual entries or pull richer manga metadata from MAL first, with OpenLibrary as fallback.</MudText>
            </div>
        </MangaBentoTile>

        <MangaBentoTile Scheme="warm" CornerIcon="@Icons.Material.Filled.UploadFile" OnClick="GoCatalog">
            <div class="mh-home-block">
                <MudText Typo="Typo.h3">Import old sheets</MudText>
                <MudText Typo="Typo.body2" Class="mh-home-detail">Bring status, chapters, scores, notes, and links into the app.</MudText>
            </div>
        </MangaBentoTile>

        <MangaBentoTile Scheme="ink" CornerIcon="@Icons.Material.Filled.VerifiedUser" OnClick="GoAccount">
            <div class="mh-home-block">
                <MudText Typo="Typo.h3">Control access</MudText>
                <MudText Typo="Typo.body2" Class="mh-home-detail">Admins own catalog changes while each user owns their shelf.</MudText>
            </div>
        </MangaBentoTile>
    </MangaBento>
</MudStack>

@code {
    private UserResponse? currentUser;
    private string AccountPrompt => currentUser is null
        ? "Sign in to manage your shelf and sync your reading state across the app."
        : $"Signed in as {currentUser.Username}.";
    private string SessionIcon => currentUser is null ? Icons.Material.Filled.Login : Icons.Material.Filled.AccountCircle;

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;
        currentUser = await Auth.GetCurrentUserAsync();
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        currentUser = null;
    }

    private void OpenLogin() => Auth.RequestLogin("Log in to manage your shelf and account.");

    private void GoTo(string route)
    {
        if (currentUser is null)
        {
            Auth.RequestLogin("Please log in to continue.", route);
            return;
        }

        Navigation.NavigateTo(route);
    }

    private void GoLibrary() => GoTo("library");

    private void GoCatalog() => GoTo("catalog");

    private void GoAccount() => GoTo("account");

    private void OnAuthChanged()
    {
        currentUser = Auth.CurrentUser;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Auth.Changed -= OnAuthChanged;
    }
}
