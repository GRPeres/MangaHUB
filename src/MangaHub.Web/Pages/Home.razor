@page "/"
@inject AuthState Auth
@inject NavigationManager Navigation

<PageTitle>MangaHub</PageTitle>

<MudStack Spacing="4">
    <section class="mh-home-hero">
        <MudStack Spacing="3">
            <MudStack Spacing="1">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Manga tracker</MudText>
                <MudText Typo="Typo.h1">Keep your reading life in one quiet place.</MudText>
                <MudText Typo="Typo.body1" Class="mh-hero-copy">
                    Your shelf, current chapters, scores, notes, OpenLibrary metadata, MangaDex links, and local files all meet here.
                </MudText>
            </MudStack>
            <MudStack Row="true" Spacing="2" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories" OnClick="GoLibrary">Open shelf</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircleOutline" OnClick="GoSearch">Add manga</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ManageAccounts" OnClick="GoAccount">Account</MudButton>
            </MudStack>
        </MudStack>
        <div class="mh-home-pulse">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Current build</MudText>
            <MudText Typo="Typo.h3">Home refresh</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">If you can see this panel, TrueNAS pulled the new web build.</MudText>
        </div>
    </section>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-5" Elevation="0" Outlined="true">
                <MudStack Spacing="3">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h2">Account</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@AccountPrompt</MudText>
                    </MudStack>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="username" Label="Username" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Register">Register</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Login">Login</MudButton>
                        @if (currentUser is not null)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Logout">Logout</MudButton>
                        }
                    </MudStack>
                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <MudAlert Severity="@messageSeverity" Variant="Variant.Outlined">@message</MudAlert>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="7">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4 mh-home-tile" Elevation="0" Outlined="true" @onclick="GoLibrary">
                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h3">Read where you left off</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Use chapter, status, score, and notes as your personal memory.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4 mh-home-tile" Elevation="0" Outlined="true" @onclick="GoSearch">
                        <MudIcon Icon="@Icons.Material.Filled.TravelExplore" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h3">Register clean metadata</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Pull covers, descriptions, and category hints from OpenLibrary.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4 mh-home-tile" Elevation="0" Outlined="true" @onclick="GoSearch">
                        <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="Color.Secondary" Size="Size.Large" />
                        <MudText Typo="Typo.h3">Bring the old sheet</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Import status, chapter, score, type, and summaries from CSV.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4 mh-home-tile" Elevation="0" Outlined="true" @onclick="GoAccount">
                        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Secondary" Size="Size.Large" />
                        <MudText Typo="Typo.h3">Keep control</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Admins curate the catalog while users manage their own shelf.</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private string username = "";
    private string password = "";
    private string message = "";
    private Severity messageSeverity = Severity.Info;
    private UserResponse? currentUser;
    private string AccountPrompt => currentUser is null
        ? "Sign in to manage your shelf and sync your reading state across the app."
        : $"Signed in as {currentUser.Username}.";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await Auth.GetCurrentUserAsync();
        if (currentUser is not null)
        {
            messageSeverity = Severity.Success;
            message = $"Signed in as {currentUser.Username}.";
        }
    }

    private async Task Register()
    {
        var user = await Auth.RegisterAsync(username, password);
        currentUser = user;
        messageSeverity = user is null ? Severity.Error : Severity.Success;
        message = user is null ? "Registration failed." : $"Signed in as {user.Username}.";
    }

    private async Task Login()
    {
        var user = await Auth.LoginAsync(username, password);
        currentUser = user;
        messageSeverity = user is null ? Severity.Error : Severity.Success;
        message = user is null ? "Login failed." : $"Signed in as {user.Username}.";
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        currentUser = null;
        messageSeverity = Severity.Info;
        message = "Signed out.";
    }

    private void GoTo(string route) => Navigation.NavigateTo(route);

    private void GoLibrary() => GoTo("library");

    private void GoSearch() => GoTo("search");

    private void GoAccount() => GoTo("account");
}
