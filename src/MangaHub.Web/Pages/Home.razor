@page "/"
@using MudBlazor.Charts

<PageTitle>MangaHub</PageTitle>

@if (currentUser is null)
{
    <section class="mh-dashboard-welcome">
        <MudStack Spacing="3">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Your manga, in context</MudText>
            <MudText Typo="Typo.h1">MangaHub</MudText>
            <MudText Typo="Typo.body1">Follow your reading, catch releases in your language, and keep a clean catalog behind it all.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" OnClick="OpenLogin">Log in to open your dashboard</MudButton>
        </MudStack>
    </section>
}
else if (isLoading)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mh-dashboard-loading">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">Loading your reading dashboard...</MudText>
    </MudStack>
}
else
{
    <MudStack Spacing="3">
        <section class="mh-dashboard-header">
            <MudStack Spacing="1">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@PreferredLanguagesLabel reading dashboard</MudText>
                <MudText Typo="Typo.h2">Good to see you, @currentUser.Username.</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Your shelf is quiet until there is something worth reading.</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories" OnClick="GoLibrary">Open shelf</MudButton>
        </section>

        <section class="mh-dashboard-section" aria-labelledby="dashboard-now-title">
            <div class="mh-dashboard-section-heading">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Right now</MudText>
                <MudText id="dashboard-now-title" Typo="Typo.h4">Pick up where you left off</MudText>
            </div>

            <MangaBento Columns="3" Class="mh-dashboard-overview-bento">
                <MangaBentoTile ColSpan="2" RowSpan="2" Scheme="deep" CornerIcon="@Icons.Material.Filled.MenuBook" OnClick="OpenContinueReading">
                    <div class="mh-dashboard-tile mh-dashboard-continue">
                        <MudText Typo="Typo.overline">Continue reading</MudText>
                        @if (dashboard?.ContinueReading is { } entry)
                        {
                            <div class="mh-dashboard-manga-line">
                                @if (!string.IsNullOrWhiteSpace(entry.CoverUrl))
                                {
                                    <img src="@entry.CoverUrl" alt="" />
                                }
                                <MudStack Spacing="0" Class="mh-dashboard-manga-copy">
                                    <MudText Typo="Typo.h3">@entry.Title</MudText>
                                    <MudText Typo="Typo.body2">Chapter @DisplayChapter(entry.CurrentChapter)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@LatestLabel(entry)</MudText>
                                </MudStack>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Open your shelf to start the reader.</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.h3">Your next story is waiting.</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Choose something planned below or add a catalog title to your shelf.</MudText>
                        }
                    </div>
                </MangaBentoTile>

                <MangaBentoTile Scheme="warm" CornerIcon="@Icons.Material.Filled.FiberNew" OnClick="GoNewReleases">
                    <div class="mh-dashboard-tile mh-dashboard-stat">
                        <MudText Typo="Typo.overline">New releases</MudText>
                        <MudText Typo="Typo.h2">@(dashboard?.NewReleaseCount ?? 0)</MudText>
                        <MudText Typo="Typo.caption">in @PreferredLanguagesLabel</MudText>
                    </div>
                </MangaBentoTile>

                <MangaBentoTile Scheme="soft" CornerIcon="@Icons.Material.Filled.BookmarkAdded" OnClick="GoPlanned">
                    <div class="mh-dashboard-tile mh-dashboard-stat">
                        <MudText Typo="Typo.overline">Planned</MudText>
                        <MudText Typo="Typo.h2">@(dashboard?.PlannedCount ?? 0)</MudText>
                        <MudText Typo="Typo.caption">ready when you are</MudText>
                    </div>
                </MangaBentoTile>
            </MangaBento>
        </section>

        <section class="mh-dashboard-section" aria-labelledby="dashboard-activity-title">
            <div class="mh-dashboard-section-heading mh-dashboard-section-heading-row">
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Private insights</MudText>
                    <MudText id="dashboard-activity-title" Typo="Typo.h4">Reading activity</MudText>
                </div>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Tune" OnClick="GoAnalyticsSettings">Preferences</MudButton>
            </div>

            <MudPaper Class="mh-dashboard-activity-panel" Elevation="0" Outlined="true">
                @if (currentUser.UsageAnalyticsEnabled)
                {
                    @if (HasReadingActivity)
                    {
                        <MudChart ChartType="ChartType.Line"
                                  ChartSeries="@readingActivitySeries"
                                  ChartLabels="@readingActivityLabels"
                                  ChartOptions="@readingActivityChartOptions"
                                  Height="250px"
                                  Width="100%"
                                  MatchBoundsToSize="true"
                                  Class="mh-dashboard-activity-chart" />
                    }
                    else
                    {
                        <div class="mh-dashboard-empty-activity">
                            <MudText Typo="Typo.h3">Your reading story starts here.</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Finish a chapter and this space will turn into your weekly reading trend.</MudText>
                        </div>
                    }
                    <div class="mh-dashboard-activity-grid">
                        <div><MudText Typo="Typo.caption">Yesterday</MudText><MudText Typo="Typo.h3">@ChaptersReadYesterday</MudText><MudText Typo="Typo.caption">chapters read</MudText></div>
                        <div><MudText Typo="Typo.caption">This week</MudText><MudText Typo="Typo.h3">@WeeklyReadingTime</MudText><MudText Typo="Typo.caption">@WeeklyChapters chapter@(WeeklyChapters == 1 ? "" : "s") finished</MudText></div>
                        <div><MudText Typo="Typo.caption">Current streak</MudText><MudText Typo="Typo.h3">@(usageDashboard?.CurrentStreak ?? 0)</MudText><MudText Typo="Typo.caption">@(usageDashboard?.ActiveDays ?? 0) active days this month</MudText></div>
                    </div>
                }
                else
                {
                    <div class="mh-dashboard-empty-activity">
                        <MudText Typo="Typo.h3">Make your reading visible.</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Enable private usage insights in Settings to see reading time, chapters, active days, and future recommendations.</MudText>
                    </div>
                }
            </MudPaper>
        </section>

        <section class="mh-dashboard-section" aria-labelledby="dashboard-shelf-title">
            <div class="mh-dashboard-section-heading">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Your shelf</MudText>
                <MudText id="dashboard-shelf-title" Typo="Typo.h4">Keep the list moving</MudText>
            </div>

            <div class="mh-dashboard-discovery-grid">
                <MudPaper Class="mh-dashboard-panel mh-dashboard-release-panel" Elevation="0" Outlined="true">
                    <div class="mh-dashboard-panel-header">
                        <MudStack Spacing="0"><MudText Typo="Typo.h5">New on your shelf</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Available in @PreferredLanguagesLabel</MudText></MudStack>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="GoNewReleases">View updates</MudButton>
                    </div>
                    @if (dashboard?.NewReleaseCount is not > 0)
                    {
                        <MudText Typo="Typo.h3">All caught up.</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No new MangaDex chapters were found in your preferred language.</MudText>
                    }
                    else
                    {
                        @foreach (var entry in dashboard?.NewReleases ?? [])
                        {
                            <div class="mh-dashboard-release-row">
                                <MudText Typo="Typo.subtitle2">@entry.Title</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Error">@ReleaseLabel(entry)</MudText>
                            </div>
                        }
                    }
                </MudPaper>

                <MudPaper Class="mh-dashboard-panel" Elevation="0" Outlined="true">
                    <div class="mh-dashboard-panel-header">
                        <MudStack Spacing="0"><MudText Typo="Typo.h5">Try from your catalog</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Quiet prompts, not a queue</MudText></MudStack>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="GoCatalog">Browse catalog</MudButton>
                    </div>
                    @if (dashboard?.Recommendations.Count is not > 0)
                    {
                        <MudText Typo="Typo.h3">Your catalog is already on your shelf.</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Add a few more catalog entries and they will appear here as gentle prompts.</MudText>
                    }
                    else
                    {
                        @foreach (var entry in dashboard?.Recommendations ?? [])
                        {
                            <div class="mh-dashboard-release-row">
                                <MudText Typo="Typo.subtitle2">@entry.Title</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@EntryMeta(entry)</MudText>
                            </div>
                        }
                    }
                </MudPaper>

                <MudPaper Class="mh-dashboard-panel mh-dashboard-ratings-panel" Elevation="0" Outlined="true">
                    <div class="mh-dashboard-panel-header">
                        <MudStack Spacing="0"><MudText Typo="Typo.h5">Rate completed manga</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">A quick record for future you</MudText></MudStack>
                    </div>
                    @if (dashboard?.PendingRatings.Count is not > 0)
                    {
                        <MudText Typo="Typo.h3">Your completed shelf is rated.</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Finish another story and it will appear here as a gentle reminder.</MudText>
                    }
                    else
                    {
                        @foreach (var entry in dashboard?.PendingRatings ?? [])
                        {
                            <div class="mh-dashboard-rating-row">
                                @if (!string.IsNullOrWhiteSpace(entry.CoverUrl))
                                {
                                    <img src="@entry.CoverUrl" alt="" loading="lazy" decoding="async" />
                                }
                                <MudText Typo="Typo.subtitle2">@entry.Title</MudText>
                                <div class="mh-dashboard-stars" aria-label="@($"Rate {entry.Title}")">
                                    @for (var value = 1; value <= 5; value++)
                                    {
                                        var score = value;
                                        <MudIconButton Icon="@Icons.Material.Outlined.StarBorder" Color="Color.Secondary" Size="Size.Small" Disabled="@savingRatings.Contains(entry.Id)" OnClick="() => SetScore(entry, score)" aria-label="@($"Rate {score} of 5")" />
                                    }
                                </div>
                            </div>
                        }
                    }
                </MudPaper>
            </div>
        </section>
    </MudStack>
}
