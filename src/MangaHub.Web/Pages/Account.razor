@page "/account"
@using MangaHub.Web.API.Services
@inject AuthSessionService Auth
@inject AdminApiService AdminApi
@inject MessageService Messages
@inject UsageApiService UsageApi

<PageTitle>Account</PageTitle>

<MudStack Spacing="4">
    <MudStack Spacing="1" Class="mh-page-title">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Profile</MudText>
        <MudText Typo="Typo.h1">Account</MudText>
    </MudStack>

    @if (currentUser is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Sign in first to manage your account.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h2">@currentUser.Username</MudText>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
                    <MudChip T="string" Color="@(IsAdmin ? Color.Secondary : Color.Primary)" Variant="Variant.Filled">@currentUser.Role</MudChip>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAccount">Refresh</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Logout" OnClick="Logout">Log out</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h2">Reading language order</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">MangaHub reads with the highest available language first. Every language in this list contributes to new-release counts and notifications.</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                    <MudSelect T="string" Value="@languageToAdd" ValueChanged="AddLanguage" Label="Add language" Variant="Variant.Outlined" Class="mh-account-language-select">
                        @foreach (var language in AvailableLanguages)
                        {
                            <MudSelectItem Value="@language.Code" Disabled="@preferredLanguages.Contains(language.Code, StringComparer.OrdinalIgnoreCase)">@language.Label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" @bind-Value="customLanguage" Label="Custom code" Variant="Variant.Outlined" Immediate="true" Class="mh-account-language-custom" />
                    <MudTooltip Text="Add custom language"><MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(customLanguage)" OnClick="AddCustomLanguage" aria-label="Add custom language" /></MudTooltip>
                </MudStack>
                <div class="mh-account-language-order" aria-label="Language priority order">
                    @for (var index = 0; index < preferredLanguages.Count; index++)
                    {
                        var cardIndex = index;
                        var language = preferredLanguages[cardIndex];
                        <div class="@($"mud-paper mud-paper-outlined mh-account-language-card {(draggingLanguageIndex == cardIndex ? "is-dragging" : "")}")"
                             draggable="true"
                             @ondragstart="() => BeginLanguageDrag(cardIndex)"
                             @ondragover:preventDefault
                             @ondragenter="() => MoveLanguageDuringDrag(cardIndex)"
                             @ondrop:preventDefault
                             @ondrop="() => MoveLanguageDuringDrag(cardIndex)"
                             @ondragend="EndLanguageDrag">
                            <div class="mh-account-language-grip" title="Drag to change priority" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.DragIndicator" Color="Color.Secondary" /></div>
                            <div class="mh-account-language-identity">
                                <span class="mh-account-language-rank" aria-label="Priority @(cardIndex + 1)">@((cardIndex + 1).ToString())</span>
                                <MudText Typo="Typo.subtitle1">@LanguageLabel(language)</MudText>
                                <span class="mh-account-language-code">@language</span>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Disabled="@(preferredLanguages.Count == 1)" OnClick="() => RemoveLanguage(cardIndex)" aria-label="Remove language" title="Remove language" />
                        </div>
                    }
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@isSavingLanguage" OnClick="SavePreferredLanguage">Save language order</MudButton>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h2">Private usage insights</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Optional on-device activity is saved only in MangaHub to build future reading insights, recommendations, and better alerts. It never includes page images, passwords, search text, IP addresses, or browser details.</MudText>
                <MudSwitch T="bool" Value="@(currentUser?.UsageAnalyticsEnabled ?? false)" ValueChanged="SetUsageAnalytics" Color="Color.Primary" Label="Save my usage analytics" Disabled="@isSavingUsage" />
                @if (currentUser?.UsageAnalyticsEnabled == true)
                {
                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudButton Href="@UsageApi.ExportUrl" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download">Export analytics</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline" OnClick="DeleteUsageAnalytics">Delete analytics history</MudButton>
                    </MudStack>
                }
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h2">Sign-in and recovery</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Recovery only activates after you verify the email link. Existing accounts can keep their current password until they choose to replace it.</MudText>
                <MudTextField T="string" @bind-Value="accountEmail" Label="Recovery email" InputType="InputType.Email" Variant="Variant.Outlined" />
                @if (currentUser.IsEmailVerified)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">Verified recovery email: @currentUser.Email</MudAlert>
                }
                else if (!string.IsNullOrWhiteSpace(currentUser.PendingEmail))
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Verification pending for @currentUser.PendingEmail. Check that inbox for the confirmation link.</MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">No verified recovery email yet.</MudAlert>
                }
                <MudTextField T="string" @bind-Value="currentPassword" Label="Current password" InputType="InputType.Password" Variant="Variant.Outlined" />
                <MudTextField T="string" @bind-Value="newPassword" Label="New password (optional)" InputType="InputType.Password" Variant="Variant.Outlined" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">New passwords need 10+ characters with uppercase, lowercase, and a number.</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@isSavingAccount" OnClick="SaveAccount">Save sign-in details</MudButton>
                    @if (currentUser.HasGoogleSignIn)
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">Google sign-in linked</MudChip>
                    }
                    else
                    {
                        <MudButton Href="/auth/google?link=true" Variant="Variant.Outlined" Color="Color.Secondary">Link Google</MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (IsAdmin)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h2">Users</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Admins can promote or demote accounts.</MudText>
                        </MudStack>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadUsers">Refresh users</MudButton>
                    </MudStack>

                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <MudAlert Severity="@messageSeverity" Variant="Variant.Outlined">@message</MudAlert>
                    }

                    <MudTable Items="@users" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Username</MudTh>
                            <MudTh>Role</MudTh>
                            <MudTh>Created</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Username">@context.Username</MudTd>
                            <MudTd DataLabel="Role">
                                <MudChip T="string" Size="Size.Small" Color="@(context.Role == "admin" ? Color.Secondary : Color.Primary)" Variant="Variant.Outlined">@context.Role</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="Actions">
                                @if (context.Role == "admin")
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" OnClick="() => MakeUser(context)">Make user</MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => MakeAdmin(context)">Make admin</MudButton>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudStack>
            </MudPaper>
        }
    }
</MudStack>

    @code {

    private UserResponse? currentUser;
    private bool IsAdmin => string.Equals(currentUser?.Role, "admin", StringComparison.OrdinalIgnoreCase);
    private List<UserAdminResponse> users = [];
    private string message = "";
    private Severity messageSeverity = Severity.Info;
    private static readonly (string Code, string Label)[] AvailableLanguages =
    [
        ("en", "English"), ("pt-br", "Portuguese (Brazil)"), ("pt", "Portuguese"),
        ("es", "Spanish"), ("fr", "French"), ("de", "German"), ("it", "Italian"),
        ("ja", "Japanese"), ("ko", "Korean"), ("zh", "Chinese"), ("zh-ro", "Chinese (Romanized)")
    ];
    private List<string> preferredLanguages = ["en"];
    private string languageToAdd = "";
    private string customLanguage = "";
    private bool isSavingLanguage;
    private int? draggingLanguageIndex;
    private string accountEmail = "";
    private string currentPassword = "";
    private string newPassword = "";
    private bool isSavingAccount;
    private bool isSavingUsage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshAccount();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAccount()
    {
        currentUser = await Auth.GetCurrentUserAsync(forceRefresh: true);
        accountEmail = !string.IsNullOrWhiteSpace(currentUser?.PendingEmail)
            ? currentUser.PendingEmail
            : currentUser?.Email ?? "";
        preferredLanguages = ParseLanguages(currentUser?.PreferredLanguage);
        if (IsAdmin)
        {
            await LoadUsers();
        }
    }

    private async Task LoadUsers()
    {
        users = await AdminApi.GetUsersAsync();
    }

    private async Task SetRole(UserAdminResponse user, string role)
    {
        var updated = await AdminApi.UpdateUserRoleAsync(user.Id, role);
        messageSeverity = updated is null ? Severity.Error : Severity.Success;
        message = updated is null ? "Could not update user role." : $"{updated.Username} is now {updated.Role}.";
        await RefreshAccount();
    }

    private async Task MakeAdmin(UserAdminResponse user) => await SetRole(user, "admin");

    private async Task MakeUser(UserAdminResponse user) => await SetRole(user, "user");

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        currentUser = null;
        users = [];
    }

    private async Task SavePreferredLanguage()
    {
        isSavingLanguage = true;
        try
        {
            var updated = await Auth.UpdatePreferredLanguageAsync(string.Join(',', preferredLanguages));
            if (updated is null)
            {
                Messages.Error("Could not save your preferred language.");
                return;
            }

            Messages.Success("Preferred reading languages saved.");
            currentUser = updated;
            preferredLanguages = ParseLanguages(updated.PreferredLanguage);
        }
        finally
        {
            isSavingLanguage = false;
        }
    }

    private async Task SaveAccount()
    {
        isSavingAccount = true;
        try
        {
            var result = await Auth.UpdateAccountAsync(accountEmail, currentPassword, newPassword);
            if (result.Value is null)
            {
                Messages.Error(result.Error);
                return;
            }
            currentUser = result.Value;
            accountEmail = currentUser.PendingEmail is { Length: > 0 } ? currentUser.PendingEmail : currentUser.Email;
            currentPassword = "";
            newPassword = "";
            Messages.Success(currentUser.IsEmailVerified ? "Sign-in details saved." : "Check your email to verify recovery.");
        }
        finally
        {
            isSavingAccount = false;
        }
    }

    private async Task SetUsageAnalytics(bool enabled)
    {
        isSavingUsage = true;
        try
        {
            var updated = await UsageApi.SetEnabledAsync(enabled);
            if (updated is null) { Messages.Error("Could not update analytics preferences."); return; }
            currentUser = updated;
            Messages.Success(enabled ? "Private usage insights enabled." : "Usage analytics disabled.");
        }
        finally { isSavingUsage = false; }
    }

    private async Task DeleteUsageAnalytics()
    {
        if (!await UsageApi.DeleteAsync()) { Messages.Error("Could not delete analytics history."); return; }
        Messages.Success("Analytics history deleted. Your shelf and reading progress were not changed.");
    }

    private void AddLanguage(string language)
    {
        languageToAdd = "";
        AddLanguageCode(language);
    }

    private void AddCustomLanguage()
    {
        AddLanguageCode(customLanguage);
        customLanguage = "";
    }

    private void AddLanguageCode(string? language)
    {
        var normalized = (language ?? "").Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(normalized) || preferredLanguages.Contains(normalized, StringComparer.OrdinalIgnoreCase)) return;
        preferredLanguages.Add(normalized);
    }

    private void BeginLanguageDrag(int index)
    {
        draggingLanguageIndex = index;
    }

    private void MoveLanguageDuringDrag(int destination)
    {
        if (draggingLanguageIndex is not { } source || source == destination) return;
        var language = preferredLanguages[source];
        preferredLanguages.RemoveAt(source);
        preferredLanguages.Insert(Math.Min(destination, preferredLanguages.Count), language);
        draggingLanguageIndex = destination;
    }

    private void EndLanguageDrag()
    {
        draggingLanguageIndex = null;
    }

    private void RemoveLanguage(int index)
    {
        if (preferredLanguages.Count <= 1) return;
        preferredLanguages.RemoveAt(index);
    }

    private static List<string> ParseLanguages(string? value) => (value ?? "en")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(language => language.ToLowerInvariant())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList() is { Count: > 0 } languages ? languages : ["en"];

    private static string LanguageLabel(string language) => AvailableLanguages
        .FirstOrDefault(item => string.Equals(item.Code, language, StringComparison.OrdinalIgnoreCase)).Label ?? language;
}
