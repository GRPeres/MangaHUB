@page "/library"
@using MangaHub.Web.API.Services
@inject AuthSessionService Auth
@inject NavigationManager Navigation
@inject AdminApiService AdminApi
@inject MangaApiService MangaApi
@inject ShelfApiService ShelfApi
@inject NotificationApiService Notifications
@inject MessageService Messages
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Shelf</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mh-page-title mh-shelf-page-title">
        <MudStack Spacing="1" Class="mh-page-heading">
            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mh-page-kicker">Personal tracker</MudText>
            <MudText Typo="Typo.h1">Shelf</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" Class="mh-page-actions flex-wrap">
            <MudMenu Label="Add" StartIcon="@Icons.Material.Filled.AddCircleOutline" Variant="Variant.Filled" Color="Color.Primary">
                <MudMenuItem Icon="@Icons.Material.Filled.PlaylistAdd" OnClick="OpenAddShelf">Add manga</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.UploadFile" OnClick="OpenImportShelf">Import CSV</MudMenuItem>
            </MudMenu>
            <MudMenu Label="Export" StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Outlined" Color="Color.Primary">
                <MudMenuItem Icon="@Icons.Material.Filled.TableView" Href="@ShelfApi.ExportCsvUrl" Target="_blank">Excel CSV</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf" Href="@ShelfApi.ExportPdfUrl" Target="_blank">Shareable PDF</MudMenuItem>
            </MudMenu>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterList" OnClick="OpenFilters">@FilterButtonLabel</MudButton>
        </MudStack>
    </MudStack>

    <nav class="mh-shelf-section-nav" aria-label="Shelf sections">
        @foreach (var shelfSection in ShelfSections)
        {
            <MudButton Variant="@(IsSectionActive(shelfSection.Key) ? Variant.Filled : Variant.Outlined)"
                       Color="@(shelfSection.Key == "updates" ? Color.Error : Color.Primary)"
                       Class="mh-shelf-section-button"
                       OnClick="@(() => SelectSection(shelfSection.Key))"
                       aria-current="@(IsSectionActive(shelfSection.Key) ? "page" : null)">
                @shelfSection.Label (@SectionCount(shelfSection.Key))
            </MudButton>
        }
    </nav>

    @if (VisibleEntries.Count == 0 && !hasMoreEntries)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@EmptySectionMessage</MudAlert>
    }
    else
    {
        <MudStack Spacing="2">
            @if (IsUpdatesSection && NewReleaseEntries.Count > 0)
            {
                <MudText Typo="Typo.h6" Color="Color.Error">New releases</MudText>
                @foreach (var item in NewReleaseEntries)
                {
                    <ShelfEntryCard @key="item.Id" Entry="@item" ActiveStatusFilter="@ActiveStatusFilter" CanRead="@IsAdmin" OnRead="@(id => Read(id))" OnEdit="Edit" OnStatusFilter="ToggleStatusFilter" OnCategoryFilter="OpenCategoryFilter" OnScoreChanged="@(score => UpdateScore(item, score))" />
                }
            }

            @if (IsUpdatesSection && UntrackedEntries.Count > 0)
            {
                @if (NewReleaseEntries.Count > 0)
                {
                    <MudDivider />
                }

                <MudText Typo="Typo.h6" Color="Color.Error">Untracked manga</MudText>
                @foreach (var item in UntrackedEntries)
                {
                    <ShelfEntryCard @key="item.Id" Entry="@item" ActiveStatusFilter="@ActiveStatusFilter" CanRead="@IsAdmin" OnRead="@(id => Read(id))" OnEdit="Edit" OnStatusFilter="ToggleStatusFilter" OnCategoryFilter="OpenCategoryFilter" OnScoreChanged="@(score => UpdateScore(item, score))" />
                }
            }

            @foreach (var item in IsUpdatesSection ? [] : VisibleEntries)
            {
                <ShelfEntryCard @key="item.Id" Entry="@item" ActiveStatusFilter="@ActiveStatusFilter" CanRead="@IsAdmin" OnRead="@(id => Read(id))" OnEdit="Edit" OnStatusFilter="ToggleStatusFilter" OnCategoryFilter="OpenCategoryFilter" OnScoreChanged="@(score => UpdateScore(item, score))" />
            }

            @if (hasMoreEntries)
            {
                <MudStack AlignItems="AlignItems.Center" Class="mt-2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ExpandMore" Disabled="@isLoadingEntries" OnClick="LoadMoreEntries">
                        @(isLoadingEntries ? "Loading manga..." : "Load more manga")
                    </MudButton>
                </MudStack>
                <div @ref="loadMoreSentinel" class="mh-progressive-load-sentinel" aria-hidden="true"></div>
            }
        </MudStack>
    }

</MudStack>

<ShelfAddModal Open="@isAddShelfOpen" OpenChanged="OnAddShelfOpenChanged" OnSaved="Load" />
<ShelfImportModal Open="@isImportShelfOpen" OpenChanged="OnImportShelfOpenChanged" OnImported="Load" />
<ShelfEditModal Entry="@editingEntry" OwnerUserId="@(IsAdmin ? selectedUserId : null)" OnSaved="OnShelfEditSaved" OnClosed="CloseEdit" />

<ReaderPreparingOverlay Open="@isPreparingReader"
                         Stage="@PreparingStage"
                         Progress="@(readerPreparation?.Progress ?? 0)"
                         CompletedPages="@(readerPreparation?.CompletedPages ?? 0)"
                         TotalPages="@(readerPreparation?.TotalPages ?? 0)" />

<ChapterMatchConfirmationModal Open="@(chapterMatchEntryId is not null && chapterMatch is not null)"
                              RequestedChapter="@(chapterMatch?.RequestedChapter ?? "")"
                              MatchedChapter="@(chapterMatch?.MatchedChapter ?? "")"
                              Language="@LanguageLabel(chapterMatch?.Language ?? "")"
                              OnCancel="CancelChapterMatch"
                              OnConfirm="ConfirmChapterMatch" />

<ChapterJumpWarningModal Open="@(chapterJumpEntryId is not null && chapterJump is not null)"
                         CurrentChapter="@(chapterJump?.CurrentChapter ?? "")"
                         NextChapter="@(chapterJump?.NextChapter ?? "")"
                         Language="@LanguageLabel(chapterJump?.Language ?? "")"
                         AlternativeLanguages="@(chapterJump?.AlternativeLanguages ?? [])"
                         OnCancel="CancelChapterJump"
                         OnConfirm="ConfirmChapterJump"
                         OnReadAlternative="ReadChapterJumpAlternative" />

@if (languageFallbackEntryId is not null && fallbackLanguages.Count > 0)
{
    <div class="mh-modal-backdrop">
        <section class="mh-modal" role="dialog" aria-modal="true" aria-labelledby="language-fallback-title">
            <MudStack Spacing="3">
                <MudText id="language-fallback-title" Typo="Typo.h2">Chapter available in another language</MudText>
                <MudText Typo="Typo.body1">MangaDex does not have an exact @LanguageLabel(PreferredLanguage) match for this chapter, but it is available in another language.</MudText>
                <MudSelect T="string" @bind-Value="fallbackLanguage" Label="Continue in" Variant="Variant.Outlined">
                    @foreach (var language in fallbackLanguages)
                    {
                        <MudSelectItem T="string" Value="@language">@LanguageLabel(language)</MudSelectItem>
                    }
                </MudSelect>
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelLanguageFallback">Stay in @LanguageLabel(PreferredLanguage)</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ContinueInFallbackLanguage">Continue reading</MudButton>
                </MudStack>
            </MudStack>
        </section>
    </div>
}

@if (filtersOpen)
{
    <div class="mh-modal-backdrop" @onclick="CloseFilters">
        <section class="mh-modal mh-filter-modal" role="dialog" aria-modal="true" aria-labelledby="shelf-filter-title" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mh-modal-header">
                    <MudStack Spacing="1">
                        <MudText id="shelf-filter-title" Typo="Typo.h2">Shelf filters</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Narrow your shelf by progress, metadata, source, and reading options.</MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="CloseFilters" aria-label="Close shelf filters" />
                </MudStack>

                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="searchText" Label="Search title, author, notes" Variant="Variant.Outlined" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="sourceFilter" Label="Metadata source" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                            <MudSelectItem T="string" Value="@("MAL")">MAL</MudSelectItem>
                            <MudSelectItem T="string" Value="@("OpenLibrary")">OpenLibrary</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Manual")">Manual</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    @if (IsAdmin)
                    {
                        <MudItem xs="12" md="4">
                            <MudSelect T="Guid?" @bind-Value="selectedUserId" Label="Shelf owner" Variant="Variant.Outlined">
                                @foreach (var user in users)
                                {
                                    <MudSelectItem T="Guid?" Value="@user.Id">@user.Username (@user.Role)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="categoryFilter" Label="Genre/category" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                            @foreach (var category in CategoryOptions)
                            {
                                <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="availabilityFilter" Label="Read availability" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                            <MudSelectItem T="string" Value="@("local")">Local files</MudSelectItem>
                            <MudSelectItem T="string" Value="@("mangadex")">MangaDex</MudSelectItem>
                            <MudSelectItem T="string" Value="@("external")">External link</MudSelectItem>
                            <MudSelectItem T="string" Value="@("missing")">Missing read source</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="scoreFilter" Label="Score" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                            <MudSelectItem T="string" Value="@("rated")">Rated</MudSelectItem>
                            <MudSelectItem T="string" Value="@("unrated")">Unrated</MudSelectItem>
                            <MudSelectItem T="string" Value="@("4plus")">4+</MudSelectItem>
                            <MudSelectItem T="string" Value="@("5")">5 only</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="flex-wrap">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ClearFilters">Clear</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="ApplyFilters">Apply filters</MudButton>
                </MudStack>
            </MudStack>
        </section>
    </div>
}

@code {
    private List<MangaEntryResponse> entries = [];
    private const int PageSize = 24;
    private bool hasMoreEntries;
    private bool isLoadingEntries;
    private ElementReference loadMoreSentinel;
    private DotNetObjectReference<Library>? progressiveLoadReference;
    private List<UserAdminResponse> users = [];
    private UserResponse? currentUser;
    private bool IsAdmin => string.Equals(currentUser?.Role, "admin", StringComparison.OrdinalIgnoreCase);
    private Guid? selectedUserId;
    [SupplyParameterFromQuery(Name = "section")] public string? SectionQuery { get; set; }
    private string activeSection = "updates";
    private bool hasInitialized;
    private ShelfSectionSummaryResponse sectionSummary = new(0, 0, 0, 0, 0, 0, 0, 0, 0);
    private string searchText = "";
    private string sourceFilter = "";
    private string categoryFilter = "";
    private string availabilityFilter = "";
    private string scoreFilter = "";
    private bool isAddShelfOpen;
    private bool isImportShelfOpen;
    private bool filtersOpen;
    private bool isPreparingReader;
    private ReaderPreparationStatus? readerPreparation;
    private Guid? languageFallbackEntryId;
    private List<string> fallbackLanguages = [];
    private string fallbackLanguage = "";
    private Guid? chapterMatchEntryId;
    private ReaderChapterMatch? chapterMatch;
    private Guid? chapterJumpEntryId;
    private ReaderChapterJump? chapterJump;
    [SupplyParameterFromQuery(Name = "readEntryId")] public Guid? NotificationEntryId { get; set; }
    [SupplyParameterFromQuery(Name = "chapter")] public string? NotificationChapter { get; set; }
    [SupplyParameterFromQuery(Name = "language")] public string? NotificationLanguage { get; set; }
    [SupplyParameterFromQuery(Name = "notificationId")] public Guid? NotificationId { get; set; }
    private string PreparingStage => readerPreparation?.Stage ?? "Waiting to prepare the chapter";
    private MangaEntryResponse? editingEntry;

    private static readonly (string Key, string Label)[] ShelfSections =
    [
        ("updates", "Updates"),
        ("planned", "Planned"),
        ("reading", "Reading"),
        ("paused", "On hiatus"),
        ("done", "Done"),
        ("dropped", "Dropped"),
        ("all", "All")
    ];

    protected override async Task OnInitializedAsync()
    {
        activeSection = NormalizeSection(SectionQuery);
        currentUser = await Auth.GetCurrentUserAsync();
        if (IsAdmin)
        {
            users = await AdminApi.GetUsersAsync();
            selectedUserId = currentUser?.Id;
        }
        hasInitialized = true;
        await Load();
        if (NotificationEntryId is not null && !string.IsNullOrWhiteSpace(NotificationChapter))
        {
            if (NotificationId is not null)
            {
                await Notifications.MarkReadAsync(NotificationId.Value);
            }
            await Read(NotificationEntryId.Value, NotificationLanguage, allowLanguageFallback: true, allowChapterJump: true, requestedChapter: NotificationChapter);
        }
    }

    private void OpenAddShelf() => isAddShelfOpen = true;
    private void OpenImportShelf() => isImportShelfOpen = true;
    private void OpenFilters() => filtersOpen = true;
    private void OpenCategoryFilter(string category)
    {
        categoryFilter = category;
        filtersOpen = true;
    }
    private void CloseFilters() => filtersOpen = false;
    private void OnAddShelfOpenChanged(bool open) => isAddShelfOpen = open;
    private void OnImportShelfOpenChanged(bool open) => isImportShelfOpen = open;

    private Task ToggleStatusFilter(string clickedStatus)
    {
        SelectSection(string.Equals(activeSection, clickedStatus, StringComparison.OrdinalIgnoreCase) ? "all" : clickedStatus);
        return Task.CompletedTask;
    }

    private void SelectSection(string section)
    {
        var normalized = NormalizeSection(section);
        if (string.Equals(activeSection, normalized, StringComparison.Ordinal))
        {
            return;
        }

        Navigation.NavigateTo($"/library?section={Uri.EscapeDataString(normalized)}");
    }

    private async Task ApplyFilters()
    {
        filtersOpen = false;
        await Load();
    }

    private async Task ClearFilters()
    {
        searchText = "";
        sourceFilter = "";
        categoryFilter = "";
        availabilityFilter = "";
        scoreFilter = "";
        if (IsAdmin)
        {
            selectedUserId = currentUser?.Id;
        }
        await Load();
        filtersOpen = false;
    }

    private async Task Load()
    {
        entries = [];
        hasMoreEntries = true;
        await RefreshSectionSummaryAsync();
        await LoadMoreEntries();
        CloseEdit();
    }

    private async Task LoadMoreEntries()
    {
        if (isLoadingEntries || !hasMoreEntries)
        {
            return;
        }

        isLoadingEntries = true;
        try
        {
            var nextPage = await MangaApi.GetMangaEntriesAsync(userId: IsAdmin ? selectedUserId : null, offset: entries.Count, limit: PageSize, section: activeSection);
            entries.AddRange(nextPage);
            hasMoreEntries = nextPage.Count == PageSize;
            await SaveOfflineSnapshotAsync();
        }
        finally
        {
            isLoadingEntries = false;
        }
    }

    private async Task RefreshSectionSummaryAsync()
    {
        sectionSummary = await MangaApi.GetShelfSectionSummaryAsync(IsAdmin ? selectedUserId : null)
            ?? new ShelfSectionSummaryResponse(0, 0, 0, 0, 0, 0, 0, 0, 0);
    }

    protected override async Task OnParametersSetAsync()
    {
        var requestedSection = NormalizeSection(SectionQuery);
        if (!hasInitialized || string.Equals(activeSection, requestedSection, StringComparison.Ordinal))
        {
            return;
        }

        activeSection = requestedSection;
        await Load();
    }

    private async Task SaveOfflineSnapshotAsync()
    {
        if (currentUser is null || (IsAdmin && selectedUserId is not null && selectedUserId != currentUser.Id))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("mangaHubOfflineShelf.save", currentUser.Id.ToString(), entries);
        }
        catch (JSDisconnectedException)
        {
            // The browser is gone; the next successful Shelf load will refresh the local snapshot.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!hasMoreEntries)
        {
            return;
        }

        progressiveLoadReference ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("mangaHubProgressiveLoad.observe", loadMoreSentinel, progressiveLoadReference, nameof(LoadMoreFromScrollAsync));
    }

    [JSInvokable]
    public async Task LoadMoreFromScrollAsync()
    {
        await LoadMoreEntries();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("mangaHubProgressiveLoad.unobserve", loadMoreSentinel);
        }
        catch (JSDisconnectedException)
        {
            // The browser is already gone.
        }
        progressiveLoadReference?.Dispose();
    }

    private string PreferredLanguages => string.IsNullOrWhiteSpace(currentUser?.PreferredLanguage) ? "en" : currentUser.PreferredLanguage;
    private string PreferredLanguage => PreferredLanguages.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault() ?? "en";

    private async Task Read(Guid entryId, string? language = null, bool allowLanguageFallback = false, bool allowChapterJump = false, string? requestedChapter = null)
    {
        if (!IsAdmin)
        {
            ShowWarning("Reader access is available to admins only.");
            return;
        }

        isPreparingReader = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var options = await MangaApi.GetReadOptionsAsync(entryId);
            if (options is null)
            {
                ShowWarning("Could not load read options.");
                return;
            }

            if (options.HasLocal && string.IsNullOrWhiteSpace(requestedChapter))
            {
                Navigation.NavigateTo(options.LocalReaderUrl);
                return;
            }

            if (options.HasMangaDex)
            {
                readerPreparation = await MangaApi.StartMangaDexPreparationAsync(entryId, language: language ?? PreferredLanguages, allowLanguageFallback: allowLanguageFallback, allowChapterJump: allowChapterJump, requestedChapter: requestedChapter);
                if (readerPreparation is null)
                {
                    ShowWarning("Could not start MangaDex chapter preparation.");
                    return;
                }

                var completedPreparation = await WaitForReaderPreparationAsync(readerPreparation.JobId);
                if (completedPreparation?.Launch is null)
                {
                    if (completedPreparation?.ChapterJump is not null)
                    {
                        chapterJumpEntryId = entryId;
                        chapterJump = completedPreparation.ChapterJump;
                        return;
                    }
                    if (completedPreparation?.ChapterMatch is not null)
                    {
                        chapterMatchEntryId = entryId;
                        chapterMatch = completedPreparation.ChapterMatch;
                        return;
                    }
                    if (completedPreparation?.AvailableLanguages is { Count: > 0 })
                    {
                        languageFallbackEntryId = entryId;
                        fallbackLanguages = completedPreparation.AvailableLanguages;
                        fallbackLanguage = fallbackLanguages[0];
                        return;
                    }
                    if (completedPreparation?.IsSeriesComplete == true)
                    {
                        await Load();
                        Messages.Success("You've read every available chapter in this completed manga. It is now marked done on your shelf.", "You're done reading");
                        return;
                    }
                    if (IsNoLaterChapter(completedPreparation))
                    {
                        Messages.Warning("You've read all available chapters.", "All caught up");
                        return;
                    }

                    Messages.Error(completedPreparation?.Error ?? "Could not prepare a MangaDex chapter for the local reader.", "Chapter unavailable");
                    return;
                }

                Navigation.NavigateTo(completedPreparation.Launch.ReaderUrl);
                return;
            }

            ShowWarning("No MangaDex URL or local series is registered for this manga yet.");
        }
        finally
        {
            isPreparingReader = false;
            readerPreparation = null;
        }
    }

    private async Task<ReaderPreparationStatus?> WaitForReaderPreparationAsync(Guid jobId)
    {
        while (true)
        {
            await Task.Delay(350);
            var preparation = await MangaApi.GetMangaDexPreparationAsync(jobId);
            if (preparation is null)
            {
                return null;
            }

            readerPreparation = preparation;
            await InvokeAsync(StateHasChanged);
            if (preparation.IsComplete)
            {
                return preparation;
            }
        }
    }

    private void Edit(MangaEntryResponse entry)
    {
        editingEntry = entry;
    }

    private void CloseEdit()
    {
        editingEntry = null;
    }

    private async Task OnShelfEditSaved(string text)
    {
        Messages.Success(text);
        await Load();
    }

    private async Task UpdateScore(MangaEntryResponse entry, int? score)
    {
        var request = new AddToShelfRequest(
            entry.Id,
            entry.ReadingStatus,
            entry.CurrentChapter,
            score,
            entry.Category,
            entry.Summary,
            entry.Notes);
        var updated = await ShelfApi.UpdateShelfAsync(entry.Id, request, IsAdmin ? selectedUserId : null);
        if (updated is null)
        {
            Messages.Error("Could not save your rating.", "Rating unavailable");
            return;
        }

        var index = entries.FindIndex(item => item.Id == entry.Id);
        if (index >= 0)
        {
            entries[index] = updated;
        }
    }

    private void ShowWarning(string text) => Messages.Warning(text);

    private void CancelLanguageFallback()
    {
        languageFallbackEntryId = null;
        fallbackLanguages = [];
    }

    private async Task ContinueInFallbackLanguage()
    {
        if (languageFallbackEntryId is not { } entryId || string.IsNullOrWhiteSpace(fallbackLanguage))
        {
            return;
        }

        CancelLanguageFallback();
        await Read(entryId, fallbackLanguage, allowLanguageFallback: true);
    }

    private void CancelChapterMatch()
    {
        chapterMatchEntryId = null;
        chapterMatch = null;
    }

    private async Task ConfirmChapterMatch()
    {
        if (chapterMatchEntryId is not { } entryId || chapterMatch is null)
        {
            return;
        }

        var language = chapterMatch.Language;
        CancelChapterMatch();
        await Read(entryId, language, allowLanguageFallback: true, allowChapterJump: true);
    }

    private void CancelChapterJump()
    {
        chapterJumpEntryId = null;
        chapterJump = null;
    }

    private async Task ConfirmChapterJump()
    {
        if (chapterJumpEntryId is not { } entryId || chapterJump is null)
        {
            return;
        }

        var language = chapterJump.Language;
        CancelChapterJump();
        await Read(entryId, language, allowLanguageFallback: true, allowChapterJump: true);
    }

    private async Task ReadChapterJumpAlternative(string language)
    {
        if (chapterJumpEntryId is not { } entryId || string.IsNullOrWhiteSpace(language))
        {
            return;
        }

        CancelChapterJump();
        await Read(entryId, language);
    }

    private static readonly (string Code, string Label)[] ReaderLanguages =
    [
        ("en", "English"), ("pt-br", "Portuguese (Brazil)"), ("pt", "Portuguese"), ("es", "Spanish"),
        ("fr", "French"), ("de", "German"), ("it", "Italian"), ("ja", "Japanese"), ("ko", "Korean")
    ];

    private static string LanguageLabel(string code) => ReaderLanguages.FirstOrDefault(language => string.Equals(language.Code, code, StringComparison.OrdinalIgnoreCase)).Label ?? code;

    private static bool IsNoLaterChapter(ReaderPreparationStatus? preparation) =>
        string.Equals(preparation?.Error, "No later readable MangaDex chapter is available.", StringComparison.Ordinal);

    private List<MangaEntryResponse> VisibleEntries => entries
        .Where(MatchesSearch)
        .Where(MatchesSource)
        .Where(MatchesCategory)
        .Where(MatchesAvailability)
        .Where(MatchesScore)
        .ToList();

    private List<MangaEntryResponse> NewReleaseEntries => VisibleEntries
        .Where(IsReadingWithNewChapters)
        .ToList();

    private List<MangaEntryResponse> UntrackedEntries => VisibleEntries
        .Where(NeedsManualReleaseCheck)
        .ToList();

    private List<string> CategoryOptions => entries
        .Select(entry => FirstNonEmpty(entry.Category, entry.CatalogCategory))
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private string FilterButtonLabel => ActiveFilterCount == 0 ? "Filters" : $"Filters ({ActiveFilterCount})";
    private int ActiveFilterCount =>
        Count(searchText) + Count(sourceFilter) + Count(categoryFilter) + Count(availabilityFilter) + Count(scoreFilter) + (IsAdmin && selectedUserId != currentUser?.Id ? 1 : 0);

    private bool IsUpdatesSection => string.Equals(activeSection, "updates", StringComparison.Ordinal);
    private string ActiveStatusFilter => activeSection is "planned" or "reading" or "paused" or "done" or "dropped" ? activeSection : "";
    private string EmptySectionMessage => IsUpdatesSection ? "No new releases or untracked manga need your attention." : "Your shelf is empty for this section and filter.";
    private bool IsSectionActive(string section) => string.Equals(activeSection, section, StringComparison.Ordinal);
    private int SectionCount(string section) => section switch
    {
        "updates" => sectionSummary.Updates,
        "planned" => sectionSummary.Planned,
        "reading" => sectionSummary.Reading,
        "paused" => sectionSummary.Paused,
        "done" => sectionSummary.Done,
        "dropped" => sectionSummary.Dropped,
        _ => sectionSummary.All
    };

    private static string NormalizeSection(string? section) => section?.Trim().ToLowerInvariant() switch
    {
        "updates" or "planned" or "reading" or "paused" or "done" or "dropped" or "all" => section.Trim().ToLowerInvariant(),
        _ => "updates"
    };

    private bool MatchesSearch(MangaEntryResponse entry)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        return Contains(entry.Title, searchText)
            || Contains(entry.Authors, searchText)
            || Contains(entry.Summary, searchText)
            || Contains(entry.Description, searchText)
            || Contains(entry.Notes, searchText);
    }

    private bool MatchesSource(MangaEntryResponse entry) =>
        string.IsNullOrWhiteSpace(sourceFilter) || string.Equals(GetSourceLabel(entry.MetadataSource, entry.MyAnimeListId, entry.OpenLibraryKey), sourceFilter, StringComparison.OrdinalIgnoreCase);

    private bool MatchesCategory(MangaEntryResponse entry) =>
        string.IsNullOrWhiteSpace(categoryFilter)
        || SplitCategories(FirstNonEmpty(entry.Category, entry.CatalogCategory))
            .Contains(categoryFilter, StringComparer.OrdinalIgnoreCase);

    private bool MatchesAvailability(MangaEntryResponse entry) => availabilityFilter switch
    {
        "local" => entry.LocalSeriesId is not null,
        "mangadex" => HasMangaDexLink(entry),
        "external" => entry.LocalSeriesId is null && !HasMangaDexLink(entry) && IsHttpUrl(entry.FallbackReaderUrl),
        "missing" => entry.LocalSeriesId is null && !HasMangaDexLink(entry) && !IsHttpUrl(entry.FallbackReaderUrl),
        _ => true
    };

    private bool MatchesScore(MangaEntryResponse entry) => scoreFilter switch
    {
        "rated" => entry.Score is not null,
        "unrated" => entry.Score is null,
        "4plus" => entry.Score >= 4,
        "5" => entry.Score == 5,
        _ => true
    };

    private static int ShelfSortRank(MangaEntryResponse entry)
    {
        if (IsReadingWithNewChapters(entry))
        {
            return 0;
        }

        return (entry.ReadingStatus ?? "").ToLowerInvariant() switch
        {
            "planned" => 1,
            "reading" => 2,
            "paused" => 3,
            "dropped" => 4,
            "done" => 5,
            _ => 4
        };
    }

    private static int Count(string value) => string.IsNullOrWhiteSpace(value) ? 0 : 1;
    private static int Count(bool value) => value ? 1 : 0;

    private static bool HasNewChapters(MangaEntryResponse entry) =>
        HasMangaDexLink(entry)
        && entry.MangaDexPreferredLanguageLatestChapter is not null
        && TryGetCurrentChapterNumber(entry.CurrentChapter, out var currentChapter)
        && (entry.MangaDexPreferredLanguageLatestChapter.Value > currentChapter
            || (entry.MangaDexPreferredLanguageLatestChapter.Value == currentChapter && !entry.IsRead));

    private static bool IsReadingWithNewChapters(MangaEntryResponse entry) =>
        IsActivelyTracked(entry)
        && HasNewChapters(entry);

    private static bool NeedsManualReleaseCheck(MangaEntryResponse entry) =>
        IsActivelyTracked(entry)
        && !HasMangaDexLink(entry);

    private static bool IsActivelyTracked(MangaEntryResponse entry) =>
        string.Equals(entry.ReadingStatus, "reading", StringComparison.OrdinalIgnoreCase)
        || string.Equals(entry.ReadingStatus, "paused", StringComparison.OrdinalIgnoreCase);

    private static bool IsPlanned(MangaEntryResponse entry) =>
        string.Equals(entry.ReadingStatus, "planned", StringComparison.OrdinalIgnoreCase);

    private static bool HasMangaDexLink(MangaEntryResponse entry) => !string.IsNullOrWhiteSpace(entry.MangaDexId);

    private static bool IsHttpUrl(string value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    private static bool Contains(string value, string query) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(query, StringComparison.OrdinalIgnoreCase);

    private static string FirstNonEmpty(params string[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? "";

    private static IEnumerable<string> SplitCategories(string value) =>
        (value ?? "").Split([',', ';', '|'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static bool TryGetCurrentChapterNumber(string currentChapter, out decimal chapter)
    {
        chapter = 0;
        if (string.IsNullOrWhiteSpace(currentChapter))
        {
            return false;
        }

        var chapterText = new string(currentChapter
            .SkipWhile(value => !char.IsDigit(value))
            .TakeWhile(value => char.IsDigit(value) || value is '.' or ',')
            .ToArray())
            .Replace(',', '.');
        return decimal.TryParse(chapterText, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out chapter);
    }

    private static string GetSourceLabel(string metadataSource, string myAnimeListId, string openLibraryKey)
    {
        var source = metadataSource.ToLowerInvariant() switch
        {
            "myanimelist" => "MAL",
            "openlibrary" => "OpenLibrary",
            _ => metadataSource
        };

        if (!string.IsNullOrWhiteSpace(source))
        {
            return source;
        }

        if (!string.IsNullOrWhiteSpace(myAnimeListId))
        {
            return "MAL";
        }

        if (!string.IsNullOrWhiteSpace(openLibraryKey))
        {
            return "OpenLibrary";
        }

        return "Manual";
    }

}
