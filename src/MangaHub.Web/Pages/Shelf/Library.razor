@page "/library"
@using MangaHub.Web.API.Services
@inject AuthSessionService Auth
@inject NavigationManager Navigation
@inject AdminApiService AdminApi
@inject MangaApiService MangaApi

<PageTitle>Shelf</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mh-page-title">
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Personal tracker</MudText>
            <MudText Typo="Typo.h1">Shelf</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" Class="flex-wrap">
            <MudMenu Label="Add" StartIcon="@Icons.Material.Filled.AddCircleOutline" Variant="Variant.Filled" Color="Color.Primary">
                <MudMenuItem Icon="@Icons.Material.Filled.PlaylistAdd" OnClick="OpenAddShelf">Add manga</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.UploadFile" OnClick="OpenImportShelf">Import CSV</MudMenuItem>
            </MudMenu>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">Refresh</MudButton>
        </MudStack>
    </MudStack>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
            <MudSelect T="string" @bind-Value="status" Label="Status" Variant="Variant.Outlined" Dense="true" Class="mh-filter">
                <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("reading")">Reading</MudSelectItem>
                <MudSelectItem T="string" Value="@("done")">Done</MudSelectItem>
                <MudSelectItem T="string" Value="@("paused")">Paused</MudSelectItem>
                <MudSelectItem T="string" Value="@("planned")">Planned</MudSelectItem>
                <MudSelectItem T="string" Value="@("dropped")">Dropped</MudSelectItem>
            </MudSelect>
            @if (IsAdmin)
            {
                <MudSelect T="Guid?" @bind-Value="selectedUserId" Label="Shelf owner" Variant="Variant.Outlined" Dense="true" Class="mh-filter">
                    @foreach (var user in users)
                    {
                        <MudSelectItem T="Guid?" Value="@user.Id">@user.Username (@user.Role)</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Load">Apply</MudButton>
        </MudStack>
    </MudPaper>

    @if (entries.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Your shelf is empty for this filter.</MudAlert>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var item in entries)
            {
                <ShelfEntryCard Entry="@item" ActiveStatusFilter="@status" OnRead="Read" OnEdit="Edit" OnStatusFilter="ToggleStatusFilter" />
            }
        </MudStack>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="@messageSeverity" Variant="Variant.Outlined">@message</MudAlert>
    }
</MudStack>

<ShelfAddModal Open="@isAddShelfOpen" OpenChanged="OnAddShelfOpenChanged" OnSaved="Load" />
<ShelfImportModal Open="@isImportShelfOpen" OpenChanged="OnImportShelfOpenChanged" OnImported="Load" />
<ShelfEditModal Entry="@editingEntry" OwnerUserId="@(IsAdmin ? selectedUserId : null)" OnSaved="OnShelfEditSaved" OnClosed="CloseEdit" />

@code {
    private List<MangaEntryResponse> entries = [];
    private List<UserAdminResponse> users = [];
    private UserResponse? currentUser;
    private bool IsAdmin => string.Equals(currentUser?.Role, "admin", StringComparison.OrdinalIgnoreCase);
    private Guid? selectedUserId;
    private string status = "";
    private string message = "";
    private Severity messageSeverity = Severity.Warning;
    private bool isAddShelfOpen;
    private bool isImportShelfOpen;
    private MangaEntryResponse? editingEntry;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await Auth.GetCurrentUserAsync();
        if (IsAdmin)
        {
            users = await AdminApi.GetUsersAsync();
            selectedUserId = currentUser?.Id;
        }
        await Load();
    }

    private void OpenAddShelf() => isAddShelfOpen = true;
    private void OpenImportShelf() => isImportShelfOpen = true;
    private void OnAddShelfOpenChanged(bool open) => isAddShelfOpen = open;
    private void OnImportShelfOpenChanged(bool open) => isImportShelfOpen = open;

    private async Task ToggleStatusFilter(string clickedStatus)
    {
        status = string.Equals(status, clickedStatus, StringComparison.OrdinalIgnoreCase) ? "" : clickedStatus;
        await Load();
    }

    private async Task Load()
    {
        entries = await MangaApi.GetMangaEntriesAsync(status, IsAdmin ? selectedUserId : null);
        CloseEdit();
    }

    private async Task Read(Guid entryId)
    {
        var options = await MangaApi.GetReadOptionsAsync(entryId);
        if (options is null)
        {
            ShowWarning("Could not load read options.");
            return;
        }

        if (options.HasLocal)
        {
            Navigation.NavigateTo(options.LocalReaderUrl);
            return;
        }

        if (options.HasMangaDex)
        {
            Navigation.NavigateTo(options.MangaDexUrl, forceLoad: true);
            return;
        }

        ShowWarning("No MangaDex URL or local series is registered for this manga yet.");
    }

    private void Edit(MangaEntryResponse entry)
    {
        editingEntry = entry;
    }

    private void CloseEdit()
    {
        editingEntry = null;
    }

    private async Task OnShelfEditSaved(string text)
    {
        messageSeverity = Severity.Success;
        message = text;
        await Load();
    }

    private void ShowWarning(string text)
    {
        messageSeverity = Severity.Warning;
        message = text;
    }

}
