@page "/bento-card-lab"
@using MangaHub.Web.Components.Catalog
@using MangaHub.Web.Components.Shelf
@inject AuthSessionService Auth
@inject NavigationManager Navigation

<PageTitle>Bento Card Lab</PageTitle>

<MudStack Spacing="3" Class="mh-card-lab">
    <MudStack Spacing="1">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Admin debug</MudText>
        <MudText Typo="Typo.h1">Bento card lab</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Static sample data for checking card height, bento spans, mobile behavior, and CSS overrides without API calls.
        </MudText>
    </MudStack>

    @if (!CanViewLab && currentUser is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            Sign in as an admin to use the card lab.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" OnClick="OpenLogin">
            Sign in
        </MudButton>
    }
    else if (!CanViewLab)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            Admin permissions are required to use this debug page.
        </MudAlert>
    }
    else
    {
        <MudStack Spacing="2">
            <MudText Typo="Typo.h2">Shelf cards</MudText>
            @foreach (var entry in ShelfEntries)
            {
                <ShelfEntryCard Entry="@entry"
                                ActiveStatusFilter="@ActiveStatus"
                                OnStatusFilter="SetStatusFilter"
                                OnEdit="NoopShelfEdit"
                                OnRead="NoopRead" />
            }
        </MudStack>

        <MudStack Spacing="2">
            <MudText Typo="Typo.h2">Catalog cards</MudText>
            @foreach (var entry in CatalogEntries)
            {
                <CatalogEntryCard Entry="@entry"
                                  ActiveSourceFilter="@ActiveSource"
                                  OnSourceFilter="SetSourceFilter"
                                  OnManageCache="NoopCatalogCache"
                                  OnEdit="NoopCatalogEdit" />
            }
        </MudStack>
    }
</MudStack>

@code {
    private UserResponse? currentUser;
    private bool IsAdmin => string.Equals(currentUser?.Role, "admin", StringComparison.OrdinalIgnoreCase);
    private bool IsLocalhost => Navigation.Uri.StartsWith("http://localhost", StringComparison.OrdinalIgnoreCase)
        || Navigation.Uri.StartsWith("https://localhost", StringComparison.OrdinalIgnoreCase)
        || Navigation.Uri.StartsWith("http://127.0.0.1", StringComparison.OrdinalIgnoreCase)
        || Navigation.Uri.StartsWith("https://127.0.0.1", StringComparison.OrdinalIgnoreCase);
    private bool CanViewLab => IsLocalhost || IsAdmin;
    private string ActiveStatus { get; set; } = "";
    private string ActiveSource { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await Auth.GetCurrentUserAsync(forceRefresh: true);
