@inherits LayoutComponentBase

<MudThemeProvider Theme="@MangaHubPalette.Theme" IsDarkMode="@_darkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="mh-layout-root">
    <MudLayout>
        <MudAppBar Elevation="0" Dense="true" Class="mh-appbar">
            <MudText Typo="Typo.h6" Class="mh-brand">MangaHub</MudText>
            <MudSpacer />
            <MudTooltip Text="@(_darkMode ? "Use light theme" : "Use dark theme")">
                <MudIconButton Icon="@(_darkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit"
                               OnClick="ToggleTheme" />
            </MudTooltip>
            @if (_currentUser is not null)
            {
                <MudBadge Content="@_unreadNotificationCount.ToString()" Color="Color.Error" Overlap="true" Origin="Origin.BottomRight" Visible="@(_unreadNotificationCount > 0)">
                    <MudMenu Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Disabled="true">Notifications</MudMenuItem>
                        @if (_notifications.Count == 0)
                        {
                            <MudMenuItem Disabled="true">No new chapter notifications.</MudMenuItem>
                        }
                        else
                        {
                            @foreach (var notification in _notifications)
                            {
                                <MudMenuItem Icon="@(notification.ReadAt is null ? Icons.Material.Filled.FiberNew : Icons.Material.Filled.NotificationsNone)" OnClick="() => OpenNotification(notification)">@notification.Title</MudMenuItem>
                            }
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Filled.DoneAll" OnClick="MarkAllNotificationsRead">Mark all as read</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearReadNotifications">Clear read notifications</MudMenuItem>
                        }
                        <MudDivider />
                        @if (_pushSubscriptions.Count == 0)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.NotificationsActive" OnClick="EnablePhoneNotifications">Enable phone notifications</MudMenuItem>
                        }
                        else
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="OpenPushSubscriptions">Phone notification settings</MudMenuItem>
                        }
                    </MudMenu>
                </MudBadge>
            }
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                     Color="Color.Inherit"
                     Class="mh-account-menu"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
                @if (_currentUser is null)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Login" OnClick="OpenLogin">Sign in</MudMenuItem>
                }
                else
                {
                    <MudMenuItem Disabled="true">@_currentUser.Username (@_currentUser.Role)</MudMenuItem>
                    @if (IsAdmin)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.AdminPanelSettings" OnClick="GoAdminManagement">Admin management</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.BugReport" OnClick="GoBentoCardLab">Bento card lab</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.NotificationsActive" OnClick="TestPhoneNotification">Test phone notification</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Storage" OnClick="TestDatabase">Test database</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.CloudSync" OnClick="TestMangaDex">Test MangaDex connection</MudMenuItem>
                    }
                    <MudMenuItem Icon="@Icons.Material.Filled.ManageAccounts" OnClick="GoAccount">Manage account</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Log out</MudMenuItem>
                }
            </MudMenu>
        </MudAppBar>

        <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="0" ClipMode="DrawerClipMode.Never" Class="@DrawerClass">
            <MudStack Spacing="1" Class="mh-rail">
                <div class="mh-rail-brand">
                    <MudIconButton Icon="@Icons.Material.Filled.AutoStories" Color="Color.Primary" OnClick="GoHome"/>
                    @if (_drawerExpanded)
                    {
                        <MudText Typo="Typo.subtitle2">Library</MudText>
                    }
                </div>

                <NavRailButton Route="" Label="Home" Icon="@Icons.Material.Filled.Dashboard" Expanded="@_drawerExpanded" IsActive="@IsActive("")" OnNavigate="Navigate" />
                <NavRailButton Route="library" Label="Shelf" Icon="@Icons.Material.Filled.AutoStories" Expanded="@_drawerExpanded" IsActive="@IsActive("library")" OnNavigate="Navigate" />
                @if (IsAdmin)
                {
                    <NavRailButton Route="admin/catalog" Label="Admin" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="@_drawerExpanded" IsActive="@IsAdminSectionActive" OnNavigate="Navigate" />
                }
                <NavRailButton Route="account" Label="Account" Icon="@Icons.Material.Filled.ManageAccounts" Expanded="@_drawerExpanded" IsActive="@IsActive("account")" OnNavigate="Navigate" />

                <MudSpacer />

                <MudTooltip Text="@(_drawerExpanded ? "Collapse sidebar" : "Expand sidebar")" Placement="Placement.Right" Class="mh-nav-tooltip">
                    <MudIconButton Icon="@(_drawerExpanded ? Icons.Material.Filled.KeyboardDoubleArrowLeft : Icons.Material.Filled.KeyboardDoubleArrowRight)"
                                   Color="Color.Primary"
                                   Class="mh-rail-action"
                                   OnClick="ToggleDrawer" />
                </MudTooltip>
            </MudStack>
        </MudDrawer>

        <MudMainContent Class="mh-main">
            <MudContainer MaxWidth="MaxWidth.Large" Class="mh-content">
                @Body
            </MudContainer>
        </MudMainContent>

        <nav class="mh-mobile-nav" aria-label="Primary navigation">
            <button type="button" class="@MobileNavClass("")" @onclick="@(() => Navigate(""))">
                <MudIcon Icon="@Icons.Material.Filled.Dashboard" />
                <span>Home</span>
            </button>
            <button type="button" class="@MobileNavClass("library")" @onclick="@(() => Navigate("library"))">
                <MudIcon Icon="@Icons.Material.Filled.AutoStories" />
                <span>Shelf</span>
            </button>
            @if (IsAdmin)
            {
                <button type="button" class="@AdminMobileNavClass" @onclick="@(() => Navigate("admin/catalog"))">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                    <span>Admin</span>
                </button>
            }
            <button type="button" class="@MobileNavClass("account")" @onclick="@(() => Navigate("account"))">
                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" />
                <span>Account</span>
            </button>
        </nav>
    </MudLayout>

    <LoginModal @bind-Open="_loginOpen"
                Message="@_loginMessage"
                OnAuthenticated="OnLoginAuthenticated" />
    <AppMessageModal />
    <PushSubscriptionsModal @bind-Open="_pushSubscriptionsOpen"
                            Subscriptions="_pushSubscriptions"
                            OnRefresh="EnablePhoneNotifications"
                            OnUnsubscribe="UnsubscribeDevice" />
    @if (_externalReaderCheckIn is not null)
    {
        <div class="mh-modal-backdrop">
            <section class="mh-modal" role="dialog" aria-modal="true" aria-labelledby="external-reader-check-in-title">
                <MudStack Spacing="3">
                    <MudText id="external-reader-check-in-title" Typo="Typo.h2">How was @_externalReaderCheckIn.Title?</MudText>
                    <MudText Typo="Typo.body1">Update your current chapter here if you found something new.</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Currently tracked: @(string.IsNullOrWhiteSpace(_externalReaderCheckIn.CurrentChapter) ? "Not started" : $"Ch. {_externalReaderCheckIn.CurrentChapter}")</MudText>
                    <MudTextField T="string" @bind-Value="_externalReaderCurrentChapter" Label="Current chapter" Variant="Variant.Outlined" Immediate="true" Disabled="@_savingExternalReaderProgress" />
                    <MudStack Row="true" Spacing="2" Class="flex-wrap" Justify="Justify.FlexEnd">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="@_savingExternalReaderProgress" OnClick="DismissExternalReaderCheckIn">I did not check</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@_savingExternalReaderProgress" OnClick="ConfirmNoExternalReaderUpdate">No new chapters</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_savingExternalReaderProgress" OnClick="UpdateExternalReaderProgress">@(_savingExternalReaderProgress ? "Saving..." : "Save progress")</MudButton>
                    </MudStack>
                </MudStack>
            </section>
        </div>
    }
</div>
