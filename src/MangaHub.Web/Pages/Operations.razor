@page "/operations"
@page "/admin/operations"
@using MangaHub.Web.API.DTOs
@using MangaHub.Web.API.Services
@inject AuthSessionService Auth
@inject AdminApiService AdminApi
@inject MessageService Messages

<PageTitle>Operations</PageTitle>

@if (user is null)
{
    <MudAlert Severity="Severity.Warning">Sign in to view operations.</MudAlert>
}
else if (!isAdmin)
{
    <MudAlert Severity="Severity.Error">Admin permissions are required.</MudAlert>
}
else if (isLoading)
{
    <MudStack AlignItems="AlignItems.Center" Class="mh-operations-loading"><MudProgressCircular Indeterminate="true" /><MudText>Loading operations...</MudText></MudStack>
}
else if (overview is not null)
{
    <MudStack Spacing="3">
        <AdminSectionNav />
        <section class="mh-dashboard-header">
            <MudStack Spacing="1"><MudText Typo="Typo.overline" Color="Color.Secondary">Admin maintenance</MudText><MudText Typo="Typo.h2">Operations</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Storage, source freshness, and worker requests in one place.</MudText></MudStack>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Refresh</MudButton>
        </section>

        <MangaBento Columns="4" Class="mh-operations-bento">
            <MangaBentoTile Scheme="deep" CornerIcon="@Icons.Material.Filled.Inventory2" ItemClass="mh-operations-stat-item"><div class="mh-operation-stat"><MudText Typo="Typo.overline">Catalog</MudText><MudText Typo="Typo.h3">@overview.CatalogCount</MudText><MudText Typo="Typo.caption">@overview.MangaDexLinkedCount MangaDex-linked</MudText></div></MangaBentoTile>
            <MangaBentoTile Scheme="primary" CornerIcon="@Icons.Material.Filled.Storage" ItemClass="mh-operations-stat-item"><div class="mh-operation-stat"><MudText Typo="Typo.overline">Storage</MudText><MudText Typo="Typo.h3">@overview.CachedChapterCount</MudText><MudText Typo="Typo.caption">@FormatBytes(overview.CacheBytes) local</MudText></div></MangaBentoTile>
            <MangaBentoTile Scheme="warm" CornerIcon="@Icons.Material.Filled.CloudSync" ItemClass="mh-operations-stat-item"><div class="mh-operation-stat"><MudText Typo="Typo.overline">MangaDex</MudText><MudText Typo="Typo.h3">@overview.StaleMangaDexCount</MudText><MudText Typo="Typo.caption">stale · @FormatDate(overview.LastMangaDexSyncAt)</MudText></div></MangaBentoTile>
            <MangaBentoTile Scheme="secondary" CornerIcon="@Icons.Material.Filled.Update" ItemClass="mh-operations-stat-item"><div class="mh-operation-stat"><MudText Typo="Typo.overline">MangaUpdates</MudText><MudText Typo="Typo.h3">@overview.StaleMangaUpdatesCount</MudText><MudText Typo="Typo.caption">stale · @FormatDate(overview.LastMangaUpdatesSyncAt)</MudText></div></MangaBentoTile>
            <MangaBentoTile ColSpan="4" Scheme="primary" CornerIcon="@Icons.Material.Filled.Storage" ItemClass="mh-operations-storage-item">
                <div class="mh-operation-storage-policy">
                    <MudText Typo="Typo.overline">Storage policy</MudText>
                    <div class="mh-operation-storage-grid">
                        <div><MudText Typo="Typo.caption">Active cache</MudText><MudText Typo="Typo.h6">@FormatBytes(overview.ActiveCacheBytes)</MudText><MudText Typo="Typo.caption">@overview.ActiveCachedChapterCount chapters</MudText></div>
                        <div><MudText Typo="Typo.caption">Archive</MudText><MudText Typo="Typo.h6">@FormatBytes(overview.ArchivedCacheBytes)</MudText><MudText Typo="Typo.caption">@overview.ArchivedChapterCount chapters</MudText></div>
                        <div><MudText Typo="Typo.caption">Original / Data Saver</MudText><MudText Typo="Typo.h6">@overview.OriginalCachedChapterCount / @overview.DataSaverCachedChapterCount</MudText><MudText Typo="Typo.caption">@FormatBytes(overview.OriginalCacheBytes) / @FormatBytes(overview.DataSaverCacheBytes)</MudText></div>
                        <div><MudText Typo="Typo.caption">Projected active reclaim</MudText><MudText Typo="Typo.h6">@FormatBytes(overview.ReclaimableActiveBytes)</MudText><MudText Typo="Typo.caption">@overview.ReclaimableActiveChapterCount chapters · 7-day grace</MudText></div>
                        <div><MudText Typo="Typo.caption">Archive recovery · 30 days</MudText><MudText Typo="Typo.h6">@overview.ArchiveRestoreCountLast30Days restored</MudText><MudText Typo="Typo.caption">@overview.ArchiveRedownloadCountLast30Days re-downloaded</MudText></div>
                    </div>
                </div>
            </MangaBentoTile>
            <MangaBentoTile ColSpan="2" RowSpan="2" Scheme="ink" CornerIcon="@Icons.Material.Filled.PlaylistPlay" ItemClass="mh-operations-actions-item">
                <div class="mh-operation-jobs">
                    <MudText Typo="Typo.overline">Run maintenance</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Requests are picked up by the worker within about 20 seconds.</MudText>
                    <MudStack Spacing="1">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync" Disabled="@isQueueing" OnClick='@(() => QueueAsync("release-sync"))'>Refresh MangaDex releases</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt" Disabled="@isQueueing" OnClick='@(() => QueueAsync("mangadex-status-sync"))'>Refresh MangaDex statuses and repair shelves</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DeleteSweep" Disabled="@isQueueing" OnClick='@(() => QueueAsync("mangadex-cache-cleanup"))'>Trim read MangaDex cache</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FactCheck" Disabled="@isQueueing" OnClick='@(() => QueueAsync("mangadex-archive-integrity-check"))'>Verify archived CBZ samples</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Update" Disabled="@isQueueing" OnClick='@(() => QueueAsync("mangaupdates-sync"))'>Refresh MangaUpdates</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Link" Disabled="@isQueueing" OnClick='@(() => QueueAsync("catalog-id-enrichment"))'>Fill missing MangaDex and MangaUpdates IDs</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Folder" Disabled="@isQueueing" OnClick='@(() => QueueAsync("library-scan"))'>Scan local library</MudButton>
                    </MudStack>
                </div>
            </MangaBentoTile>
            <MangaBentoTile ColSpan="2" RowSpan="2" Scheme="soft" CornerIcon="@Icons.Material.Filled.History" ItemClass="mh-operations-history-item">
                <div class="mh-operation-jobs">
                    <MudText Typo="Typo.overline">Recent worker jobs</MudText>
                    <div class="mh-operation-history-filters">
                        <MudSelect T="string" Label="Operation" Dense="true" Variant="Variant.Outlined" Clearable="true" @bind-Value="historyType" @bind-Value:after="ReloadHistoryAsync">
                            @foreach (var operation in OperationTypes) { <MudSelectItem Value="@operation.Type">@operation.Label</MudSelectItem> }
                        </MudSelect>
                        <MudSelect T="string" Label="Status" Dense="true" Variant="Variant.Outlined" Clearable="true" @bind-Value="historyStatus" @bind-Value:after="ReloadHistoryAsync">
                            <MudSelectItem Value="@("completed")">Completed</MudSelectItem><MudSelectItem Value="@("running")">Running</MudSelectItem><MudSelectItem Value="@("queued")">Queued</MudSelectItem><MudSelectItem Value="@("failed")">Failed</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" Label="Started by" Dense="true" Variant="Variant.Outlined" Clearable="true" @bind-Value="historyTrigger" @bind-Value:after="ReloadHistoryAsync">
                            <MudSelectItem Value="@("scheduled")">Schedule</MudSelectItem><MudSelectItem Value="@("watchdog")">Watchdog</MudSelectItem><MudSelectItem Value="@("manual")">Manual</MudSelectItem>
                        </MudSelect>
                    </div>
                    @if (historyJobs.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No maintenance jobs have run yet.</MudText>
                    }
                    else
                    {
                        @foreach (var job in historyJobs)
                        {
                            <div class="mh-operation-job"><MudStack Spacing="0"><MudText Typo="Typo.subtitle2">@JobLabel(job.Type)</MudText><MudText Typo="Typo.caption">@FormatDate(job.RequestedAt) · @JobTriggerLabel(job.Trigger)</MudText></MudStack><MudChip T="string" Size="Size.Small" Color="@JobColor(job.Status)">@job.Status</MudChip></div>
                            @if (!string.IsNullOrWhiteSpace(job.Error)) { <MudText Typo="Typo.caption" Color="Color.Error">@job.Error</MudText> }
                        }
                        @if (hasMoreHistory)
                        {
                            <MudButton Variant="Variant.Text" Disabled="@isLoadingMoreHistory" OnClick="LoadMoreHistoryAsync">@(isLoadingMoreHistory ? "Loading history..." : "Show older runs")</MudButton>
                        }
                    }
                </div>
            </MangaBentoTile>
        </MangaBento>
    </MudStack>
}

@code {
    private UserResponse? user;
    private OperationsOverviewResponse? overview;
    private List<MaintenanceJobResponse> historyJobs = [];
    private bool isLoading = true;
    private bool isQueueing;
    private bool isLoadingMoreHistory;
    private bool isLoadingHistory;
    private bool hasMoreHistory;
    private string? historyType;
    private string? historyStatus;
    private string? historyTrigger;
    private const int HistoryPageSize = 25;
    private static readonly (string Type, string Label)[] OperationTypes =
    [
        ("release-sync", "MangaDex release refresh"),
        ("mangadex-status-sync", "MangaDex status repair"),
        ("prefetch", "Update prefetch"),
        ("mangadex-cache-cleanup", "Cache cleanup"),
        ("mangadex-archive-integrity-check", "Archive integrity check"),
        ("mangaupdates-sync", "MangaUpdates refresh"),
        ("catalog-id-enrichment", "Catalog ID matching"),
        ("library-scan", "Local library scan"),
        ("idle-backfill", "Idle backfill")
    ];
    private bool isAdmin => string.Equals(user?.Role, "admin", StringComparison.OrdinalIgnoreCase);
    protected override async Task OnInitializedAsync() { user = await Auth.GetCurrentUserAsync(); if (isAdmin) await LoadAsync(); else isLoading = false; }
    private async Task LoadAsync() { isLoading = true; try { overview = await AdminApi.GetOperationsAsync(); if (overview is null) { Messages.Error("Could not load operations."); return; } await ReloadHistoryAsync(); } finally { isLoading = false; } }
    private async Task ReloadHistoryAsync() { if (isLoadingHistory) return; isLoadingHistory = true; try { historyJobs = await AdminApi.GetMaintenanceHistoryAsync(0, HistoryPageSize, historyType, historyStatus, historyTrigger); hasMoreHistory = historyJobs.Count == HistoryPageSize; } finally { isLoadingHistory = false; } }
    private async Task LoadMoreHistoryAsync() { if (isLoadingMoreHistory) return; isLoadingMoreHistory = true; try { var older = await AdminApi.GetMaintenanceHistoryAsync(historyJobs.Count, HistoryPageSize, historyType, historyStatus, historyTrigger); historyJobs.AddRange(older); hasMoreHistory = older.Count == HistoryPageSize; } finally { isLoadingMoreHistory = false; } }
    private async Task QueueAsync(string type) { isQueueing = true; try { var job = await AdminApi.QueueMaintenanceJobAsync(type); if (job is null) { Messages.Error("Could not queue maintenance."); return; } Messages.Success($"{JobLabel(job.Type)} is {job.Status}."); await LoadAsync(); } finally { isQueueing = false; } }
    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.#} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / 1024d / 1024d:0.#} MB";
        return $"{bytes / 1024d / 1024d / 1024d:0.##} GB";
    }
    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("g") ?? "Not yet";
    private static string JobLabel(string type) => type switch { "release-sync" => "MangaDex release refresh", "mangadex-status-sync" => "MangaDex status and shelf repair", "prefetch" => "Update prefetch", "mangadex-cache-cleanup" => "MangaDex cache cleanup", "mangadex-archive-integrity-check" => "Archive integrity check", "mangaupdates-sync" => "MangaUpdates refresh", "catalog-id-enrichment" => "Catalog ID matching", "library-scan" => "Local library scan", "idle-backfill" => "Idle backfill", _ => type };
    private static string JobTriggerLabel(string trigger) => trigger switch { "scheduled" => "automatic schedule", "watchdog" => "watchdog retry", _ => "manual" };
    private static Color JobColor(string status) => status switch { "completed" => Color.Success, "failed" => Color.Error, "running" => Color.Warning, _ => Color.Info };
}
