@page "/catalog"
@using MangaHub.Web.API.Services
@inject AuthSessionService Auth
@inject CatalogApiService CatalogApi
@inject SeriesApiService SeriesApi

<PageTitle>Catalog</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mh-page-title">
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Admin catalog</MudText>
            <MudText Typo="Typo.h1">Catalog</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Manage shared manga metadata, covers, OpenLibrary matches, MangaDex links, and local series bindings.</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" Class="flex-wrap">
            <MudMenu Label="Add" StartIcon="@Icons.Material.Filled.AddCircleOutline" Variant="Variant.Filled" Color="Color.Primary">
                <MudMenuItem Icon="@Icons.Material.Filled.LibraryAdd" OnClick="OpenAddCatalog">Add manga</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.UploadFile" OnClick="OpenImportCatalog">Import CSV</MudMenuItem>
            </MudMenu>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterList" OnClick="OpenFilters">@FilterButtonLabel</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadCatalog">Refresh</MudButton>
        </MudStack>
    </MudStack>

    @if (currentUser is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Sign in first to manage the catalog.</MudAlert>
    }
    else if (!IsAdmin)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Admin permissions are required to manage catalog metadata.</MudAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity" Variant="Variant.Outlined">@message</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(sourceFilter))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Showing @sourceFilter catalog entries. Click a @sourceFilter chip again to show all sources.
            </MudAlert>
        }

        @if (FilteredCatalog.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No catalog entries matched this search.</MudAlert>
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var item in FilteredCatalog)
                {
                    <CatalogEntryCard Entry="@item" ActiveSourceFilter="@sourceFilter" OnEdit="EditCatalog" OnSourceFilter="ToggleSourceFilter" />
                }
            </MudStack>
        }
    }
</MudStack>

<CatalogAddModal Open="@isAddCatalogOpen" OpenChanged="OnAddCatalogOpenChanged" LocalSeries="@localSeries" OnSaved="LoadCatalog" />
<CatalogImportModal Open="@isImportCatalogOpen" OpenChanged="OnImportCatalogOpenChanged" OnImported="LoadCatalog" />
<CatalogEditModal Entry="@editingEntry" LocalSeries="@localSeries" OnSaved="OnCatalogSaved" OnClosed="CloseEdit" />

@if (filtersOpen)
{
    <div class="mh-modal-backdrop" @onclick="CloseFilters">
        <section class="mh-modal mh-filter-modal" role="dialog" aria-modal="true" aria-labelledby="catalog-filter-title" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mh-modal-header">
                    <MudStack Spacing="1">
                        <MudText id="catalog-filter-title" Typo="Typo.h2">Catalog filters</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Filter shared metadata by source, type, status, links, and shelf presence.</MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="CloseFilters" aria-label="Close catalog filters" />
                </MudStack>

                <BentoBlock Class="mh-filter-bento">
                    <BentoItem Width="6" Height="1">
                        <MudTextField T="string" @bind-Value="query" Label="Search catalog" Variant="Variant.Outlined" Immediate="true" />
                    </BentoItem>
                    <BentoItem Width="3" Height="1">
                        <MudSelect T="string" @bind-Value="sourceFilter" Label="Metadata source" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                            <MudSelectItem T="string" Value="@("MAL")">MAL</MudSelectItem>
                            <MudSelectItem T="string" Value="@("OpenLibrary")">OpenLibrary</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Manual")">Manual</MudSelectItem>
                        </MudSelect>
                    </BentoItem>
                    <BentoItem Width="3" Height="1">
                        <MudSelect T="string" @bind-Value="categoryFilter" Label="Genre/category" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                            @foreach (var category in CategoryOptions)
                            {
                                <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                            }
                        </MudSelect>
                    </BentoItem>
                    <BentoItem Width="3" Height="1">
                        <MudSelect T="string" @bind-Value="mediaTypeFilter" Label="Type" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                            @foreach (var mediaType in MediaTypeOptions)
                            {
                                <MudSelectItem T="string" Value="@mediaType">@mediaType</MudSelectItem>
                            }
                        </MudSelect>
                    </BentoItem>
                    <BentoItem Width="3" Height="1">
                        <MudSelect T="string" @bind-Value="publishingStatusFilter" Label="Publishing status" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                            @foreach (var publishingStatus in PublishingStatusOptions)
                            {
                                <MudSelectItem T="string" Value="@publishingStatus">@publishingStatus</MudSelectItem>
                            }
                        </MudSelect>
                    </BentoItem>
                    <BentoItem Width="3" Height="1">
                        <MudSelect T="string" @bind-Value="linkFilter" Label="Read binding" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                            <MudSelectItem T="string" Value="@("mangadex")">MangaDex</MudSelectItem>
                            <MudSelectItem T="string" Value="@("local")">Local files</MudSelectItem>
                            <MudSelectItem T="string" Value="@("missing")">Missing read source</MudSelectItem>
                        </MudSelect>
                    </BentoItem>
                    <BentoItem Width="3" Height="1">
                        <MudSelect T="string" @bind-Value="shelfFilter" Label="Shelf presence" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                            <MudSelectItem T="string" Value="@("in")">In my shelf</MudSelectItem>
                            <MudSelectItem T="string" Value="@("not-in")">Not in my shelf</MudSelectItem>
                        </MudSelect>
                    </BentoItem>
                </BentoBlock>

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="flex-wrap">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ClearFilters">Clear</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="ApplyFilters">Apply filters</MudButton>
                </MudStack>
            </MudStack>
        </section>
    </div>
}

@code {
    private UserResponse? currentUser;
    private bool IsAdmin => string.Equals(currentUser?.Role, "admin", StringComparison.OrdinalIgnoreCase);
    private List<CatalogMangaResponse> catalog = [];
    private List<SeriesResponse> localSeries = [];
    private string query = "";
    private string message = "";
    private string sourceFilter = "";
    private string categoryFilter = "";
    private string mediaTypeFilter = "";
    private string publishingStatusFilter = "";
    private string linkFilter = "";
    private string shelfFilter = "";
    private Severity messageSeverity = Severity.Info;
    private bool isAddCatalogOpen;
    private bool isImportCatalogOpen;
    private bool filtersOpen;
    private CatalogMangaResponse? editingEntry;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await Auth.GetCurrentUserAsync();
        if (!IsAdmin)
        {
            return;
        }

        localSeries = await SeriesApi.GetSeriesAsync();
        await LoadCatalog();
    }

    private async Task LoadCatalog()
    {
        if (!IsAdmin)
        {
            return;
        }

        catalog = await CatalogApi.GetCatalogAsync(query);
        message = "";
        CloseEdit();
    }

    private async Task SearchCatalog()
    {
        catalog = await CatalogApi.GetCatalogAsync(query);
        messageSeverity = FilteredCatalog.Count == 0 ? Severity.Warning : Severity.Success;
        message = FilteredCatalog.Count == 0 ? "No catalog entries matched your search." : $"Found {FilteredCatalog.Count} catalog entries.";
    }

    private void OpenAddCatalog() => isAddCatalogOpen = true;
    private void OpenImportCatalog() => isImportCatalogOpen = true;
    private void OpenFilters() => filtersOpen = true;
    private void CloseFilters() => filtersOpen = false;
    private void OnAddCatalogOpenChanged(bool open) => isAddCatalogOpen = open;
    private void OnImportCatalogOpenChanged(bool open) => isImportCatalogOpen = open;

    private void ToggleSourceFilter(string clickedSource)
    {
        sourceFilter = string.Equals(sourceFilter, clickedSource, StringComparison.OrdinalIgnoreCase) ? "" : clickedSource;
    }

    private async Task ApplyFilters()
    {
        filtersOpen = false;
        await SearchCatalog();
    }

    private async Task ClearFilters()
    {
        query = "";
        sourceFilter = "";
        categoryFilter = "";
        mediaTypeFilter = "";
        publishingStatusFilter = "";
        linkFilter = "";
        shelfFilter = "";
        await LoadCatalog();
        filtersOpen = false;
    }

    private void EditCatalog(CatalogMangaResponse entry)
    {
        editingEntry = entry;
    }

    private void CloseEdit()
    {
        editingEntry = null;
    }

    private async Task OnCatalogSaved(CatalogMangaResponse updated)
    {
        messageSeverity = Severity.Success;
        message = $"Updated catalog metadata for {updated.Title}.";
        await RefreshCatalogEntry(updated);
    }

    private async Task RefreshCatalogEntry(CatalogMangaResponse updated)
    {
        editingEntry = updated;
        var entryIndex = catalog.FindIndex(x => x.Id == updated.Id);
        if (entryIndex >= 0)
        {
            catalog[entryIndex] = updated;
        }
        else
        {
            catalog = await CatalogApi.GetCatalogAsync(query);
        }
    }

    private List<CatalogMangaResponse> FilteredCatalog => string.IsNullOrWhiteSpace(sourceFilter)
        ? catalog.Where(MatchesCategory).Where(MatchesMediaType).Where(MatchesPublishingStatus).Where(MatchesLink).Where(MatchesShelf).ToList()
        : catalog
            .Where(entry => string.Equals(GetSourceLabel(entry), sourceFilter, StringComparison.OrdinalIgnoreCase))
            .Where(MatchesCategory)
            .Where(MatchesMediaType)
            .Where(MatchesPublishingStatus)
            .Where(MatchesLink)
            .Where(MatchesShelf)
            .ToList();

    private List<string> CategoryOptions => catalog
        .Select(entry => entry.Category)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private List<string> MediaTypeOptions => catalog
        .Select(entry => entry.MediaType)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private List<string> PublishingStatusOptions => catalog
        .Select(entry => entry.PublishingStatus)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private string FilterButtonLabel => ActiveFilterCount == 0 ? "Filters" : $"Filters ({ActiveFilterCount})";

    private int ActiveFilterCount => Count(query) + Count(sourceFilter) + Count(categoryFilter) + Count(mediaTypeFilter) + Count(publishingStatusFilter) + Count(linkFilter) + Count(shelfFilter);

    private bool MatchesCategory(CatalogMangaResponse entry) =>
        string.IsNullOrWhiteSpace(categoryFilter) || string.Equals(entry.Category, categoryFilter, StringComparison.OrdinalIgnoreCase);

    private bool MatchesMediaType(CatalogMangaResponse entry) =>
        string.IsNullOrWhiteSpace(mediaTypeFilter) || string.Equals(entry.MediaType, mediaTypeFilter, StringComparison.OrdinalIgnoreCase);

    private bool MatchesPublishingStatus(CatalogMangaResponse entry) =>
        string.IsNullOrWhiteSpace(publishingStatusFilter) || string.Equals(entry.PublishingStatus, publishingStatusFilter, StringComparison.OrdinalIgnoreCase);

    private bool MatchesLink(CatalogMangaResponse entry) => linkFilter switch
    {
        "mangadex" => !string.IsNullOrWhiteSpace(entry.MangaDexUrl),
        "local" => entry.LocalSeriesId is not null,
        "missing" => entry.LocalSeriesId is null && string.IsNullOrWhiteSpace(entry.MangaDexUrl),
        _ => true
    };

    private bool MatchesShelf(CatalogMangaResponse entry) => shelfFilter switch
    {
        "in" => entry.IsInMyShelf,
        "not-in" => !entry.IsInMyShelf,
        _ => true
    };

    private static int Count(string value) => string.IsNullOrWhiteSpace(value) ? 0 : 1;

    private static string GetSourceLabel(CatalogMangaResponse entry)
    {
        var source = entry.MetadataSource.ToLowerInvariant() switch
        {
            "myanimelist" => "MAL",
            "openlibrary" => "OpenLibrary",
            _ => entry.MetadataSource
        };

        if (!string.IsNullOrWhiteSpace(source))
        {
            return source;
        }

        if (!string.IsNullOrWhiteSpace(entry.MyAnimeListId))
        {
            return "MAL";
        }

        if (!string.IsNullOrWhiteSpace(entry.OpenLibraryKey))
        {
            return "OpenLibrary";
        }

        return "Manual";
    }

}
