@page "/series/{SeriesId:guid}"
@inject SeriesApiService SeriesApi

<PageTitle>Series</PageTitle>

@if (series is null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudStack Spacing="4">
        <MudStack Spacing="1" Class="mh-page-title">
            <MudText Typo="Typo.overline" Color="Color.Secondary">@series.Source</MudText>
            <MudText Typo="Typo.h1">@series.Title</MudText>
        </MudStack>

        <MudPaper Elevation="0" Outlined="true">
            <MudList T="ChapterResponse">
                @foreach (var chapter in chapters)
                {
                    <MudListItem Href="@($"/reader/{chapter.Id}/{chapter.PageCount}")" Icon="@Icons.Material.Filled.MenuBook">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="w-100">
                            <MudText>@chapter.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@chapter.PageCount pages</MudText>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudStack>
}

@code {
    [Parameter] public Guid SeriesId { get; set; }
    private SeriesResponse? series;
    private List<ChapterResponse> chapters = [];

    protected override async Task OnParametersSetAsync()
    {
        series = await SeriesApi.GetSeriesAsync(SeriesId);
        chapters = await SeriesApi.GetChaptersAsync(SeriesId);
    }
}
