@page "/bento-preview"
@inject NavigationManager Navigation

<PageTitle>Bento Preview</PageTitle>

<MudStack Spacing="3" Class="mh-bento-preview">
    <section class="mh-bento-preview-hero">
        <MudStack Spacing="2">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Design branch preview</MudText>
            <MudText Typo="Typo.h1">MangaHub dashboard concept</MudText>
            <MudText Typo="Typo.body1" Class="mh-bento-preview-copy">
                A homepage direction using a MangaHub design wrapper over BlazzyMotion Bento, with tighter spacing and the site palette baked in.
            </MudText>
        </MudStack>

        <MudStack Row="true" Spacing="2" Class="flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories" OnClick="@(() => Navigation.NavigateTo("library"))">Shelf</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Inventory2" OnClick="@(() => Navigation.NavigateTo("catalog"))">Catalog</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Home" OnClick="@(() => Navigation.NavigateTo(""))">Current home</MudButton>
        </MudStack>
    </section>

    <MangaBento Class="mh-preview-bento">
        <MangaBentoTile ColSpan="2" RowSpan="2" Scheme="deep" CornerIcon="@Icons.Material.Filled.AutoStories">
            <div class="mh-preview-hero-tile">
                <div>
                    <MudText Typo="Typo.overline">Now reading</MudText>
                    <MudText Typo="Typo.h2">Dandadan</MudText>
                    <MudText Typo="Typo.body2">Chapter 183 of 190 tracked, with MangaDex and local fallback ready.</MudText>
                </div>
                <div class="mh-preview-progress">
                    <span>96%</span>
                    <div>
                        <strong>7 chapters left</strong>
                        <small>Last update from MAL metadata</small>
                    </div>
                </div>
            </div>
        </MangaBentoTile>

        @foreach (var metric in Metrics)
        {
            <MangaBentoTile Scheme="@metric.Scheme" CornerIcon="@metric.Icon">
                <div class="mh-preview-metric">
                    <MudText Typo="Typo.h2">@metric.Value</MudText>
                    <MudText Typo="Typo.caption">@metric.Label</MudText>
                </div>
            </MangaBentoTile>
        }

        <MangaBentoTile ColSpan="2" Scheme="primary" CornerIcon="@Icons.Material.Filled.UploadFile">
            <div class="mh-preview-row-tile">
                <div>
                    <MudText Typo="Typo.h3">Spreadsheet replacement</MudText>
                    <MudText Typo="Typo.body2">Import old rows, keep chapter, status, score, notes, and then clean metadata over time.</MudText>
                </div>
            </div>
        </MangaBentoTile>

        <MangaBentoTile ColSpan="2" RowSpan="2" Scheme="ink" CornerIcon="@Icons.Material.Filled.Bookmark">
            <MudStack Spacing="2" Class="mh-preview-queue">
                <MudText Typo="Typo.overline">Reading queue</MudText>
                @foreach (var item in Queue)
                {
                    <div class="mh-preview-queue-row">
                        <span>@item.Initial</span>
                        <div>
                            <strong>@item.Title</strong>
                            <small>@item.Status</small>
                        </div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@item.Chapter</MudChip>
                    </div>
                }
            </MudStack>
        </MangaBentoTile>

        <MangaBentoTile Scheme="secondary" CornerIcon="@Icons.Material.Filled.TravelExplore">
            <div class="mh-preview-mini">
                <MudText Typo="Typo.h3">MAL first</MudText>
                <MudText Typo="Typo.caption">Metadata source</MudText>
            </div>
        </MangaBentoTile>

        <MangaBentoTile Scheme="soft" CornerIcon="@Icons.Material.Filled.Storage">
            <div class="mh-preview-mini">
                <MudText Typo="Typo.h3">Local files</MudText>
                <MudText Typo="Typo.caption">Reader fallback</MudText>
            </div>
        </MangaBentoTile>

        <MangaBentoTile ColSpan="2" Scheme="warm" CornerIcon="@Icons.Material.Filled.AdminPanelSettings">
            <div class="mh-preview-row-tile">
                <div>
                    <MudText Typo="Typo.h3">Catalog stays controlled</MudText>
                    <MudText Typo="Typo.body2">Admins curate shared manga entries. Users add existing catalog manga to their shelf.</MudText>
                </div>
            </div>
        </MangaBentoTile>
    </MangaBento>

    <MudStack Spacing="1" Class="mh-preview-section-title">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Card concepts</MudText>
        <MudText Typo="Typo.h2">Shelf and catalog samples</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            These are not wired to real data yet. They show how dense MangaHub bento cards could replace the current horizontal cards.
        </MudText>
    </MudStack>

    <section class="mh-preview-card-shell">
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Shelf card</MudText>
            <MudText Typo="Typo.h3">Personal reading state + metadata</MudText>
        </MudStack>

        <MangaBento Columns="4" Class="mh-preview-card-bento">
            <MangaBentoTile RowSpan="3" Scheme="deep" Class="mh-preview-cover-tile">
                <div class="mh-preview-cover mh-preview-cover-dandadan">
                    <span>D</span>
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="2" RowSpan="2" Scheme="primary" CornerIcon="@Icons.Material.Filled.AutoStories">
                <div class="mh-preview-card-main">
                    <div>
                        <MudStack Row="true" Spacing="1" Class="flex-wrap">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">Reading</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">MAL</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Supernatural</MudChip>
                        </MudStack>
                        <MudText Typo="Typo.h2">Dandadan</MudText>
                        <MudText Typo="Typo.body2">Yukinobu Tatsu</MudText>
                    </div>
                    <MudText Typo="Typo.body2">
                        Chaotic occult action with aliens, ghosts, romance, and a very loud reading rhythm.
                    </MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile Scheme="warm" CornerIcon="@Icons.Material.Filled.Bookmark">
                <div class="mh-preview-stat">
                    <MudText Typo="Typo.overline">Current</MudText>
                    <MudText Typo="Typo.h2">183</MudText>
                    <MudText Typo="Typo.caption">of 190 chapters</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile Scheme="secondary" CornerIcon="@Icons.Material.Filled.Star">
                <div class="mh-preview-stat">
                    <MudText Typo="Typo.overline">Score</MudText>
                    <MudText Typo="Typo.h2">4/5</MudText>
                    <MudText Typo="Typo.caption">Personal rating</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile Scheme="soft" CornerIcon="@Icons.Material.Filled.Category">
                <div class="mh-preview-stat">
                    <MudText Typo="Typo.overline">Format</MudText>
                    <MudText Typo="Typo.h3">Manga</MudText>
                    <MudText Typo="Typo.caption">Supernatural</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile Scheme="ink" CornerIcon="@Icons.Material.Filled.Link">
                <div class="mh-preview-stat">
                    <MudText Typo="Typo.overline">Read from</MudText>
                    <MudText Typo="Typo.h3">2 sources</MudText>
                    <MudText Typo="Typo.caption">MangaDex + local</MudText>
                </div>
            </MangaBentoTile>
        </MangaBento>

        <div class="mh-preview-card-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories">Read</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit">Edit shelf</MudButton>
        </div>
    </section>

    <section class="mh-preview-card-shell">
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Catalog card</MudText>
            <MudText Typo="Typo.h3">Shared manga metadata + source health</MudText>
        </MudStack>

        <MangaBento Columns="4" Class="mh-preview-card-bento">
            <MangaBentoTile RowSpan="3" Scheme="ink" Class="mh-preview-cover-tile">
                <div class="mh-preview-cover mh-preview-cover-berserk">
                    <span>B</span>
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="2" RowSpan="2" Scheme="soft" CornerIcon="@Icons.Material.Filled.Inventory2">
                <div class="mh-preview-card-main">
                    <div>
                        <MudStack Row="true" Spacing="1" Class="flex-wrap">
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">MAL</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Seinen</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Publishing</MudChip>
                        </MudStack>
                        <MudText Typo="Typo.h2">Berserk</MudText>
                        <MudText Typo="Typo.body2">Kentaro Miura</MudText>
                    </div>
                    <MudText Typo="Typo.body2">
                        Catalog entry stores cover, category, chapter count, source IDs, MangaDex link, and local binding.
                    </MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile Scheme="primary" CornerIcon="@Icons.Material.Filled.FormatListNumbered">
                <div class="mh-preview-stat">
                    <MudText Typo="Typo.overline">Chapters</MudText>
                    <MudText Typo="Typo.h2">376</MudText>
                    <MudText Typo="Typo.caption">from metadata</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile Scheme="secondary" CornerIcon="@Icons.Material.Filled.Link">
                <div class="mh-preview-stat">
                    <MudText Typo="Typo.overline">Sources</MudText>
                    <MudText Typo="Typo.h3">2 ready</MudText>
                    <MudText Typo="Typo.caption">MangaDex + local</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile Scheme="deep" CornerIcon="@Icons.Material.Filled.CalendarMonth">
                <div class="mh-preview-stat">
                    <MudText Typo="Typo.overline">First year</MudText>
                    <MudText Typo="Typo.h2">1989</MudText>
                    <MudText Typo="Typo.caption">Catalog fact</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile Scheme="warm" CornerIcon="@Icons.Material.Filled.CheckCircle">
                <div class="mh-preview-stat">
                    <MudText Typo="Typo.overline">Shelf</MudText>
                    <MudText Typo="Typo.h3">Not added</MudText>
                    <MudText Typo="Typo.caption">Available</MudText>
                </div>
            </MangaBentoTile>
        </MangaBento>

        <div class="mh-preview-card-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit metadata</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PlaylistAdd">Add to shelf</MudButton>
        </div>
    </section>
</MudStack>

@code {
    private sealed record PreviewMetric(string Value, string Label, string Icon, string Scheme);
    private sealed record QueueItem(string Initial, string Title, string Status, string Chapter);

    private static readonly List<PreviewMetric> Metrics =
    [
        new("153", "Shelf entries", Icons.Material.Filled.AutoStories, "secondary"),
        new("42", "Finished manga", Icons.Material.Filled.CheckCircle, "soft"),
        new("18", "Reading now", Icons.Material.Filled.Bookmark, "warm"),
        new("9", "Needs metadata", Icons.Material.Filled.Troubleshoot, "primary")
    ];

    private static readonly List<QueueItem> Queue =
    [
        new("B", "Berserk", "Paused, local files ready", "Ch. 376"),
        new("C", "Chainsaw Man", "Reading from MangaDex", "Ch. 207"),
        new("O", "One Piece", "Long-form backlog", "Ch. 1118")
    ];
}
