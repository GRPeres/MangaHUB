@page "/library"
@using MangaHub.Web.API.Services
@inject AuthSessionService Auth
@inject NavigationManager Navigation
@inject AdminApiService AdminApi
@inject MangaApiService MangaApi
@inject ShelfApiService ShelfApi
@inject OpenLibraryApiService OpenLibraryApi
@inject CatalogApiService CatalogApi

<PageTitle>Shelf</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mh-page-title">
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Personal tracker</MudText>
            <MudText Typo="Typo.h1">Shelf</MudText>
        </MudStack>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">Refresh</MudButton>
    </MudStack>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
            <MudSelect T="string" @bind-Value="status" Label="Status" Variant="Variant.Outlined" Dense="true" Class="mh-filter">
                <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("reading")">Reading</MudSelectItem>
                <MudSelectItem T="string" Value="@("done")">Done</MudSelectItem>
                <MudSelectItem T="string" Value="@("paused")">Paused</MudSelectItem>
                <MudSelectItem T="string" Value="@("planned")">Planned</MudSelectItem>
                <MudSelectItem T="string" Value="@("dropped")">Dropped</MudSelectItem>
            </MudSelect>
            @if (IsAdmin)
            {
                <MudSelect T="Guid?" @bind-Value="selectedUserId" Label="Shelf owner" Variant="Variant.Outlined" Dense="true" Class="mh-filter">
                    @foreach (var user in users)
                    {
                        <MudSelectItem T="Guid?" Value="@user.Id">@user.Username (@user.Role)</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Load">Apply</MudButton>
        </MudStack>
    </MudPaper>

    @if (entries.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Your shelf is empty for this filter.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var item in entries)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="0" Outlined="true" Class="mh-card">
                        @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                        {
                            <MudImage Src="@item.CoverUrl" Alt="@($"{item.Title} cover")" Class="mh-cover" />
                        }
                        <MudCardContent>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@item.ReadingStatus</MudChip>
                                @if (item.Score is not null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">@($"{item.Score}/5")</MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.h3" Class="mt-2">@item.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Authors</MudText>
                            <MudStack Row="true" Spacing="1" Class="mt-3 flex-wrap">
                                @if (!string.IsNullOrWhiteSpace(item.CurrentChapter))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Ch. @item.CurrentChapter</MudChip>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Category))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@item.Category</MudChip>
                                }
                            </MudStack>
                            @if (!string.IsNullOrWhiteSpace(item.Summary))
                            {
                                <MudText Typo="Typo.body2" Class="mt-3">@item.Summary</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@item.Notes</MudText>
                            }
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Read(item.Id)">Read</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => Edit(item)">Edit</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="@messageSeverity" Variant="Variant.Outlined">@message</MudAlert>
    }
</MudStack>

@if (isEditDialogOpen && editingEntry is not null)
{
    <div class="mh-modal-backdrop" @onclick="CancelEdit">
        <section class="mh-modal" role="dialog" aria-modal="true" aria-labelledby="shelf-edit-title" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mh-modal-header">
                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start" Class="mh-selected-manga">
                        @if (!string.IsNullOrWhiteSpace(editingEntry.CoverUrl))
                        {
                            <MudImage Src="@editingEntry.CoverUrl" Alt="@($"{editingEntry.Title} cover")" Class="mh-modal-cover" />
                        }
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">Editing shelf entry</MudText>
                            <MudText id="shelf-edit-title" Typo="Typo.h2">@editingEntry.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@editingEntry.Authors</MudText>
                            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@editingEntry.ReadingStatus</MudChip>
                                @if (!string.IsNullOrWhiteSpace(editingEntry.CurrentChapter))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Ch. @editingEntry.CurrentChapter</MudChip>
                                }
                                @if (editingEntry.Score is not null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@($"{editingEntry.Score}/5")</MudChip>
                                }
                            </MudStack>
                        </MudStack>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="CancelEdit" aria-label="Close editor" />
                </MudStack>

                <MudDivider />

                <MudGrid Spacing="3">
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" @bind-Value="editStatus" Label="Status" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("reading")">Reading</MudSelectItem>
                            <MudSelectItem T="string" Value="@("done")">Done</MudSelectItem>
                            <MudSelectItem T="string" Value="@("paused")">Paused</MudSelectItem>
                            <MudSelectItem T="string" Value="@("planned")">Planned</MudSelectItem>
                            <MudSelectItem T="string" Value="@("dropped")">Dropped</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="string" @bind-Value="editChapter" Label="Chapter" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudNumericField T="int?" @bind-Value="editScore" Label="Score" Variant="Variant.Outlined" Min="1" Max="5" />
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudTextField T="string" @bind-Value="editCategory" Label="Type / genre" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="editNotes" Label="Notes" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="editSummary" Label="Summary" Variant="Variant.Outlined" Lines="3" />
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveEdit">Save changes</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="RemoveEditingEntry">Remove from shelf</MudButton>
                </MudStack>

                @if (IsAdmin)
                {
                    <MudDivider />
                    <MudStack Spacing="2">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h3">Match catalog metadata</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Use this when an imported CSV title needs the correct OpenLibrary book, cover, category, or summary.</MudText>
                        </MudStack>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="9">
                                <MudTextField T="string" @bind-Value="openLibraryQuery" Label="Search OpenLibrary" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="3" Class="d-flex align-center">
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ManageSearch" FullWidth="true" Disabled="@isSearchingOpenLibrary" OnClick="SearchOpenLibrary">
                                    @(isSearchingOpenLibrary ? "Searching..." : "Search")
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (!string.IsNullOrWhiteSpace(openLibraryMessage))
                        {
                            <MudAlert Severity="@openLibrarySeverity" Variant="Variant.Outlined">@openLibraryMessage</MudAlert>
                        }

                        <MudGrid Spacing="2">
                            @foreach (var item in openLibraryResults)
                            {
                                <MudItem xs="12" md="6">
                                    <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                                            {
                                                <MudImage Src="@item.CoverUrl" Alt="@($"{item.Title} cover")" Class="mh-match-cover" />
                                            }
                                            <MudStack Spacing="1" Class="flex-grow-1">
                                                <MudText Typo="Typo.h3">@item.Title</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Authors</MudText>
                                                @if (!string.IsNullOrWhiteSpace(item.Category))
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@item.Category</MudChip>
                                                }
                                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="() => ApplyOpenLibraryMetadata(item)">Use metadata</MudButton>
                                            </MudStack>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudStack>
                }
            </MudStack>
        </section>
    </div>
}

@code {
    private List<MangaEntryResponse> entries = [];
    private List<UserAdminResponse> users = [];
    private UserResponse? currentUser;
    private bool IsAdmin => string.Equals(currentUser?.Role, "admin", StringComparison.OrdinalIgnoreCase);
    private Guid? selectedUserId;
    private string status = "";
    private string message = "";
    private Severity messageSeverity = Severity.Warning;
    private MangaEntryResponse? editingEntry;
    private bool isEditDialogOpen;
    private string editStatus = "planned";
    private string editChapter = "";
    private int? editScore;
    private string editCategory = "";
    private string editSummary = "";
    private string editNotes = "";
    private string openLibraryQuery = "";
    private string openLibraryMessage = "";
    private Severity openLibrarySeverity = Severity.Info;
    private bool isSearchingOpenLibrary;
    private List<OpenLibraryResult> openLibraryResults = [];

    protected override async Task OnInitializedAsync()
    {
        currentUser = await Auth.GetCurrentUserAsync();
        if (IsAdmin)
        {
            users = await AdminApi.GetUsersAsync();
            selectedUserId = currentUser?.Id;
        }
        await Load();
    }

    private async Task Load()
    {
        entries = await MangaApi.GetMangaEntriesAsync(status, IsAdmin ? selectedUserId : null);
        CancelEdit();
    }

    private async Task Read(Guid entryId)
    {
        var options = await MangaApi.GetReadOptionsAsync(entryId);
        if (options is null)
        {
            ShowWarning("Could not load read options.");
            return;
        }

        if (options.HasLocal)
        {
            Navigation.NavigateTo(options.LocalReaderUrl);
            return;
        }

        if (options.HasMangaDex)
        {
            Navigation.NavigateTo(options.MangaDexUrl, forceLoad: true);
            return;
        }

        ShowWarning("No MangaDex URL or local series is registered for this manga yet.");
    }

    private void Edit(MangaEntryResponse entry)
    {
        editingEntry = entry;
        editStatus = entry.ReadingStatus;
        editChapter = entry.CurrentChapter;
        editScore = entry.Score;
        editCategory = entry.Category;
        editSummary = entry.Summary;
        editNotes = entry.Notes;
        openLibraryQuery = entry.Title;
        openLibraryResults = [];
        openLibraryMessage = "";
        isEditDialogOpen = true;
    }

    private void CancelEdit()
    {
        editingEntry = null;
        isEditDialogOpen = false;
        openLibraryResults = [];
        openLibraryMessage = "";
    }

    private async Task SaveEdit()
    {
        if (editingEntry is null)
        {
            return;
        }

        var request = new AddToShelfRequest(editingEntry.Id, editStatus, editChapter, editScore, editCategory, editSummary, editNotes);
        var updated = await ShelfApi.UpdateShelfAsync(editingEntry.Id, request, IsAdmin ? selectedUserId : null);
        if (updated is null)
        {
            ShowWarning("Could not save shelf changes.");
            return;
        }

        messageSeverity = Severity.Success;
        message = $"Updated {updated.Title}.";
        await Load();
    }

    private async Task RemoveEditingEntry()
    {
        if (editingEntry is null)
        {
            return;
        }

        var removed = await ShelfApi.RemoveShelfAsync(editingEntry.Id, IsAdmin ? selectedUserId : null);
        if (!removed)
        {
            ShowWarning("Could not remove shelf entry.");
            return;
        }

        messageSeverity = Severity.Success;
        message = $"Removed {editingEntry.Title} from shelf.";
        await Load();
    }

    private void ShowWarning(string text)
    {
        messageSeverity = Severity.Warning;
        message = text;
    }

    private async Task SearchOpenLibrary()
    {
        if (string.IsNullOrWhiteSpace(openLibraryQuery))
        {
            openLibraryResults = [];
            openLibrarySeverity = Severity.Info;
            openLibraryMessage = "Type a title before searching OpenLibrary.";
            return;
        }

        isSearchingOpenLibrary = true;
        try
        {
            openLibraryResults = await OpenLibraryApi.SearchOpenLibraryAsync(openLibraryQuery);
            openLibrarySeverity = openLibraryResults.Count == 0 ? Severity.Warning : Severity.Success;
            openLibraryMessage = openLibraryResults.Count == 0
                ? "OpenLibrary returned no matches."
                : $"Found {openLibraryResults.Count} OpenLibrary matches.";
        }
        catch
        {
            openLibraryResults = [];
            openLibrarySeverity = Severity.Error;
            openLibraryMessage = "OpenLibrary search failed.";
        }
        finally
        {
            isSearchingOpenLibrary = false;
        }
    }

    private async Task ApplyOpenLibraryMetadata(OpenLibraryResult item)
    {
        if (editingEntry is null)
        {
            return;
        }

        var request = new MangaEntryRequest(
            item.Title,
            item.Authors,
            item.Category,
            item.Description,
            item.CoverUrl,
            item.Key,
            item.FirstPublishYear,
            "",
            editingEntry.MangaDexUrl,
            editingEntry.LocalSeriesId,
            "");

        var updated = await CatalogApi.UpdateCatalogMangaAsync(editingEntry.Id, request);
        if (updated is null)
        {
            openLibrarySeverity = Severity.Error;
            openLibraryMessage = "Could not update catalog metadata.";
            return;
        }

        editCategory = FirstNonEmpty(editCategory, updated.Category);
        editSummary = FirstNonEmpty(editSummary, updated.Description);
        editingEntry = editingEntry with
        {
            Title = updated.Title,
            Authors = updated.Authors,
            CatalogCategory = updated.Category,
            Description = updated.Description,
            CoverUrl = updated.CoverUrl,
            OpenLibraryKey = updated.OpenLibraryKey,
            FirstPublishYear = updated.FirstPublishYear,
            MangaDexUrl = updated.MangaDexUrl,
            MangaDexId = updated.MangaDexId,
            LocalSeriesId = updated.LocalSeriesId
        };

        var entryIndex = entries.FindIndex(x => x.Id == editingEntry.Id);
        if (entryIndex >= 0)
        {
            entries[entryIndex] = editingEntry;
        }

        openLibrarySeverity = Severity.Success;
        openLibraryMessage = $"Matched {updated.Title}. Review the shelf fields, then save if needed.";
        messageSeverity = Severity.Success;
        message = $"Updated catalog metadata for {updated.Title}.";
    }

    private static string FirstNonEmpty(params string[] values) =>
        values.Select(x => x.Trim()).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "";
}
