@page "/library"
@inject MangaHub.Web.Services.MangaHubApiClient Api

<PageTitle>Library</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">Local library</p>
        <h1>Library</h1>
    </div>
    <button @onclick="Scan">Scan now</button>
</div>

<section class="series-grid">
    @foreach (var item in series)
    {
        <a class="series-card" href="@($"/series/{item.Id}")">
            <span>@item.Source</span>
            <strong>@item.Title</strong>
            <small>@item.Status</small>
        </a>
    }
</section>

<p class="status">@message</p>

@code {
    private List<SeriesResponse> series = [];
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        series = await Api.GetSeriesAsync();
    }

    private async Task Scan()
    {
        message = "Scanning...";
        var result = await Api.ScanAsync();
        message = result is null ? "Scan failed." : $"Scan completed: {result.SeriesCount} series, {result.ChapterCount} chapters.";
        await Load();
    }
}

