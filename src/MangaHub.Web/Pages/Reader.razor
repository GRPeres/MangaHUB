@page "/reader/{ChapterId:guid}/{PageCount:int}"
@using MangaHub.Web.API.Services
@inject ReadApiService ReadApi
@inject MangaApiService MangaApi
@inject AuthSessionService Auth
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject MessageService Messages
@inject ReaderSettingsService ReaderSettings
@inject UsageApiService UsageApi
@implements IAsyncDisposable

<PageTitle>Reader</PageTitle>

<section class="@(IsVerticalReader ? "reader-workspace reader-workspace-vertical" : "reader-workspace")">
    <div class="reader-top-stack">
        <MudPaper Class="reader-toolbar" Elevation="0" Outlined="true">
            <div class="reader-toolbar-previous">
                <MudTooltip Text="@PreviousLabel">
                    <MudIconButton Icon="@PreviousIcon" Color="Color.Primary" OnClick="Previous" Disabled="@PreviousDisabled" aria-label="@PreviousLabel" />
                </MudTooltip>
            </div>
            <MudText Typo="Typo.body2" Class="reader-page-count">Page @(page + 1) / @PageCount</MudText>
            <div class="reader-toolbar-next">
                <MudTooltip Text="@NextLabel">
                    <MudIconButton Icon="@NextIcon" Color="Color.Primary" OnClick="Next" Disabled="@NextDisabled" aria-label="@NextLabel" />
                </MudTooltip>
            </div>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(readerMessage))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="reader-message">@readerMessage</MudAlert>
        }
    </div>

    <main class="@(IsVerticalReader ? "reader reader-vertical" : "reader")">
        <div class="@PageFrameClass" @ref="pageFrame">
            @if (IsVerticalReader)
            {
                @for (var pageIndex = 0; pageIndex < PageCount; pageIndex++)
                {
                    var currentPageIndex = pageIndex;
                    <img @key="@($"{pageImageVersion}-{pageIndex}")"
                         class="reader-page-image-vertical"
                         data-reader-page="@currentPageIndex"
                         src="@ReadApi.GetPageUrl(ChapterId, currentPageIndex, pageImageVersion)"
                         alt="Manhwa page @(currentPageIndex + 1)"
                         @onload="() => OnVerticalPageLoaded(currentPageIndex)"
                         @onerror="OnPageLoadFailed" />
                }
                <div class="reader-vertical-end" @ref="verticalEnd" aria-hidden="true"></div>
            }
            else
            {
                @if (isPageLoading && !string.IsNullOrWhiteSpace(loadingPreviewUrl))
                {
                    <img class="reader-page-loading-preview"
                         src="@loadingPreviewUrl"
                         alt=""
                         aria-hidden="true" />
                }
                <img @key="pageImageVersion"
                     class="reader-page-image"
                     @ref="pageImage"
                     src="@ReadApi.GetPageUrl(ChapterId, page, pageImageVersion)"
                     alt="Manga page @(page + 1)"
                     @onload="OnPageLoaded"
                     @onerror="OnPageLoadFailed" />
                <button type="button"
                        class="reader-page-hit-area reader-page-hit-area-previous"
                        aria-label="Previous page"
                        title="Previous page"
                        @onclick="Previous"
                        disabled="@PreviousDisabled">
                    <MudIcon Icon="@PreviousIcon" aria-hidden="true" />
                </button>
                <button type="button"
                        class="reader-page-hit-area reader-page-hit-area-next"
                        aria-label="@NextLabel"
                        title="@NextLabel"
                        @onclick="Next"
                        disabled="@NextDisabled">
                    <MudIcon Icon="@NextIcon" aria-hidden="true" />
                </button>
            }
        </div>
    </main>

    <MudPaper Class="reader-toolbar reader-chapter-toolbar" Elevation="0" Outlined="true">
        <div class="reader-toolbar-previous">
            <MudTooltip Text="Back to shelf">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Secondary" OnClick="BackToShelf" aria-label="Back to shelf" />
            </MudTooltip>
        </div>
        <MudText Typo="Typo.body2" Class="reader-chapter-label">@ChapterLabel</MudText>
        <div class="reader-toolbar-next">
            <MudMenu Icon="@Icons.Material.Filled.Settings"
                     Color="Color.Primary"
                     AnchorOrigin="Origin.TopRight"
                     TransformOrigin="Origin.BottomRight"
                     aria-label="Reader settings">
                <section class="reader-settings-menu">
                    <MudText Typo="Typo.subtitle2">Reader settings</MudText>
                    @if (availableLanguages.Count > 1)
                    {
                        <MudSelect T="string" Value="@ActiveLanguage" ValueChanged="SwitchLanguage" Dense="true" Label="Chapter language" Variant="Variant.Outlined">
                            @foreach (var language in availableLanguages)
                            {
                                <MudSelectItem T="string" Value="@language">@LanguageLabel(language)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">Chapter language: @LanguageLabel(ActiveLanguage)</MudText>
                    }
                    <MudSelect T="int" Value="@readerSettings.PreloadPageCount" ValueChanged="SetPreloadPageCountAsync" Dense="true" Label="Page preload" Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="0">Off</MudSelectItem>
                        <MudSelectItem T="int" Value="1">Low (1 page)</MudSelectItem>
                        <MudSelectItem T="int" Value="3">Balanced (3 pages)</MudSelectItem>
                        <MudSelectItem T="int" Value="5">High (5 pages)</MudSelectItem>
                    </MudSelect>
                </section>
            </MudMenu>
        </div>
    </MudPaper>
</section>

<ReaderPreparingOverlay Open="@(isPreparingChapter || isSeriesComplete)"
                         Title="@(isSeriesComplete ? "You're done reading" : "Preparing chapter")"
                         Stage="@(isSeriesComplete ? "You've read every available chapter in this completed manga. It is now marked done on your shelf." : PreparingStage)"
                         Progress="@(readerPreparation?.Progress ?? 0)"
                         CompletedPages="@(readerPreparation?.CompletedPages ?? 0)"
                         TotalPages="@(readerPreparation?.TotalPages ?? 0)"
                         IsTerminal="@isSeriesComplete"
                         TerminalActionLabel="Back to shelf"
                         OnTerminalAction="BackToShelf" />

<ChapterJumpWarningModal Open="@(chapterJumpNext is not null && chapterJump is not null)"
                         CurrentChapter="@(chapterJump?.CurrentChapter ?? "")"
                         NextChapter="@(chapterJump?.NextChapter ?? "")"
                         Language="@LanguageLabel(chapterJump?.Language ?? "")"
                         AlternativeLanguages="@(chapterJump?.AlternativeLanguages ?? [])"
                         OnCancel="CancelChapterJump"
                         OnConfirm="ConfirmChapterJump"
                         OnReadAlternative="ReadChapterJumpAlternative" />

@if (languageFallbackNext is not null && fallbackLanguages.Count > 0)
{
    <div class="mh-modal-backdrop mh-reader-dialog-backdrop">
        <section class="mh-modal mh-reader-dialog" role="dialog" aria-modal="true" aria-labelledby="reader-language-fallback-title">
            <MudStack Spacing="3">
                <MudText id="reader-language-fallback-title" Typo="Typo.h2">Chapter available in another language</MudText>
                <MudText Typo="Typo.body1">There is no matching @LanguageLabel(ActiveLanguage) chapter in this direction, but MangaDex has one in another language.</MudText>
                <MudSelect T="string" @bind-Value="fallbackLanguage" Label="Continue in" Variant="Variant.Outlined">
                    @foreach (var language in fallbackLanguages)
                    {
                        <MudSelectItem T="string" Value="@language">@LanguageLabel(language)</MudSelectItem>
                    }
                </MudSelect>
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelLanguageFallback">Stay on this chapter</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ContinueInFallbackLanguage">Continue reading</MudButton>
                </MudStack>
            </MudStack>
        </section>
    </div>
}

@code {
    [Parameter] public Guid ChapterId { get; set; }
    [Parameter] public int PageCount { get; set; }
    [SupplyParameterFromQuery] public Guid? EntryId { get; set; }
    [SupplyParameterFromQuery(Name = "chapter")] public string? CurrentChapter { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? ReaderSource { get; set; }
    [SupplyParameterFromQuery(Name = "language")] public string? ReaderLanguage { get; set; }
    [SupplyParameterFromQuery(Name = "vertical")] public bool IsVerticalReader { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? InitialPage { get; set; }
    private int page;
    private Guid loadedChapterId;
    private Guid prefetchedChapterId;
    private Guid markedReadChapterId;
    private bool isPreparingChapter;
    private bool isSeriesComplete;
    private bool isPageLoading;
    private bool scrollToInitialPage;
    private ElementReference pageFrame;
    private ElementReference pageImage;
    private ElementReference verticalEnd;
    private DotNetObjectReference<Reader>? verticalReaderReference;
    private Guid verticalObservedChapterId;
    private string pageImageVersion = Guid.NewGuid().ToString("N");
    private string? loadingPreviewUrl;
    private ReaderPreparationStatus? readerPreparation;
    private Guid? loadedLanguageEntryId;
    private List<string> availableLanguages = [];
    private bool? languageFallbackNext;
    private List<string> fallbackLanguages = [];
    private string fallbackLanguage = "";
    private string preferredLanguage = "en";
    private ReaderSettings readerSettings = new();
    private bool? chapterJumpNext;
    private ReaderChapterJump? chapterJump;
    private string PreparingStage => readerPreparation?.Stage ?? "Waiting to prepare the chapter";
    private string readerMessage = "";
    private readonly string usageSessionId = Guid.NewGuid().ToString("N");
    private readonly DateTimeOffset usageSessionStartedAt = DateTimeOffset.UtcNow;
    private string NextLabel => page < PageCount - 1 ? "Next" : EntryId is null ? "Next" : "Next chapter";
    private string NextIcon => page < PageCount - 1 ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.SkipNext;
    private string PreviousLabel => page > 0 ? "Previous" : EntryId is null ? "Previous" : "Previous chapter";
    private string PreviousIcon => page > 0 ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.SkipPrevious;
    private string PageFrameClass => isPageLoading && !IsVerticalReader
        ? "reader-page-frame is-page-loading"
        : "reader-page-frame";
    private bool IsMangaDexReader => string.Equals(ReaderSource, "mangadex", StringComparison.OrdinalIgnoreCase)
        || (string.IsNullOrWhiteSpace(ReaderSource) && EntryId is not null);
    private bool CanPrepareAdjacentChapter => IsMangaDexReader && EntryId is not null;
    private string ActiveLanguage => string.IsNullOrWhiteSpace(ReaderLanguage) ? readerSettings.PreferredLanguage : ReaderLanguage;
    private bool PreviousDisabled => isPreparingChapter || (page <= 0 && !CanPrepareAdjacentChapter);
    private bool NextDisabled => isPreparingChapter || (page >= PageCount - 1 && !CanPrepareAdjacentChapter);
    private string ChapterLabel => string.IsNullOrWhiteSpace(CurrentChapter) ? "Chapter" : $"Chapter {CurrentChapter}";

    protected override void OnParametersSet()
    {
        if (loadedChapterId != ChapterId)
        {
            loadedChapterId = ChapterId;
            page = Math.Clamp(InitialPage ?? 0, 0, Math.Max(PageCount - 1, 0));
            scrollToInitialPage = IsVerticalReader && page > 0;
            isPageLoading = false;
            loadingPreviewUrl = null;
            readerMessage = "";
            isPreparingChapter = false;
            isSeriesComplete = false;
            readerPreparation = null;
            pageImageVersion = Guid.NewGuid().ToString("N");
            markedReadChapterId = Guid.Empty;
            verticalObservedChapterId = Guid.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        preferredLanguage = (await Auth.GetCurrentUserAsync())?.PreferredLanguage ?? "en";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var storedSettings = await ReaderSettings.GetAsync();
            readerSettings = storedSettings is null
                ? new ReaderSettings(preferredLanguage)
                : MangaHub.Web.Services.ReaderSettings.Normalize(storedSettings);
            await InvokeAsync(StateHasChanged);
        }

        if (scrollToInitialPage)
        {
            scrollToInitialPage = false;
            await JS.InvokeVoidAsync("mangaHubReader.scrollVerticalPage", pageFrame, page);
        }

        if (IsMangaDexReader && EntryId is not null && loadedLanguageEntryId != EntryId)
        {
            loadedLanguageEntryId = EntryId;
            availableLanguages = (await MangaApi.GetMangaDexLanguagesAsync(EntryId.Value))?.Languages ?? [];
            await InvokeAsync(StateHasChanged);
        }

        if (!CanPrepareAdjacentChapter || EntryId is null || prefetchedChapterId == ChapterId)
        {
            return;
        }

        prefetchedChapterId = ChapterId;
        try
        {
            await MangaApi.PrefetchNextMangaDexChapterAsync(EntryId.Value, ChapterId, ActiveLanguage);
        }
        catch (HttpRequestException)
        {
            // The reader stays usable; moving to the next chapter will retry the normal preparation path.
        }
    }

    private async Task Previous()
    {
        if (page > 0)
        {
            BeginPageTransition(page);
            page--;
            if (IsVerticalReader)
            {
                await JS.InvokeVoidAsync("mangaHubReader.scrollVerticalPage", pageFrame, page);
            }
            return;
        }

        await PrepareAdjacentChapterAsync(next: false);
    }

    private void BackToShelf() => Navigation.NavigateTo("/library");

    private async Task SwitchLanguage(string language)
    {
        if (!CanPrepareAdjacentChapter || EntryId is null || string.Equals(language, ActiveLanguage, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        readerSettings = readerSettings with { PreferredLanguage = language };
        await ReaderSettings.SetAsync(readerSettings);
        isPreparingChapter = true;
        try
        {
            readerPreparation = await MangaApi.StartMangaDexPreparationAsync(EntryId.Value, language: language, allowLanguageFallback: true);
            var completed = readerPreparation is null ? null : await WaitForReaderPreparationAsync(readerPreparation.JobId);
            if (completed?.Launch is not null)
            {
                Navigation.NavigateTo(completed.Launch.ReaderUrl);
                return;
            }

            Messages.Error(completed?.Error ?? "That language does not have a readable version of this chapter.", "Chapter unavailable");
        }
        finally
        {
            isPreparingChapter = false;
            readerPreparation = null;
        }
    }

    private static string LanguageLabel(string code) => code.ToLowerInvariant() switch
    {
        "en" => "English", "pt-br" => "Portuguese (Brazil)", "pt" => "Portuguese", "es" => "Spanish",
        "fr" => "French", "de" => "German", "it" => "Italian", "ja" => "Japanese", "ko" => "Korean",
        _ => code
    };

    private async Task Next()
    {
        if (page < PageCount - 1)
        {
            BeginPageTransition(page);
            page++;
            if (IsVerticalReader)
            {
                await JS.InvokeVoidAsync("mangaHubReader.scrollVerticalPage", pageFrame, page);
            }
            return;
        }

        await PrepareAdjacentChapterAsync(next: true);
    }

    private async Task PrepareAdjacentChapterAsync(bool next, string? language = null, bool allowLanguageFallback = false, bool allowChapterJump = false)
    {
        if (!CanPrepareAdjacentChapter || EntryId is null)
        {
            return;
        }

        isPreparingChapter = true;
        readerMessage = "";
        await InvokeAsync(StateHasChanged);
        try
        {
            readerPreparation = await MangaApi.StartMangaDexPreparationAsync(
                EntryId.Value,
                afterCachedChapterId: next ? ChapterId : null,
                beforeCachedChapterId: next ? null : ChapterId,
                language: language ?? ActiveLanguage,
                allowLanguageFallback: allowLanguageFallback,
                allowChapterJump: allowChapterJump);
            if (readerPreparation is null)
            {
                readerMessage = "Could not start MangaDex chapter preparation.";
                return;
            }

            var completedPreparation = await WaitForReaderPreparationAsync(readerPreparation.JobId);
            if (completedPreparation?.Launch is null)
            {
                if (completedPreparation?.ChapterJump is not null)
                {
                    chapterJumpNext = next;
                    chapterJump = completedPreparation.ChapterJump;
                    return;
                }
                if (completedPreparation?.AvailableLanguages is { Count: > 0 })
                {
                    languageFallbackNext = next;
                    fallbackLanguages = completedPreparation.AvailableLanguages;
                    fallbackLanguage = fallbackLanguages[0];
                    return;
                }

                if (next && completedPreparation?.IsSeriesComplete == true)
                {
                    isSeriesComplete = true;
                    return;
                }

                if (next && IsNoLaterChapter(completedPreparation))
                {
                    Messages.Warning("You've read all available chapters.", "All caught up");
                    Navigation.NavigateTo("/library");
                    return;
                }

                Messages.Error(
                    completedPreparation?.Error ?? (next
                        ? "No later readable MangaDex chapter is available yet."
                        : "No earlier readable MangaDex chapter is available."),
                    "Chapter unavailable");
                return;
            }

            Navigation.NavigateTo(next
                ? completedPreparation.Launch.ReaderUrl
                : OpenAtLastPage(completedPreparation.Launch));
        }
        finally
        {
            isPreparingChapter = false;
            readerPreparation = null;
        }
    }

    private void CancelLanguageFallback()
    {
        languageFallbackNext = null;
        fallbackLanguages = [];
        fallbackLanguage = "";
    }

    private async Task ContinueInFallbackLanguage()
    {
        if (languageFallbackNext is not { } next || string.IsNullOrWhiteSpace(fallbackLanguage))
        {
            return;
        }

        var language = fallbackLanguage;
        CancelLanguageFallback();
        await PrepareAdjacentChapterAsync(next, language, allowLanguageFallback: true);
    }

    private void CancelChapterJump()
    {
        chapterJumpNext = null;
        chapterJump = null;
    }

    private async Task ConfirmChapterJump()
    {
        if (chapterJumpNext is not { } next || chapterJump is null)
        {
            return;
        }

        var language = chapterJump.Language;
        CancelChapterJump();
        await PrepareAdjacentChapterAsync(next, language, allowLanguageFallback: true, allowChapterJump: true);
    }

    private async Task ReadChapterJumpAlternative(string language)
    {
        if (chapterJumpNext is not { } next || string.IsNullOrWhiteSpace(language))
        {
            return;
        }

        CancelChapterJump();
        await PrepareAdjacentChapterAsync(next, language);
    }

    private async Task<ReaderPreparationStatus?> WaitForReaderPreparationAsync(Guid jobId)
    {
        while (true)
        {
            await Task.Delay(350);
            var preparation = await MangaApi.GetMangaDexPreparationAsync(jobId);
            if (preparation is null)
            {
                return null;
            }

            readerPreparation = preparation;
            await InvokeAsync(StateHasChanged);
            if (preparation.IsComplete)
            {
                return preparation;
            }
        }
    }

    private static bool IsNoLaterChapter(ReaderPreparationStatus? preparation) =>
        string.Equals(preparation?.Error, "No later readable MangaDex chapter is available.", StringComparison.Ordinal);

    private void OnPageLoadFailed()
    {
        isPageLoading = true;
        readerMessage = "This reader page could not be loaded. Try opening the chapter again to refresh its local cache.";
    }

    private static string OpenAtLastPage(ReaderLaunchResponse launch) =>
        $"{launch.ReaderUrl}&page={Math.Max(launch.PageCount - 1, 0)}";

    private async Task OnPageLoaded()
    {
        isPageLoading = false;
        loadingPreviewUrl = null;
        ClearReaderMessage();
        if (IsVerticalReader)
        {
            return;
        }

        await JS.InvokeVoidAsync("mangaHubReader.fitPage", pageFrame, pageImage);
        await PreloadFollowingPagesAsync();
        await MarkCurrentChapterReadIfNeededAsync();
    }

    private async Task PreloadFollowingPagesAsync()
    {
        var followingPages = Enumerable.Range(page + 1, Math.Min(readerSettings.PreloadPageCount, PageCount - page - 1))
            .Select(pageIndex => ReadApi.GetPageUrl(ChapterId, pageIndex, pageImageVersion))
            .ToArray();

        if (followingPages.Length > 0)
        {
            await JS.InvokeVoidAsync("mangaHubReader.preloadPages", followingPages);
        }
    }

    private async Task SetPreloadPageCountAsync(int pageCount)
    {
        readerSettings = readerSettings with { PreloadPageCount = pageCount };
        readerSettings = MangaHub.Web.Services.ReaderSettings.Normalize(readerSettings);
        await ReaderSettings.SetAsync(readerSettings);
        await PreloadFollowingPagesAsync();
    }

    private async Task OnVerticalPageLoaded(int pageIndex)
    {
        if (pageIndex == page)
        {
            ClearReaderMessage();
        }
        await ObserveVerticalEnd(pageIndex);
    }

    private async Task ObserveVerticalEnd(int pageIndex)
    {
        if (pageIndex != PageCount - 1 || verticalObservedChapterId == ChapterId)
        {
            return;
        }

        verticalObservedChapterId = ChapterId;
        verticalReaderReference?.Dispose();
        verticalReaderReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("mangaHubReader.observeVerticalEnd", pageFrame, verticalEnd, verticalReaderReference);
    }

    [JSInvokable]
    public Task SetVerticalPage(int pageIndex)
    {
        if (pageIndex < 0 || pageIndex >= PageCount || pageIndex == page)
        {
            return Task.CompletedTask;
        }

        page = pageIndex;
        ClearReaderMessage();
        return InvokeAsync(StateHasChanged);
    }

    private void ClearReaderMessage() => readerMessage = "";

    private void BeginPageTransition(int outgoingPage)
    {
        if (!IsVerticalReader)
        {
            loadingPreviewUrl = ReadApi.GetPageUrl(ChapterId, outgoingPage, pageImageVersion);
            isPageLoading = true;
        }
        ClearReaderMessage();
    }

    [JSInvokable]
    public async Task MarkVerticalChapterRead() => await MarkCurrentChapterReadIfNeededAsync();

    private async Task MarkCurrentChapterReadIfNeededAsync()
    {
        if (EntryId is null || (!IsVerticalReader && page != PageCount - 1) || markedReadChapterId == ChapterId)
        {
            return;
        }

        markedReadChapterId = ChapterId;
        try
        {
            if (!await MangaApi.MarkCurrentChapterReadAsync(EntryId.Value, ChapterId))
            {
                markedReadChapterId = Guid.Empty;
            }
        }
        catch (HttpRequestException)
        {
            markedReadChapterId = Guid.Empty;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (EntryId is not null)
        {
            var seconds = (int)Math.Min((DateTimeOffset.UtcNow - usageSessionStartedAt).TotalSeconds, 3600);
            if (seconds >= 15)
            {
                try { await UsageApi.TrackAsync(new("reader.session", EntryId, ChapterId, usageSessionId, $"reader-session:{usageSessionId}", seconds)); }
                catch (HttpRequestException) { }
            }
        }
        try
        {
            await JS.InvokeVoidAsync("mangaHubReader.disposePage", pageFrame);
        }
        catch (JSException)
        {
        }
        verticalReaderReference?.Dispose();
    }
}
