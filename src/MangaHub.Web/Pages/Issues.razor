@page "/issues"
@page "/admin/issues"
@implements IDisposable
@using MangaHub.Web.API.DTOs
@using MangaHub.Web.API.Services
@inject AuthSessionService Auth
@inject AdminApiService AdminApi
@inject MetadataApiService MetadataApi
@inject MessageService Messages

<PageTitle>Issues</PageTitle>

@if (user is null)
{
    <MudAlert Severity="Severity.Warning">Sign in to view issues.</MudAlert>
}
else if (!isAdmin)
{
    <MudAlert Severity="Severity.Error">Admin permissions are required.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <AdminSectionNav />
        @if (!canManage)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Test accounts can inspect issues and repairs, but cannot change shared catalog or issue data.</MudAlert>
        }
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <div class="mh-issues-overview">
                <div class="mh-issues-title">
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Admin maintenance</MudText>
                        <MudText Typo="Typo.h4">Issues</MudText>
                    </div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        @if (canManage)
                        {
                            <MudTooltip Text="@DraftActionLabel">
                                <span class="mh-proposal-indicator">
                                <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary"
                                               Disabled="@(checkedIssues.Count > 0 && !ProposalCandidates.Any())"
                                               OnClick="OpenProposalScheduleAsync" aria-label="@DraftActionLabel" />
                                <span class="@(chatGptStatus?.LastVerifiedAt is not null ? "mh-proposal-dot verified" : "mh-proposal-dot")" aria-hidden="true"></span>
                                </span>
                            </MudTooltip>
                        }
                        <MudTooltip Text="Refresh issues">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" aria-label="Refresh issues" />
                        </MudTooltip>
                    </MudStack>
                </div>
                <div class="mh-issues-controls">
                    <div class="mh-issues-filter">
                        <MudSelect T="string" Value="@status" ValueChanged="ChangeStatusAsync" Label="Issue view"
                                   Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@("action")">Fix now</MudSelectItem>
                            <MudSelectItem T="string" Value="@("review")">Review later</MudSelectItem>
                            <MudSelectItem T="string" Value="@("history")">History</MudSelectItem>
                        </MudSelect>
                    </div>
                    @if (health is { } summary)
                    {
                        <dl class="mh-issues-health">
                            <div><dt>Needs action</dt><dd>@summary.Actionable</dd></div>
                            <div><dt>In review</dt><dd>@summary.InReview</dd></div>
                            <div><dt>Auto-resolved · 7 days</dt><dd>@summary.AutoResolvedLastSevenDays</dd></div>
                            <div><dt>Oldest open</dt><dd>@(summary.OldestOpenAt?.ToLocalTime().ToString("MMM d") ?? "None")</dd></div>
                        </dl>
                    }
                </div>
            </div>
        </MudPaper>
        @if (canManage && checkedIssues.Count > 0)
        {
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                <MudText>@checkedIssues.Count selected</MudText>
                <MudSelect T="int" @bind-Value="snoozeDays" Dense="true" Label="Snooze duration">
                    <MudSelectItem T="int" Value="7">7 days</MudSelectItem>
                    <MudSelectItem T="int" Value="30">30 days</MudSelectItem>
                    <MudSelectItem T="int" Value="90">90 days</MudSelectItem>
                </MudSelect>
                <MudButton Disabled="@saving" OnClick="() => ReviewBatchAsync(false)">Snooze</MudButton>
                <MudButton Disabled="@saving" OnClick="() => ReviewBatchAsync(true)">Dismiss selected</MudButton>
                @if (items.Where(item => checkedIssues.Contains(item.Id)).All(item => item.Kind == "mangadex-release-stalled"))
                {
                    <MudButton Disabled="@saving" OnClick="DismissCurrentBatchAsync">Dismiss as current</MudButton>
                    <MudButton Disabled="@saving" OnClick="UseExternalBatchAsync">Use configured external readers</MudButton>
                }
                <MudButton Disabled="@saving" OnClick="RecheckBatchAsync">Queue checks or retries</MudButton>
                <MudButton Disabled="@(saving || checkedIssues.Count > 10)" OnClick='() => ApplyBatchAsync("recheck_titles")'>Recheck selected titles</MudButton>
                @if (checkedIssues.Count <= 10 && items.Where(item => checkedIssues.Contains(item.Id)).All(item => item.Kind == "mangadex-identity-mismatch"))
                {
                    <MudButton Disabled="@saving" OnClick="PreviewRepairsAsync">Preview MangaDex repairs</MudButton>
                }
            </MudStack>
        }
        @if (repairPreview.Count > 0)
        {
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">MangaDex repair review</MudText>
                @foreach (var repair in repairPreview)
                {
                    <MudText Typo="Typo.body2"><strong>@repair.Title:</strong> @repair.Message</MudText>
                }
                <MudStack Row="true" Wrap="Wrap.Wrap">
                    @if (repairPreview.Any(repair => repair.MatchId is not null))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@saving" OnClick="ConfirmRepairsAsync">Apply verified replacements</MudButton>
                    }
                    <MudButton Disabled="@saving" OnClick="() => repairPreview.Clear()">Close review</MudButton>
                </MudStack>
            </MudStack>
        }
        @if (loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (items.Count == 0)
        {
            <MudPaper Outlined="true" Elevation="0" Class="pa-4"><MudText Typo="Typo.h6">@(status == "action" ? "Nothing needs action" : status == "review" ? "Nothing waiting for review" : "No issue history")</MudText></MudPaper>
        }
        else
        {
            <div class="mh-issue-groups">
                @foreach (var group in IssueGroups)
                {
                    var isCollapsed = IsGroupCollapsed(group.Key);
                    var mostRecent = group.Max(item => item.UpdatedAt);
                    <MudPaper Outlined="true" Elevation="0" Class="mh-issue-group" @key="group.Key">
                        <button type="button" class="mh-issue-group-header" @onclick="() => ToggleGroup(group.Key)" aria-expanded="@(!isCollapsed)" aria-controls="@($"issue-group-{group.Key}")">
                            <span class="mh-issue-group-icon"><MudIcon Icon="@IssueIcon(group.Key)" /></span>
                            <span class="mh-issue-group-copy"><strong>@IssueLabel(group.Key)</strong><span class="mh-issue-group-date">Updated @mostRecent.ToLocalTime().ToString("g")</span></span>
                            <span class="mh-issues-view-count">@group.Count()</span>
                            <MudIcon Icon="@(isCollapsed ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)" />
                        </button>
                        @if (!isCollapsed)
                        {
                            <div class="mh-issue-group-items" id="@($"issue-group-{group.Key}")">
                                @foreach (var item in group.OrderBy(item => PriorityRank(item.Priority)).ThenByDescending(item => item.UpdatedAt))
                                {
                                    <div class="mh-issue-row" @key="item.Id">
                                                @if (canManage && item.Status == "open")
                                                {
                                                    <MudCheckBox T="bool" Value="@checkedIssues.Contains(item.Id)" ValueChanged="value => SelectIssue(item.Id, value)" aria-label="@($"Select {item.Title}")" />
                                                }
                                                <MudStack Spacing="0" Class="flex-grow-1" Style="min-width: 0; overflow-wrap: anywhere">
                                                    <MudText Typo="Typo.subtitle1">@item.Title</MudText>
                                                    @if (!string.IsNullOrWhiteSpace(item.Diagnosis))
                                                    {
                                                        <MudText Typo="Typo.body2">@item.Diagnosis</MudText>
                                                    }
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.ReportCount report@(item.ReportCount == 1 ? "" : "s") · @item.UpdatedAt.ToLocalTime().ToString("g")</MudText>
                                                </MudStack>
                                                <div class="mh-issue-row-actions">
                                                    <MudChip T="string" Size="Size.Small" Color="@PriorityColor(item.Priority)">@PriorityLabel(item.Priority)</MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(item.Status)">@ReviewLabel(item)</MudChip>
                                                    <MudTooltip Text="@NextIssueAction(item)">
                                                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="() => OpenIssueAsync(item.Id)" aria-label="@NextIssueAction(item)" />
                                                    </MudTooltip>
                                                </div>
                                    </div>
                                }
                            </div>
                        }
                    </MudPaper>
                }
            </div>
            @if (hasMore)
            {
                <MudButton OnClick="LoadMoreAsync">Load more</MudButton>
            }
        }
    </MudStack>
}

@if (scheduleOpen && canManage)
{
    <div class="mh-modal-backdrop">
        <section class="mh-modal mh-issue-detail-modal" role="dialog" aria-modal="true" aria-labelledby="proposal-title">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText id="proposal-title" Typo="Typo.h6">AI proposals</MudText>
                        <MudTooltip Text="@ChatGptStatusLabel">
                            <span role="img" aria-label="@ChatGptStatusLabel" class="@(chatGptStatus?.LastVerifiedAt is not null ? "mh-proposal-status verified" : "mh-proposal-status")"></span>
                        </MudTooltip>
                    </MudStack>
                    <MudStack Row="true" Spacing="0">
                        <MudTooltip Text="ChatGPT connection setup">
                            <MudIconButton Icon="@Icons.Material.Outlined.Info" Href="https://developers.openai.com/siwc/token-sharing-open-source/self-hosted-vms"
                                           Target="_blank" Rel="noopener noreferrer" aria-label="ChatGPT connection setup" />
                        </MudTooltip>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Disabled="@scheduleBusy" OnClick="RefreshProposalInboxAsync" aria-label="Refresh drafts" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Disabled="@batchRunning" OnClick="() => scheduleOpen = false" aria-label="Close AI proposals" />
                    </MudStack>
                </MudStack>
                <section aria-label="Current drafts">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle1">Current drafts</MudText>
                        @if (proposalSchedule?.LastError is { Length: > 0 } runError)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">@runError</MudAlert>
                        }
                        @if (proposalRequestError is { } error)
                        {
                            <MudPaper Outlined="true" Elevation="0" Class="pa-3">
                                <MudStack Spacing="1" role="status" aria-live="polite">
                                    <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert>
                                </MudStack>
                            </MudPaper>
                        }
                        @if (proposalSchedule?.Running == true && !batchRunning)
                        {
                            <MudProgressLinear Indeterminate="true" aria-label="Proposal batch running" />
                            <MudText Typo="Typo.body2">Proposal run in progress</MudText>
                        }
                        @if (proposalSchedule is { } inbox && inbox.Drafts.Count > 0)
                        {
                            <MudText Typo="Typo.body2">New batches wait until all drafts are reviewed.</MudText>
                    @foreach (var draft in inbox.Drafts)
                    {
                        var sections = draft.Text.Split("\n\nResearch sources:\n", 2, StringSplitOptions.None);
                        <MudPaper @key="draft.Id" Outlined="true" Elevation="0" Class="pa-4">
                        <MudStack Spacing="2">
                        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle1" Style="overflow-wrap: anywhere">@(draft.Title ?? "Issue proposal")</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(draft.Manual ? "Manual" : "Scheduled")</MudChip>
                        </MudStack>
                        <MudDivider />
                        @if (draft.Action == "repair_mangadex")
                        {
                            <MudText Typo="Typo.body2">Replace MangaDex ID with <strong>@draft.ReplacementId</strong>.</MudText>
                        }
                        else if (draft.Action == "snooze")
                        {
                            <MudText Typo="Typo.body2">Snooze this issue for <strong>@draft.SnoozeDays days</strong>.</MudText>
                        }
                        else if (draft.Action == "mark_hiatus")
                        {
                            <MudText Typo="Typo.body2">Set publication status to <strong>On hiatus</strong> and resolve this stalled-release issue.</MudText>
                            @if (Uri.TryCreate(draft.SourceUrl, UriKind.Absolute, out var hiatusSource) && hiatusSource.Scheme is "https" or "http")
                            {
                                <a href="@hiatusSource.AbsoluteUri" target="_blank" rel="noopener noreferrer">Review the hiatus announcement</a>
                            }
                        }
                        else if (AdditionalDraftAction(draft) is { } actionLabel)
                        {
                            <MudText Typo="Typo.body2"><strong>@actionLabel</strong></MudText>
                            @if (Uri.TryCreate(draft.SourceUrl, UriKind.Absolute, out var evidenceSource) && evidenceSource.Scheme is "https" or "http")
                            {
                                <a href="@evidenceSource.AbsoluteUri" target="_blank" rel="noopener noreferrer">Review cited evidence</a>
                            }
                        }
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap; overflow-wrap: anywhere">@sections[0]</MudText>
                        @if (sections.Length == 2)
                        {
                            <MudText Typo="Typo.subtitle2">Research sources</MudText>
                            @foreach (var link in sections[1].Split('\n', StringSplitOptions.RemoveEmptyEntries))
                            {
                                if (Uri.TryCreate(link, UriKind.Absolute, out var source) && source.Scheme is "https" or "http" && string.IsNullOrEmpty(source.UserInfo))
                                {
                                    <a href="@source.AbsoluteUri" target="_blank" rel="noopener noreferrer" style="overflow-wrap: anywhere">@source.AbsoluteUri</a>
                                }
                            }
                        }
                        <MudDivider />
                        <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.FlexEnd">
                            @if (draft.Action is "repair_mangadex" or "snooze" or "mark_hiatus" || AdditionalDraftAction(draft) is not null)
                            {
                                <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@scheduleBusy" OnClick="() => ApproveDraftAsync(draft.Id)">Approve and apply</MudButton>
                            }
                            <MudButton Disabled="@scheduleBusy" OnClick="() => ReviewScheduledDraftAsync(draft.Id)">Leave unchanged</MudButton>
                        </MudStack>
                        </MudStack>
                        </MudPaper>
                    }
                        }
                        else if (!batchRunning && proposalRequestError is null && proposalSchedule?.Running != true)
                        {
                            <MudText Typo="Typo.body2">@(scheduleBusy ? "Loading drafts..." : proposalSchedule is null ? "Could not load drafts." : "No drafts awaiting review.")</MudText>
                        }
                    </MudStack>
                </section>
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Draft now">
                        <MudStack Spacing="2">
                <MudNumericField T="int" Label="Issues per request" @bind-Value="proposalLimit" Min="1" Max="10" Disabled="@batchRunning" />
                <MudNumericField T="int" Label="Seconds between requests" @bind-Value="proposalDelay" Min="1" Max="120" Disabled="@batchRunning" />
                <MudSwitch T="bool" Label="Web research for this batch" @bind-Value="manualWebResearch" Disabled="@batchRunning" />
                @if (!batchRunning)
                {
                    <MudText Typo="Typo.body2">@(checkedIssues.Count == 0 ? "All eligible open issues" : "Selected eligible issues")</MudText>
                }
                <MudStack Row="true" Wrap="Wrap.Wrap">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled"
                               Disabled="@(batchRunning || proposalSchedule?.Running == true || proposalSchedule?.Drafts.Count > 0)"
                               OnClick="RunProposalBatchAsync">@(batchRunning ? "Submitting..." : "Start batch")</MudButton>
                    @if (proposalSchedule is { ManualRunning: true } run)
                    {
                        <MudButton Disabled="@(batchRunning || run.ManualStopRequested)" OnClick="StopProposalBatchAsync">
                            @(run.ManualStopRequested ? "Stopping..." : "Stop after current request")
                        </MudButton>
                    }
                </MudStack>
                        </MudStack>
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Schedule">
                        @if (proposalSchedule is { } schedule)
                        {
                            <MudStack Spacing="2">
                    <MudSwitch T="bool" @bind-Value="scheduleEnabled" Label="Enable automatic proposals" />
                                <MudSwitch T="bool" @bind-Value="scheduleWebResearchEnabled" Label="Web research for release and language gaps" />
                                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudNumericField T="int" Label="Time between batches" @bind-Value="scheduleBatchAmount"
                                                     Min="@(scheduleBatchUnit == 1 ? 5 : 1)" Max="@(43200 / scheduleBatchUnit)" />
                                    <MudSelect T="int" Label="Time unit" @bind-Value="scheduleBatchUnit" Dense="true">
                                        <MudSelectItem T="int" Value="1">Minutes</MudSelectItem>
                                        <MudSelectItem T="int" Value="60">Hours</MudSelectItem>
                                        <MudSelectItem T="int" Value="1440">Days</MudSelectItem>
                                    </MudSelect>
                                </MudStack>
                    <MudNumericField T="int" Label="Seconds between requests" @bind-Value="scheduleRequestInterval" Min="1" Max="3600" />
                    <MudNumericField T="int" Label="Issues per request" @bind-Value="scheduleGroupSize" Min="1" Max="10" />
                    @if (schedule.Drafts.Count > 0)
                    {
                        <MudAlert Severity="Severity.Info">Waiting for review before starting another batch.</MudAlert>
                    }
                    else if (schedule.Running)
                    {
                        <MudText>Batch running</MudText>
                    }
                    else if (schedule.Enabled && schedule.NextRunAt is { } next)
                    {
                        <MudText>Next batch: @next.ToLocalTime().ToString("g")</MudText>
                    }
                                <MudButton Disabled="@scheduleBusy" Color="Color.Primary" OnClick="SaveProposalScheduleAsync">Save schedule</MudButton>
                            </MudStack>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudStack>
        </section>
    </div>
}

@if (selected is not null)
{
    <div class="mh-modal-backdrop" @onclick="CloseIssue">
        <section class="mh-modal mh-issue-detail-modal" role="dialog" aria-modal="true" aria-labelledby="issue-detail-title" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween"><MudStack Spacing="0"><MudText id="issue-detail-title" Typo="Typo.h2">@selected.Title</MudText><MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center"><MudText Typo="Typo.body2" Color="Color.Error">@SelectedIssueLabel · @selected.Reports.Count report@(selected.Reports.Count == 1 ? "" : "s")</MudText><MudChip T="string" Size="Size.Small" Color="@PriorityColor(selected.Priority)">@PriorityLabel(selected.Priority)</MudChip></MudStack></MudStack><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseIssue" aria-label="Close issue" /></MudStack>
                @if (!string.IsNullOrWhiteSpace(selected.CoverUrl)) { <img class="mh-issue-cover" src="@selected.CoverUrl" alt="" /> }
                @if (ExternalReaderIssue is { } externalReaderIssue)
                {
                    <MudAlert Severity="@externalReaderIssue.Severity" Variant="Variant.Outlined">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle2">@externalReaderIssue.Heading</MudText>
                            <MudText Typo="Typo.body2">@externalReaderIssue.Explanation</MudText>
                            @if (!string.IsNullOrWhiteSpace(externalReaderIssue.PreviousMangaDexId))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Previous MangaDex ID: @externalReaderIssue.PreviousMangaDexId</MudText>
                            }
                        </MudStack>
                    </MudAlert>
                }
                @if (IsTranslationCoverageIssue)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        @if (TranslationCoverage is { } coverage)
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2">Latest in any MangaDex language: <strong class="mh-issue-chapter">Ch. @coverage.LatestChapter</strong>.</MudText>
                                @foreach (var affected in coverage.AffectedLanguages)
                                {
                                    <MudText Typo="Typo.body2">@affected.Languages: latest readable <strong class="mh-issue-chapter">Ch. @affected.LatestChapter</strong>@(affected.IncludesExternal ? $" (including external reader through Ch. {affected.ExternalLatestChapter})" : "") · @affected.Gap chapters behind.</MudText>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">MangaDex translations are materially behind another available language.</MudText>
                        }
                    </MudAlert>
                }
                @if (canManage && IsOpen && (IsReleaseStallIssue || IsMangaDexIdentityMismatchIssue))
                {
                    <MudButton Disabled="@batchRunning" OnClick="SuggestRepairAsync">Draft repair suggestion</MudButton>
                }
                @if (IsReleaseStallIssue)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        @if (ReleaseStall is { } stall)
                        {
                            <MudText Typo="Typo.body2">Latest readable on MangaDex: <strong class="mh-issue-chapter">Ch. @stall.LatestChapter</strong> (@stall.LastObserved). Inactive for @stall.InactiveDays ongoing days.</MudText>
                            @if (stall.ExternalChapter != "unknown")
                            {
                                <MudText Typo="Typo.body2">Recorded external reader: <strong>Ch. @stall.ExternalChapter</strong>.</MudText>
                            }
                            @if (stall.ReferenceChapter != "unknown")
                            {
                                <MudText Typo="Typo.body2">MangaUpdates reference: <strong>Ch. @stall.ReferenceChapter</strong>. This does not confirm a readable translation.</MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">MangaDex still marks this title ongoing, but no new page-bearing chapter has appeared for at least 30 days.</MudText>
                        }
                    </MudAlert>
                }
                @if (IsMangaDexIdentityMismatchIssue)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        @if (MangaDexIdentityMismatch is { } mismatch)
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2">This catalog entry expects <strong>MAL #@mismatch.ExpectedMyAnimeListId</strong>, but MangaDex link <strong>@mismatch.LinkedMangaDexId</strong> belongs to <strong>MAL #@mismatch.LinkedMyAnimeListId</strong>.</MudText>
                                <MudText Typo="Typo.body2">Linked MangaDex title: <strong>@mismatch.LinkedTitle</strong>.</MudText>
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">The linked MangaDex record has a different MyAnimeList identity from this catalog entry.</MudText>
                        }
                    </MudAlert>
                    @if (IsOpen && MangaDexIdentityMismatch is { } repairMismatch)
                    {
                        <fieldset class="mh-identity-options" disabled="@saving">
                            <legend>Which source should this catalog entry follow?</legend>
                            <label class="mh-identity-option">
                                <input type="radio" name="identity-repair" checked="@(identityChoice == "mangadex")" disabled="@(!int.TryParse(repairMismatch.LinkedMyAnimeListId, out _))" @onchange='() => SelectIdentityChoice("mangadex")' />
                                <span><strong>Keep MangaDex</strong><span>Change MAL #@repairMismatch.ExpectedMyAnimeListId to #@repairMismatch.LinkedMyAnimeListId. Other catalog metadata stays unchanged.</span></span>
                            </label>
                            <label class="mh-identity-option">
                                <input type="radio" name="identity-repair" checked="@(identityChoice == "mal")" @onchange='() => SelectIdentityChoice("mal")' />
                                <span><strong>Keep MyAnimeList</strong><span>Find a MangaDex entry matching MAL #@repairMismatch.ExpectedMyAnimeListId and review it before replacing the link.</span></span>
                            </label>
                        </fieldset>
                        @if (identityCandidate is not null && identityChoice == "mal")
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Verified match: <strong>@identityCandidate.Title</strong> (@identityCandidate.Id). Confirm to replace the MangaDex link.</MudAlert>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(saving || string.IsNullOrEmpty(identityChoice))" OnClick="ConfirmIdentityChoiceAsync">@(saving ? "Working..." : identityChoice == "mal" && identityCandidate is null ? "Find match" : "Confirm fix")</MudButton>
                    }
                }
                @if (IsMaintenanceFailureIssue)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        @if (MaintenanceFailure is { } failure)
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2"><strong>@failure.Type</strong> failed during a @failure.Trigger run on @failure.FailedAt.</MudText>
                                <MudText Typo="Typo.body2">@failure.Error</MudText>
                                @if (CanRetryMaintenanceFailure)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Replay" Disabled="@saving" OnClick="RetryMaintenanceFailureAsync">@(saving ? "Queueing..." : "Retry this task")</MudButton>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">This maintenance task failed. Its latest error is available in Operations history.</MudText>
                        }
                    </MudAlert>
                }
                @if (MaintenanceFailure is { } task && IsMaintenanceFailureIssue)
                {
                    <MudStack Spacing="2">
                        <MudButton StartIcon="@Icons.Material.Filled.History" Disabled="@loadingAttempts" OnClick="LoadFailureAttemptsAsync">
                            @(loadingAttempts ? "Loading attempts..." : failureAttempts is null ? "Show recent attempts" : "Refresh attempts")
                        </MudButton>
                        @if (failureAttempts is { Count: 0 })
                        {
                            <MudText Typo="Typo.body2">No recent attempts available.</MudText>
                        }
                        else if (failureAttempts is { Count: > 0 } attempts)
                        {
                            <MudText Typo="Typo.subtitle2">Recent attempts · @attempts.Count(run => run.Status == "failed") failed of @attempts.Count shown</MudText>
                            @foreach (var run in attempts)
                            {
                                <MudStack Spacing="0" @key="run.Id">
                                    <MudText Typo="Typo.body2"><strong>@run.Status</strong> · @run.Trigger · @run.RequestedAt.ToLocalTime().ToString("g")</MudText>
                                    @if (!string.IsNullOrWhiteSpace(run.Error))
                                    {
                                        <MudText Typo="Typo.caption" Style="overflow-wrap: anywhere">@run.Error</MudText>
                                    }
                                </MudStack>
                            }
                        }
                    </MudStack>
                }
                @if (IsCatalogRegistrationFailureIssue)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2">Finish this catalog registration</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Select the correct MyAnimeList result, then either retry MangaDex matching or save it with a verified external reader.</MudText>
                            </MudStack>
                            <div class="mh-issue-metadata-anchor">
                                <MangaDebouncedSearch @bind-Value="metadataQuery"
                                                      Label="Find the correct manga on MyAnimeList"
                                                      AriaLabel="Search MyAnimeList metadata"
                                                      IsLoading="@isSearchingMetadata"
                                                      Disabled="@(!IsOpen || saving)"
                                                      OnSearch="SearchMetadataAsync" />
                                <MudPopover Open="@(isSearchingMetadata || metadataResults.Count > 0 || !string.IsNullOrWhiteSpace(metadataMessage))"
                                            AnchorOrigin="Origin.BottomLeft"
                                            TransformOrigin="Origin.TopLeft"
                                            Class="mh-issue-metadata-popover">
                                    <MudPaper Elevation="8" Outlined="true" Class="pa-2 mh-issue-metadata-results">
                                        @if (isSearchingMetadata)
                                        {
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><MudText Typo="Typo.caption">Searching MyAnimeList...</MudText></MudStack>
                                        }
                                        else if (metadataResults.Count > 0)
                                        {
                                            <MudStack Spacing="1">
                                                @foreach (var item in metadataResults.Take(6))
                                                {
                                                    <MudButton Variant="Variant.Text" Color="Color.Inherit" FullWidth="true" Class="justify-start text-left" Disabled="@saving" OnClick="() => SelectCatalogRegistrationMetadata(item)">
                                                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="w-100">
                                                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl)) { <img src="@item.CoverUrl" alt="" class="mh-issue-metadata-cover" /> }
                                                            <MudStack Spacing="0" Class="flex-grow-1 overflow-hidden">
                                                                <MudText Typo="Typo.body2" Class="text-truncate">@item.Title</MudText>
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">MAL #@item.MyAnimeListId · @item.Authors</MudText>
                                                            </MudStack>
                                                        </MudStack>
                                                    </MudButton>
                                                }
                                            </MudStack>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(metadataMessage))
