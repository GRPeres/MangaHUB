@page "/issues"
@page "/admin/issues"
@using MangaHub.Web.API.DTOs
@using MangaHub.Web.API.Services
@inject AuthSessionService Auth
@inject AdminApiService AdminApi
@inject MetadataApiService MetadataApi
@inject MessageService Messages

<PageTitle>Issues</PageTitle>

@if (user is null)
{
    <MudAlert Severity="Severity.Warning">Sign in to view issues.</MudAlert>
}
else if (!isAdmin)
{
    <MudAlert Severity="Severity.Error">Admin permissions are required.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <AdminSectionNav />
        <section class="mh-dashboard-header">
            <MudStack Spacing="1">
                <MudText Typo="Typo.overline" Color="Color.Error">Admin maintenance</MudText>
                <MudText Typo="Typo.h2">Issues</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Reader reports and future maintenance problems in one repair queue.</MudText>
            </MudStack>
            <MudStack Row="true" Spacing="1">
                <MudSelect T="string" @bind-Value="status" Dense="true" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("open")">Open</MudSelectItem>
                    <MudSelectItem T="string" Value="@("resolved")">Resolved</MudSelectItem>
                    <MudSelectItem T="string" Value="@("dismissed")">Dismissed</MudSelectItem>
                    <MudSelectItem T="string" Value="@("all")">All</MudSelectItem>
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" aria-label="Refresh issues" />
            </MudStack>
        </section>
        @if (loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (items.Count == 0)
        {
            <MudPaper Outlined="true" Class="pa-5"><MudText Typo="Typo.h6">No @status issues</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">The repair queue is clear.</MudText></MudPaper>
        }
        else
        {
            <MudGrid Spacing="2">
                @foreach (var item in items)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-3 mh-issue-card">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudAvatar Size="Size.Medium" Color="Color.Error"><MudIcon Icon="@IssueIcon(item.Kind)" /></MudAvatar>
                                <MudStack Spacing="0" Class="flex-grow-1"><MudText Typo="Typo.subtitle1">@item.Title</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@IssueLabel(item.Kind) · @item.ReportCount report@(item.ReportCount == 1 ? "" : "s") · @item.UpdatedAt.ToLocalTime().ToString("g")</MudText></MudStack>
                                <MudChip T="string" Size="Size.Small" Color="@StatusColor(item.Status)">@item.Status</MudChip>
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="() => OpenIssueAsync(item.Id)" aria-label="Open issue" />
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudStack>
}

@if (selected is not null)
{
    <div class="mh-modal-backdrop" @onclick="CloseIssue">
        <section class="mh-modal mh-issue-detail-modal" role="dialog" aria-modal="true" aria-labelledby="issue-detail-title" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween"><MudStack Spacing="0"><MudText id="issue-detail-title" Typo="Typo.h2">@selected.Title</MudText><MudText Typo="Typo.body2" Color="Color.Error">@IssueLabel(selected.Kind) · @selected.Reports.Count report@(selected.Reports.Count == 1 ? "" : "s")</MudText></MudStack><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseIssue" aria-label="Close issue" /></MudStack>
                @if (!string.IsNullOrWhiteSpace(selected.CoverUrl)) { <img class="mh-issue-cover" src="@selected.CoverUrl" alt="" /> }
                @if (IsExternalReaderLinkIssue)
                {
                    <MudTextField T="string" @bind-Value="replacementUrl" Label="Replacement external reader URL" Variant="Variant.Outlined" Disabled="@(!IsOpen)" />
                    <MudStack Row="true" Spacing="1" Class="flex-wrap"><MudButton Href="@GoogleSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">Google</MudButton><MudButton Href="@DuckDuckGoSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">DuckDuckGo</MudButton><MudButton Href="@MangaDexSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">MangaDex</MudButton><MudButton Href="@MalSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">MAL</MudButton><MudButton Href="@MangaUpdatesSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">MangaUpdates</MudButton></MudStack>
                }
                @if (IsExternalReaderLinkIssue)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2">Restore the MangaHub reader</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Search MyAnimeList, select the correct manga, and MangaHub will try to restore its MangaDex reader.</MudText>
                            </MudStack>
                            <div class="mh-issue-metadata-anchor">
                                <MangaDebouncedSearch @bind-Value="metadataQuery"
                                                      Label="Find the correct manga on MyAnimeList"
                                                      AriaLabel="Search MyAnimeList metadata"
                                                      IsLoading="@isSearchingMetadata"
                                                      Disabled="@(!IsOpen || saving)"
                                                      OnSearch="SearchMetadataAsync" />
                                <MudPopover Open="@(isSearchingMetadata || metadataResults.Count > 0 || !string.IsNullOrWhiteSpace(metadataMessage))"
                                            AnchorOrigin="Origin.BottomLeft"
                                            TransformOrigin="Origin.TopLeft"
                                            Class="mh-issue-metadata-popover">
                                    <MudPaper Elevation="8" Outlined="true" Class="pa-2 mh-issue-metadata-results">
                                        @if (isSearchingMetadata)
                                        {
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><MudText Typo="Typo.caption">Searching MyAnimeList...</MudText></MudStack>
                                        }
                                        else if (metadataResults.Count > 0)
                                        {
                                            <MudStack Spacing="1">
                                                @foreach (var item in metadataResults.Take(6))
                                                {
                                                    <MudButton Variant="Variant.Text" Color="Color.Inherit" FullWidth="true" Class="justify-start text-left" Disabled="@saving" OnClick="() => ReintegrateWithMetadataAsync(item)">
                                                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="w-100">
                                                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl)) { <img src="@item.CoverUrl" alt="" class="mh-issue-metadata-cover" /> }
                                                            <MudStack Spacing="0" Class="flex-grow-1 overflow-hidden">
                                                                <MudText Typo="Typo.body2" Class="text-truncate">@item.Title</MudText>
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">MAL #@item.MyAnimeListId · @item.Authors</MudText>
                                                            </MudStack>
                                                        </MudStack>
                                                    </MudButton>
                                                }
                                            </MudStack>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(metadataMessage))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@metadataMessage</MudText>
                                        }
                                    </MudPaper>
                                </MudPopover>
                            </div>
                            @if (CanReintegrate)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap" Spacing="2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Catalog MAL ID: @selected.MyAnimeListId</MudText>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoFixHigh" Disabled="@saving" OnClick="ReintegrateWithMangaDexAsync">@(saving ? "Matching..." : "Try current MAL ID")</MudButton>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                }
                @if (IsDuplicateCatalogIssue && selected.DuplicateCatalogEntries is { Count: > 1 } duplicates)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudStack Spacing="0"><MudText Typo="Typo.subtitle2">Duplicate catalog identity</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Choose the record to keep. Shelf entries, progress, release state, notifications, and analytics references are moved into it before the other record is removed.</MudText></MudStack>
                            @foreach (var duplicate in duplicates)
                            {
                                <MudPaper Outlined="true" Class="pa-2 mh-duplicate-entry">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                                        @if (!string.IsNullOrWhiteSpace(duplicate.CoverUrl)) { <img src="@duplicate.CoverUrl" alt="" class="mh-duplicate-cover" /> }
                                        <MudStack Spacing="0" Class="flex-grow-1"><MudText Typo="Typo.subtitle2">@duplicate.Title</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">MAL: @DisplayIdentifier(duplicate.MyAnimeListId) · MangaDex: @DisplayIdentifier(duplicate.MangaDexId) · MangaUpdates: @DisplayIdentifier(duplicate.MangaUpdatesId)</MudText></MudStack>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.MergeType" Disabled="@(!IsOpen || saving)" OnClick="() => MergeDuplicatesAsync(duplicate.Id)">Keep this entry</MudButton>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudPaper>
                }
                <MudTextField T="string" @bind-Value="resolutionNote" Label="Resolution note" Lines="2" Variant="Variant.Outlined" Disabled="@(!IsOpen)" />
                <MudDivider />
                @foreach (var report in selected.Reports) { <MudPaper Outlined="true" Class="pa-2"><MudText Typo="Typo.subtitle2">@ReasonLabel(report.Reason)</MudText>@if (!string.IsNullOrWhiteSpace(report.Note)) { <MudText Typo="Typo.body2">@report.Note</MudText> }<MudText Typo="Typo.caption" Color="Color.Secondary">Reported URL: @report.SnapshotValue</MudText></MudPaper> }
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">@if (selected.Status == "open") { <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@saving" OnClick="DismissAsync">Dismiss</MudButton>@if (IsExternalReaderLinkIssue) { <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@saving" OnClick="ResolveAsync">@(saving ? "Saving..." : "Save repair and resolve")</MudButton> } } else { <MudButton Variant="Variant.Outlined" Disabled="@saving" OnClick="ReopenAsync">Reopen</MudButton> }</MudStack>
            </MudStack>
        </section>
    </div>
}

@code {
    private UserResponse? user;
    private List<AdminIssueListItemResponse> items = [];
    private AdminIssueDetailsResponse? selected;
    private string status = "open";
    private string replacementUrl = "";
    private string resolutionNote = "";
    private string metadataQuery = "";
    private string metadataMessage = "";
    private List<MetadataResult> metadataResults = [];
    private bool loading = true;
    private bool saving;
    private bool isSearchingMetadata;
    private int metadataSearchVersion;
    private bool isAdmin => string.Equals(user?.Role, "admin", StringComparison.OrdinalIgnoreCase);
    private bool IsOpen => selected?.Status == "open";
    private bool IsExternalReaderLinkIssue => string.Equals(selected?.Kind, "external-reader-link", StringComparison.OrdinalIgnoreCase);
    private bool IsDuplicateCatalogIssue => string.Equals(selected?.Kind, "duplicate-catalog-id", StringComparison.OrdinalIgnoreCase);
    private bool CanReintegrate => IsOpen && !string.IsNullOrWhiteSpace(selected?.MyAnimeListId) && string.IsNullOrWhiteSpace(selected?.MangaDexId);
    private string GoogleSearchUrl => selected is null ? "" : SearchUrl("https://www.google.com/search?q=", selected);
    private string DuckDuckGoSearchUrl => selected is null ? "" : SearchUrl("https://duckduckgo.com/?q=", selected);
    private string MangaDexSearchUrl => selected is null ? "" : BuildMangaDexSearchUrl(selected);
    private string MalSearchUrl => selected is null ? "" : BuildMalSearchUrl(selected);
    private string MangaUpdatesSearchUrl => selected is null ? "" : BuildMangaUpdatesSearchUrl(selected);

    protected override async Task OnInitializedAsync() { user = await Auth.GetCurrentUserAsync(); if (isAdmin) await LoadAsync(); else loading = false; }
    private async Task LoadAsync() { loading = true; try { items = await AdminApi.GetIssuesAsync(status); } finally { loading = false; } }
    private async Task OpenIssueAsync(Guid id) { selected = await AdminApi.GetIssueAsync(id); if (selected is null) Messages.Error("Could not load this issue."); else { replacementUrl = selected.FallbackReaderUrl; resolutionNote = selected.ResolutionNote; metadataQuery = selected.Title; metadataResults = []; metadataMessage = ""; } }
    private void CloseIssue() { selected = null; metadataResults = []; metadataMessage = ""; }
    private async Task ResolveAsync() { if (selected is null) return; saving = true; try { if (await AdminApi.ResolveIssueAsync(selected.Id, new(replacementUrl, resolutionNote))) { Messages.Success("The shared link was repaired and reporters were notified.", "Issue resolved"); CloseIssue(); await LoadAsync(); } else Messages.Error("Enter a valid replacement URL.", "Could not resolve issue"); } finally { saving = false; } }
    private async Task ReintegrateWithMangaDexAsync()
    {
        if (selected is null || !CanReintegrate) return;
        saving = true;
        try
        {
            var result = await AdminApi.ReintegrateIssueWithMangaDexAsync(selected.Id);
            if (result.Value is null)
            {
                Messages.Warning(string.IsNullOrWhiteSpace(result.Error) ? "No automatic MangaDex match was found. Keep or repair the external link instead." : result.Error, "MangaHub reader not restored");
                return;
            }

            Messages.Success($"Linked MangaDex: {result.Value.Title}. Reporters were notified.", "MangaHub reader restored");
            CloseIssue();
            await LoadAsync();
        }
        finally
        {
            saving = false;
        }
    }
    private async Task SearchMetadataAsync(string query)
    {
        var searchVersion = ++metadataSearchVersion;
        metadataResults = [];
        metadataMessage = "";
        if (string.IsNullOrWhiteSpace(query)) return;

        isSearchingMetadata = true;
        try
        {
            var results = await MetadataApi.SearchAsync(query);
            if (searchVersion != metadataSearchVersion) return;
            metadataResults = results
                .Where(item => string.Equals(item.Source, "myanimelist", StringComparison.OrdinalIgnoreCase)
                    && !string.IsNullOrWhiteSpace(item.MyAnimeListId))
                .ToList();
            metadataMessage = metadataResults.Count == 0 ? "No MyAnimeList matches found." : "";
        }
        catch
        {
            if (searchVersion == metadataSearchVersion) metadataMessage = "Metadata search failed.";
        }
        finally
        {
            if (searchVersion == metadataSearchVersion) isSearchingMetadata = false;
        }
    }
    private async Task ReintegrateWithMetadataAsync(MetadataResult metadata)
    {
        if (selected is null || !IsOpen || saving) return;
        saving = true;
        try
        {
            var request = new ReintegrateIssueWithMetadataRequest(metadata.MyAnimeListId, metadata.Title, metadata.Authors, metadata.CoverUrl,
                metadata.FirstPublishYear, metadata.Category, metadata.Description, metadata.MediaType, metadata.PublishingStatus,
                metadata.ChapterCount, metadata.VolumeCount);
            var result = await AdminApi.ReintegrateIssueWithMetadataAsync(selected.Id, request);
            if (result.Value is null)
            {
                Messages.Error(string.IsNullOrWhiteSpace(result.Error) ? "Could not save the selected MAL result." : result.Error, "Metadata repair failed");
                return;
            }

            if (result.Value.ReaderRestored)
            {
                Messages.Success(result.Value.Message + " Reporters were notified.", "MangaHub reader restored");
                CloseIssue();
                await LoadAsync();
                return;
            }

            Messages.Info(result.Value.Message, "MAL metadata saved");
            await OpenIssueAsync(selected.Id);
        }
        finally
        {
            saving = false;
        }
    }
    private async Task MergeDuplicatesAsync(Guid keepMangaEntryId)
    {
        if (selected is null || !IsDuplicateCatalogIssue || !IsOpen) return;
        saving = true;
        try
        {
            if (!await AdminApi.MergeDuplicateCatalogIssueAsync(selected.Id, keepMangaEntryId))
            {
                Messages.Error("The duplicate records changed before they could be merged. Refresh the issue and try again.", "Could not merge duplicates");
                return;
            }

            Messages.Success("The duplicate catalog entries were merged. Existing shelf records now point to the selected entry.", "Catalog entries merged");
            CloseIssue();
            await LoadAsync();
        }
        finally
        {
            saving = false;
        }
    }
    private async Task DismissAsync() { if (selected is null) return; saving = true; try { if (await AdminApi.DismissIssueAsync(selected.Id, resolutionNote)) { Messages.Info("The issue was dismissed and reporters were notified."); CloseIssue(); await LoadAsync(); } } finally { saving = false; } }
    private async Task ReopenAsync() { if (selected is null) return; saving = true; try { if (await AdminApi.ReopenIssueAsync(selected.Id)) { await OpenIssueAsync(selected.Id); await LoadAsync(); } } finally { saving = false; } }
    private static string IssueLabel(string kind) => kind switch { "external-reader-link" => "External reader link", "duplicate-catalog-id" => "Duplicate catalog ID", _ => kind };
    private static string IssueIcon(string kind) => kind switch { "external-reader-link" => Icons.Material.Filled.LinkOff, "duplicate-catalog-id" => Icons.Material.Filled.ContentCopy, _ => Icons.Material.Filled.ReportProblem };
    private static Color StatusColor(string value) => value == "resolved" ? Color.Success : value == "dismissed" ? Color.Secondary : Color.Error;
    private static string ReasonLabel(string reason) => reason switch { "wrong-manga" => "Wrong manga", "obsolete" => "Obsolete or unhelpful", "unsafe" => "Potentially unsafe", "broken" => "Broken link", _ => "Other problem" };
    private static string DisplayIdentifier(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string SearchUrl(string baseUrl, AdminIssueDetailsResponse issue) => baseUrl + Uri.EscapeDataString(issue.Title + " manga read");
    private static string BuildMangaDexSearchUrl(AdminIssueDetailsResponse issue) => string.IsNullOrWhiteSpace(issue.MangaDexId) ? SearchUrl("https://mangadex.org/search?q=", issue) : $"https://mangadex.org/title/{issue.MangaDexId}";
    private static string BuildMalSearchUrl(AdminIssueDetailsResponse issue) => string.IsNullOrWhiteSpace(issue.MyAnimeListId) ? SearchUrl("https://myanimelist.net/manga.php?q=", issue) : $"https://myanimelist.net/manga/{issue.MyAnimeListId}";
    private static string BuildMangaUpdatesSearchUrl(AdminIssueDetailsResponse issue) => string.IsNullOrWhiteSpace(issue.MangaUpdatesId) ? SearchUrl("https://www.mangaupdates.com/search.html?search=", issue) : $"https://www.mangaupdates.com/series/{issue.MangaUpdatesId}";
}
