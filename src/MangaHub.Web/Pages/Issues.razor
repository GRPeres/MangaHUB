        saving = true;
        try
        {
            var request = new MangaEntryRequest(
                metadata.Title, metadata.Authors, metadata.Category, metadata.Description, metadata.CoverUrl,
                metadata.OpenLibraryKey, metadata.FirstPublishYear, "", "", null, "", metadata.Source,
                metadata.MyAnimeListId, metadata.MediaType, metadata.PublishingStatus, metadata.ChapterCount,
                metadata.VolumeCount, "", useExternalReader ? catalogRegistrationFallbackUrl.Trim() : "",
                useExternalReader ? "external" : "mangahub");
            var result = await AdminApi.ResolveCatalogRegistrationIssueAsync(selected.Id, request);
            if (result.Value is null)
            {
                Messages.Error(string.IsNullOrWhiteSpace(result.Error) ? "The catalog entry could not be created." : result.Error, "Registration still needs review");
                return;
