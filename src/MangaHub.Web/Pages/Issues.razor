    private ExternalReaderIssueDetail? ExternalReaderIssue
    {
        get
        {
            if (!IsExternalReaderLinkIssue || selected is null) return null;

            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(selected.MetadataJson);
                var root = document.RootElement;
                var reason = root.TryGetProperty("reason", out var reasonNode) ? reasonNode.GetString() : null;
                var previousMangaDexId = root.TryGetProperty("previousMangaDexId", out var mangaDexNode) ? mangaDexNode.GetString() : null;
                if (string.Equals(reason, "mangadex-no-chapters", StringComparison.OrdinalIgnoreCase))
                {
                    return new ExternalReaderIssueDetail(
                        "MangaDex reader unavailable",
                        "MangaDex returned no usable chapters for its previous link. The external reader was not reported as broken.",
                        Severity.Warning,
                        true,
                        previousMangaDexId ?? "");
                }
            }
            catch (System.Text.Json.JsonException)
            {
                // Older issue metadata can be malformed; reports still provide a useful fallback cause.
            }

            var reportReason = selected.Reports.OrderByDescending(report => report.CreatedAt).FirstOrDefault()?.Reason;
            return reportReason switch
            {
                "broken" => new ExternalReaderIssueDetail("External reader link reported broken", "A reader could not open the external link. Replace it with a working page for this manga.", Severity.Error, false, ""),
                "wrong-manga" => new ExternalReaderIssueDetail("External reader points to the wrong manga", "A reader reported that this link leads to a different title. Replace it with the correct manga page.", Severity.Error, false, ""),
                "obsolete" => new ExternalReaderIssueDetail("External reader link is obsolete", "A reader reported that this page is no longer useful for following the manga. Update it to a current source.", Severity.Warning, false, ""),
                "unsafe" => new ExternalReaderIssueDetail("External reader link needs safety review", "A reader flagged this external source as potentially unsafe. Verify it before keeping or replacing the link.", Severity.Error, false, ""),
                "other" => new ExternalReaderIssueDetail("External reader needs review", "A reader reported a problem without selecting a more specific cause. Review the link and report note below.", Severity.Warning, false, ""),
                _ => new ExternalReaderIssueDetail("External reader needs review", "No specific link failure was recorded. Review the link and any reports below.", Severity.Warning, false, "")
            };
        }
    }
    private TranslationCoverageDetail? TranslationCoverage
    {
        get
        {
            if (selected is null) return null;
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(selected.MetadataJson);
                var root = document.RootElement;
                var latest = root.TryGetProperty("latestAnyLanguageChapter", out var latestNode) ? FormatChapter(latestNode) : "unknown";
                var groups = root.TryGetProperty("affectedLanguageSets", out var affectedNode) && affectedNode.ValueKind == System.Text.Json.JsonValueKind.Array
                    ? affectedNode.EnumerateArray().Select(group =>
                    {
                        var languages = group.TryGetProperty("preferredLanguages", out var languagesNode) && languagesNode.ValueKind == System.Text.Json.JsonValueKind.Array
                            ? string.Join(", ", languagesNode.EnumerateArray().Select(language => language.GetString()).Where(language => !string.IsNullOrWhiteSpace(language)))
                            : "preferred languages";
                        var preferred = group.TryGetProperty("latestReadableChapter", out var readableNode) && readableNode.ValueKind != System.Text.Json.JsonValueKind.Null ? FormatChapter(readableNode) : group.TryGetProperty("latestPreferredLanguageChapter", out var preferredNode) && preferredNode.ValueKind != System.Text.Json.JsonValueKind.Null ? FormatChapter(preferredNode) : "none";
                        var includesExternal = group.TryGetProperty("latestExternalReaderChapter", out var externalNode) && externalNode.ValueKind == System.Text.Json.JsonValueKind.Number;
                        var externalLatest = includesExternal ? FormatChapter(externalNode) : "";
                        var gap = group.TryGetProperty("chaptersBehind", out var gapNode) ? FormatChapter(gapNode) : "?";
                        return new TranslationCoverageLanguageDetail(languages, preferred, gap, includesExternal, externalLatest);
                    })
                    .ToList()
                    : [];
                return new TranslationCoverageDetail(latest, groups);
            }
            catch (System.Text.Json.JsonException)
            {
                return null;
            }
        }
    }
