                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@metadataMessage</MudText>
                                        }
                                    </MudPaper>
                                </MudPopover>
                            </div>
                            @if (catalogRegistrationMetadata is { } metadata)
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Selected: <strong>@metadata.Title</strong> (MAL #@metadata.MyAnimeListId).</MudAlert>
                                <MudTextField T="string" @bind-Value="catalogRegistrationFallbackUrl" Label="External reader URL" HelperText="Optional. Supplying a valid URL creates this title as an external-reader entry instead of requiring MangaDex." Variant="Variant.Outlined" Disabled="@saving" />
                                <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@saving" OnClick="RetryCatalogRegistrationAsync">@(saving ? "Saving..." : "Retry with MangaDex")</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(saving || !IsHttpUrl(catalogRegistrationFallbackUrl))" OnClick="CreateExternalCatalogRegistrationAsync">@(saving ? "Saving..." : "Create with external reader")</MudButton>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
