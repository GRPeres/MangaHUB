        try
        {
            if (!await AdminApi.MergeDuplicateCatalogIssueAsync(selected.Id, keepMangaEntryId))
            {
                Messages.Error("The duplicate records changed before they could be merged. Refresh the issue and try again.", "Could not merge duplicates");
                return;
            }

            Messages.Success("The duplicate catalog entries were merged. Existing shelf records now point to the selected entry.", "Catalog entries merged");
            CloseIssue();
            await LoadAsync();
        }
        finally
        {
            saving = false;
        }
    }
    private async Task SnoozeIssueAsync(int days)
    {
        if (!canManage || saving || selected is not { Status: "open" } issue) return;
        saving = true;
        try
        {
            if (await AdminApi.ReviewIssuesAsync([issue.Id], "snooze", days) != 1)
            {
                Messages.Warning("Could not snooze this issue.");
                return;
            }
            Messages.Info($"Issue snoozed for {days} days.");
            CloseIssue();
            await LoadAsync();
        }
        finally { saving = false; }
    }

    private async Task DismissAsync() { if (!canManage || selected is null) return; saving = true; try { if (await AdminApi.DismissIssueAsync(selected.Id, resolutionNote)) { Messages.Info("The issue was dismissed and reporters were notified."); CloseIssue(); await LoadAsync(); } } finally { saving = false; } }
    private async Task ReopenAsync() { if (!canManage || selected is null) return; saving = true; try { if (await AdminApi.ReopenIssueAsync(selected.Id)) { await OpenIssueAsync(selected.Id); await LoadAsync(); } } finally { saving = false; } }
    private static string IssueLabel(string kind) => kind switch { "external-reader-link" => "External reader link", "mangadex-language-coverage" => "MangaDex language coverage", "mangadex-translation-abandoned" => "Translation coverage behind", "mangadex-release-stalled" => "MangaDex release stalled", "mangadex-identity-mismatch" => "MangaDex identity mismatch", "cover-image" => "Cover image", "catalog-metadata" => "Catalog metadata", "duplicate-catalog-id" => "Duplicate catalog ID", "catalog-registration-failure" => "Catalog registration failed", "maintenance-overdue" => "Maintenance overdue", "maintenance-failure" => "Maintenance failure", "archive-integrity" => "Archive integrity", _ => kind };
    private static string IssueIcon(string kind) => kind switch { "external-reader-link" => Icons.Material.Filled.LinkOff, "mangadex-language-coverage" or "mangadex-translation-abandoned" => Icons.Material.Filled.Translate, "mangadex-release-stalled" => Icons.Material.Filled.HourglassTop, "mangadex-identity-mismatch" => Icons.Material.Filled.LinkOff, "cover-image" => Icons.Material.Filled.BrokenImage, "catalog-metadata" => Icons.Material.Filled.EditNote, "duplicate-catalog-id" => Icons.Material.Filled.ContentCopy, "catalog-registration-failure" => Icons.Material.Filled.AppRegistration, "maintenance-overdue" or "maintenance-failure" => Icons.Material.Filled.BuildCircle, "archive-integrity" => Icons.Material.Filled.Inventory, _ => Icons.Material.Filled.ReportProblem };
    private static Color StatusColor(string value) => value == "resolved" ? Color.Success : value == "dismissed" ? Color.Secondary : Color.Error;
    private static int PriorityRank(string value) => value switch { "critical" => 0, "high" => 1, "normal" => 2, "low" => 3, _ => 4 };
    private static Color PriorityColor(string value) => value switch { "critical" => Color.Error, "high" => Color.Warning, "normal" => Color.Primary, _ => Color.Secondary };
    private static string PriorityLabel(string value) => value switch { "critical" => "Critical", "high" => "High", "normal" => "Normal", "low" => "Low", _ => "Normal" };
    private static string ReasonLabel(string reason) => reason switch { "create-failed" => "Registration failed", "language-coverage" => "Preferred language unavailable", "title" => "Wrong title", "description" => "Wrong description", "category" => "Wrong categories or format", "release-status" => "Wrong release status", "wrong-manga" => "Wrong manga", "wrong-image" => "Wrong cover", "missing" => "Cover missing", "low-quality" => "Poor image quality", "obsolete" => "Obsolete or unhelpful", "unsafe" => "Potentially unsafe", "broken" => "Broken link or image", _ => "Other problem" };
    private static string DisplayIdentifier(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static bool IsHttpUrl(string value) => Uri.TryCreate(value.Trim(), UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    private static string SearchUrl(string baseUrl, AdminIssueDetailsResponse issue) => baseUrl + Uri.EscapeDataString(issue.Title + " manga read");
    private static string BuildMangaDexSearchUrl(AdminIssueDetailsResponse issue) => string.IsNullOrWhiteSpace(issue.MangaDexId) ? SearchUrl("https://mangadex.org/search?q=", issue) : $"https://mangadex.org/title/{issue.MangaDexId}";
    private static string BuildMalSearchUrl(AdminIssueDetailsResponse issue) => string.IsNullOrWhiteSpace(issue.MyAnimeListId) ? SearchUrl("https://myanimelist.net/manga.php?q=", issue) : $"https://myanimelist.net/manga/{issue.MyAnimeListId}";
    private static string BuildMangaUpdatesSearchUrl(AdminIssueDetailsResponse issue) => string.IsNullOrWhiteSpace(issue.MangaUpdatesId) ? SearchUrl("https://www.mangaupdates.com/search.html?search=", issue) : $"https://www.mangaupdates.com/series/{issue.MangaUpdatesId}";
    private static string FormatChapter(System.Text.Json.JsonElement value) => value.TryGetDecimal(out var chapter)
        ? chapter.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)
        : value.ToString();
    private sealed record TranslationCoverageDetail(string LatestChapter, List<TranslationCoverageLanguageDetail> AffectedLanguages)
    {
        public decimal? HighestExternalLatestChapter => AffectedLanguages
            .Where(item => item.IncludesExternal && decimal.TryParse(item.ExternalLatestChapter, System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, out _))
            .Select(item => decimal.Parse(item.ExternalLatestChapter, System.Globalization.CultureInfo.InvariantCulture))
            .DefaultIfEmpty()
            .Max() is var latest && latest > 0m ? latest : null;
    }
    private sealed record TranslationCoverageLanguageDetail(string Languages, string LatestChapter, string Gap, bool IncludesExternal, string ExternalLatestChapter);
    private sealed record ReleaseStallDetail(string LatestChapter, string InactiveDays, string LastObserved, string ReferenceChapter, string ExternalChapter);
    private sealed record MangaDexIdentityMismatchDetail(string ExpectedMyAnimeListId, string LinkedMangaDexId, string LinkedMyAnimeListId, string LinkedTitle);
    private sealed record MaintenanceFailureDetail(string Type, string Trigger, string Error, string FailedAt);
    private sealed record ExternalReaderIssueDetail(string Heading, string Explanation, Severity Severity, bool IsMangaDexUnavailable, string PreviousMangaDexId);
