    private readonly CancellationTokenSource chatGptPolling = new();

    protected override async Task OnInitializedAsync()
    {
        user = await Auth.GetCurrentUserAsync();
        if (canManage && !chatGptPolling.IsCancellationRequested) _ = PollChatGptStatusAsync(chatGptPolling.Token);
        if (isAdmin) await LoadAsync();
        else loading = false;
    }

    private async Task PollChatGptStatusAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        var tick = 0;
        try
        {
            do
            {
                try
                {
                    if (scheduleOpen && !scheduleBusy)
                        proposalSchedule = await AdminApi.GetProposalScheduleAsync();
                    if (tick++ % 12 == 0)
                        chatGptStatus = await AdminApi.GetChatGptStatusAsync();
                }
                catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException) { }
                if (token.IsCancellationRequested) return;
                await InvokeAsync(StateHasChanged);
            }
            while (await timer.WaitForNextTickAsync(token));
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

