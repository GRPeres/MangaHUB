                @if (IsExternalReaderRepairIssue)
                {
                    @if (ShouldOfferReplacementExternalReader)
                    {
                        <MudTextField T="string" @bind-Value="replacementUrl" Label="@ExternalReaderReplacementLabel" HelperText="@ExternalReaderReplacementHelp" Variant="Variant.Outlined" Disabled="@(!IsOpen)" />
                        <MudStack Row="true" Spacing="1" Class="flex-wrap"><MudButton Href="@GoogleSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">Google</MudButton><MudButton Href="@DuckDuckGoSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">DuckDuckGo</MudButton><MudButton Href="@MangaDexSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">MangaDex</MudButton><MudButton Href="@MalSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">MAL</MudButton><MudButton Href="@MangaUpdatesSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">MangaUpdates</MudButton></MudStack>
                    }
                    @if (IsTranslationCoverageIssue && HasExistingFallbackReader)
                    {
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudStack Spacing="2">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">Verify the existing external reader</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">The shared source exists, but MangaHub only counts an external chapter after it has been confirmed. Record the newest chapter you verified there; the coverage check will resolve automatically once it is close enough.</MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
                                    <MudNumericField T="decimal?" @bind-Value="confirmedExternalLatestChapter" Label="Verified through chapter" Variant="Variant.Outlined" Min="0" Step="0.001m" Disabled="@(!canManage || !IsOpen || saving)" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!canManage || !IsOpen || saving || confirmedExternalLatestChapter is null)" OnClick="RecordExternalCoverageAsync">@(saving ? "Saving..." : "Record coverage")</MudButton>
                                    <MudButton Href="@selected.FallbackReaderUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">Open source</MudButton>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                }
                @if (IsCoverImageIssue)
                {
                    <MudTextField T="string" @bind-Value="replacementCoverUrl" Label="Replacement cover image URL" HelperText="Leave blank to intentionally remove the cover." Variant="Variant.Outlined" Disabled="@(!IsOpen)" />
                    <MudStack Row="true" Spacing="1" Class="flex-wrap"><MudButton Href="@GoogleSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">Google images</MudButton><MudButton Href="@DuckDuckGoSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">DuckDuckGo</MudButton><MudButton Href="@MalSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">MAL</MudButton><MudButton Href="@MangaDexSearchUrl" Target="_blank" Rel="noopener" Variant="Variant.Outlined">MangaDex</MudButton></MudStack>
                }
                @if (IsExternalReaderLinkIssue)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2">@MangaHubRecoveryTitle</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@MangaHubRecoveryHelp</MudText>
                            </MudStack>
                            <div class="mh-issue-metadata-anchor">
                                <MangaDebouncedSearch @bind-Value="metadataQuery"
                                                      Label="Find the correct manga on MyAnimeList"
                                                      AriaLabel="Search MyAnimeList metadata"
                                                      IsLoading="@isSearchingMetadata"
                                                      Disabled="@(!IsOpen || saving)"
                                                      OnSearch="SearchMetadataAsync" />
                                <MudPopover Open="@(isSearchingMetadata || metadataResults.Count > 0 || !string.IsNullOrWhiteSpace(metadataMessage))"
                                            AnchorOrigin="Origin.BottomLeft"
                                            TransformOrigin="Origin.TopLeft"
                                            Class="mh-issue-metadata-popover">
                                    <MudPaper Elevation="8" Outlined="true" Class="pa-2 mh-issue-metadata-results">
                                        @if (isSearchingMetadata)
                                        {
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><MudText Typo="Typo.caption">Searching MyAnimeList...</MudText></MudStack>
                                        }
                                        else if (metadataResults.Count > 0)
                                        {
                                            <MudStack Spacing="1">
                                                @foreach (var item in metadataResults.Take(6))
                                                {
                                                    <MudButton Variant="Variant.Text" Color="Color.Inherit" FullWidth="true" Class="justify-start text-left" Disabled="@saving" OnClick="() => ReintegrateWithMetadataAsync(item)">
                                                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="w-100">
                                                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl)) { <img src="@item.CoverUrl" alt="" class="mh-issue-metadata-cover" /> }
                                                            <MudStack Spacing="0" Class="flex-grow-1 overflow-hidden">
                                                                <MudText Typo="Typo.body2" Class="text-truncate">@item.Title</MudText>
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">MAL #@item.MyAnimeListId · @item.Authors</MudText>
                                                            </MudStack>
                                                        </MudStack>
                                                    </MudButton>
                                                }
                                            </MudStack>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(metadataMessage))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@metadataMessage</MudText>
                                        }
                                    </MudPaper>
                                </MudPopover>
                            </div>
                            @if (CanReintegrate)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap" Spacing="2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Catalog MAL ID: @selected.MyAnimeListId</MudText>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoFixHigh" Disabled="@saving" OnClick="ReintegrateWithMangaDexAsync">@(saving ? "Matching..." : "Try current MAL ID")</MudButton>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                }
                @if (IsDuplicateCatalogIssue && selected.DuplicateCatalogEntries is { Count: > 1 } duplicates)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudStack Spacing="0"><MudText Typo="Typo.subtitle2">Duplicate catalog identity</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Choose the record to keep. Shelf entries, progress, release state, notifications, and analytics references are moved into it before the other record is removed.</MudText></MudStack>
                            @foreach (var duplicate in duplicates)
                            {
                                <MudPaper Outlined="true" Class="pa-2 mh-duplicate-entry">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                                        @if (!string.IsNullOrWhiteSpace(duplicate.CoverUrl)) { <img src="@duplicate.CoverUrl" alt="" class="mh-duplicate-cover" /> }
                                        <MudStack Spacing="0" Class="flex-grow-1"><MudText Typo="Typo.subtitle2">@duplicate.Title</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">MAL: @DisplayIdentifier(duplicate.MyAnimeListId) · MangaDex: @DisplayIdentifier(duplicate.MangaDexId) · MangaUpdates: @DisplayIdentifier(duplicate.MangaUpdatesId)</MudText></MudStack>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.MergeType" Disabled="@(!IsOpen || saving)" OnClick="() => MergeDuplicatesAsync(duplicate.Id)">Keep this entry</MudButton>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudPaper>
                }
                <MudTextField T="string" @bind-Value="resolutionNote" Label="Resolution note" Lines="2" Variant="Variant.Outlined" Disabled="@(!IsOpen)" />
                <MudDivider />
                @foreach (var report in selected.Reports) { <MudPaper Outlined="true" Class="pa-2"><MudText Typo="Typo.subtitle2">@ReasonLabel(report.Reason)</MudText>@if (!string.IsNullOrWhiteSpace(report.Note)) { <MudText Typo="Typo.body2">@report.Note</MudText> }<MudText Typo="Typo.caption" Color="Color.Secondary">Reported URL: @report.SnapshotValue</MudText></MudPaper> }
                <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" Spacing="2">
                    @if (selected.Status == "open")
                    {
                        <MudMenu Label="Snooze" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Snooze" Disabled="@saving">
                            <MudMenuItem OnClick="() => SnoozeIssueAsync(7)">7 days</MudMenuItem>
                            <MudMenuItem OnClick="() => SnoozeIssueAsync(30)">30 days</MudMenuItem>
                            <MudMenuItem OnClick="() => SnoozeIssueAsync(90)">90 days</MudMenuItem>
                        </MudMenu>
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@saving" OnClick="DismissAsync">Dismiss</MudButton>
                        @if (CanResolveExternalReaderIssue)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@saving" OnClick="ResolveAsync">@(saving ? "Saving..." : "Save repair and resolve")</MudButton>
                        }
                        @if (IsCoverImageIssue)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@saving" OnClick="ResolveCoverAsync">@(saving ? "Saving..." : "Save cover and resolve")</MudButton>
                        }
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Disabled="@saving" OnClick="ReopenAsync">Reopen</MudButton>
                    }
                </MudStack>
            </MudStack>
        </section>
    </div>
}

@code {
    private UserResponse? user;
    private List<AdminIssueListItemResponse> items = [];
    private AdminIssueDetailsResponse? selected;
    private string status = "action";
    private readonly HashSet<Guid> checkedIssues = [];
    private int snoozeDays = 30;
    private bool hasMore;
    private const int PageSize = 40;
    private bool scheduleOpen;
    private bool scheduleBusy;
    private bool scheduleEnabled;
    private bool scheduleWebResearchEnabled;
    private int scheduleBatchAmount = 1;
    private int scheduleBatchUnit = 1440;
    private int scheduleRequestInterval;
    private int scheduleGroupSize;
    private AdminApiService.ProposalSchedule? proposalSchedule;

    private async Task RefreshProposalInboxAsync()
    {
        if (!canManage || scheduleBusy) return;
        scheduleBusy = true;
        try
        {
            proposalSchedule = await AdminApi.GetProposalScheduleAsync();
            chatGptStatus = await AdminApi.GetChatGptStatusAsync();
        }
        finally { scheduleBusy = false; }
    }

    private async Task OpenProposalScheduleAsync()
    {
        if (!canManage) return;
        scheduleOpen = true;
        scheduleBusy = true;
        try
        {
            proposalSchedule = await AdminApi.GetProposalScheduleAsync();
            chatGptStatus = await AdminApi.GetChatGptStatusAsync();
            if (proposalSchedule is not { } schedule) { Messages.Warning("Could not load proposal schedule."); return; }
            scheduleEnabled = schedule.Enabled;
            scheduleWebResearchEnabled = schedule.WebResearchEnabled;
            scheduleBatchUnit = schedule.BatchIntervalMinutes % 1440 == 0 ? 1440
                : schedule.BatchIntervalMinutes % 60 == 0 ? 60 : 1;
            scheduleBatchAmount = schedule.BatchIntervalMinutes / scheduleBatchUnit;
            scheduleRequestInterval = schedule.RequestIntervalSeconds;
            scheduleGroupSize = schedule.GroupSize;
        }
        finally { scheduleBusy = false; }
    }

    private async Task SaveProposalScheduleAsync()
    {
        if (!canManage || scheduleBusy) return;
        scheduleBusy = true;
        try
        {
            var interval = (long)scheduleBatchAmount * scheduleBatchUnit;
            if (interval is < 5 or > 43200)
            {
                Messages.Warning("Choose a batch interval between 5 minutes and 30 days.");
                return;
            }
            if (await AdminApi.SaveProposalScheduleAsync(scheduleEnabled, (int)interval, scheduleRequestInterval, scheduleGroupSize, scheduleWebResearchEnabled))
                await OpenProposalScheduleAsync();
            else Messages.Warning("Could not save proposal schedule.");
        }
        finally { scheduleBusy = false; }
    }

    private async Task ReviewScheduledDraftAsync(Guid id)
    {
        if (!canManage || scheduleBusy) return;
        scheduleBusy = true;
        try
        {
            if (await AdminApi.ReviewScheduledDraftAsync(id)) await OpenProposalScheduleAsync();
            else Messages.Warning("Could not mark the draft reviewed.");
        }
        finally { scheduleBusy = false; }
    }
    private static string? AdditionalDraftAction(AdminApiService.ScheduledDraft draft) => draft.Action switch
    {
        "refresh_chapters" => "Refresh this title's MangaDex chapters and recheck coverage.",
        "clear_hiatus" => "Clear the hiatus override and resume normal status sync.",
        "mark_complete" => "Set publication status to Completed without changing shelf progress.",
        "record_external" => $"Record the external listing through chapter {draft.ActionValue} ({draft.ActionLanguage}).",
        "repair_mal" => $"Replace the MyAnimeList ID with {draft.ActionValue}.",
        "repair_mangaupdates" => $"Replace the MangaUpdates ID with {draft.ActionValue} and refresh its chapter data.",
        _ => null
    };

    private async Task ApproveDraftAsync(Guid id)
    {
        if (!canManage || scheduleBusy) return;
        scheduleBusy = true;
        try
        {
            var result = await AdminApi.ApproveScheduledDraftAsync(id);
            if (result.Value is not { Applied: true } approval) { Messages.Warning(result.Error ?? "The proposal was not applied."); return; }
            if (approval.Warning is { } warning) Messages.Warning(warning);
            else Messages.Success("Proposal applied.");
            await LoadAsync();
            await OpenProposalScheduleAsync();
        }
        finally { scheduleBusy = false; }
    }

    private bool batchRunning;
    private int proposalLimit = 5;
    private int proposalDelay = 5;
    private bool manualWebResearch;
    private string? proposalRequestError;
    private IEnumerable<AdminIssueListItemResponse> ProposalCandidates => items.Where(item =>
        checkedIssues.Contains(item.Id) && item.Status == "open"
        && item.Kind is "mangadex-release-stalled" or "mangadex-identity-mismatch" or "mangadex-language-coverage");

    private Task RunProposalBatchAsync() => SubmitProposalBatchAsync(checkedIssues.ToArray(), manualWebResearch);

    private async Task StopProposalBatchAsync()
    {
        if (!await AdminApi.StopProposalBatchAsync()) Messages.Warning("Could not stop the proposal batch.");
        await RefreshProposalInboxAsync();
    }

    private async Task SubmitProposalBatchAsync(Guid[] issueIds, bool webResearch)
    {
        if (!canManage || batchRunning) return;
        batchRunning = true;
        proposalRequestError = null;
        try
        {
            var result = await AdminApi.StartProposalBatchAsync(issueIds, proposalLimit, proposalDelay, webResearch);
            if (result.Value is null)
                proposalRequestError = result.Error ?? "The proposal batch could not be started.";
            else
                Messages.Info("Proposal batch submitted. You can leave this page.");
            await RefreshProposalInboxAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException)
        {
            proposalRequestError = "Could not confirm the request. Refresh Current drafts before retrying.";
        }
        finally { batchRunning = false; }
    }

    private async Task SuggestRepairAsync()
    {
        if (!canManage || selected is not { } issue) return;
        CloseIssue();
        await OpenProposalScheduleAsync();
        await SubmitProposalBatchAsync([issue.Id], proposalSchedule?.WebResearchEnabled == true);
    }
    private IssueHealthResponse? health;
    private static string NextIssueAction(AdminIssueListItemResponse item) => item.Status != "open" ? "View issue history" : item.Kind switch
    {
        "mangadex-identity-mismatch" => "Review MangaDex link repair",
        "mangadex-release-stalled" => "Compare chapter evidence",
        "maintenance-failure" => "Inspect failure and retry",
        "external-reader-link" => "Review external reader link",
        _ => "Open issue"
    };

    private static string ReviewLabel(AdminIssueListItemResponse item) => item.Status switch
    {
        "resolved" when item.ReviewState == "auto_resolved" => "Auto-resolved",
        "resolved" => "Resolved",
        "dismissed" => "Dismissed",
        _ when item.SnoozedUntil > DateTimeOffset.UtcNow => "Snoozed",
        _ when item.ReviewState == "waiting" => "Waiting",
        _ when item.ReviewState == "monitoring" => "Monitoring",
        _ => "Action required"
    };

    private void SelectIssue(Guid id, bool value)
    {
        if (saving) return;
        repairPreview.Clear();
        if (!value) checkedIssues.Remove(id);
        else if (checkedIssues.Count < 100) checkedIssues.Add(id);
    }

    private async Task ReviewBatchAsync(bool dismiss)
        => await ApplyBatchAsync(dismiss ? "dismiss" : "snooze");

    private sealed record RepairPreview(Guid IssueId, string Title, string MalId, string? MatchId, string Message);
    private List<RepairPreview> repairPreview = [];

    private async Task PreviewRepairsAsync()
    {
        if (!canManage || saving || checkedIssues.Count is 0 or > 10) return;
        saving = true;
        repairPreview.Clear();
        try
        {
            foreach (var item in items.Where(item => checkedIssues.Contains(item.Id)).ToList())
            {
                var detail = await AdminApi.GetIssueAsync(item.Id);
                if (detail is null || detail.Status != "open" || string.IsNullOrWhiteSpace(detail.MyAnimeListId))
                {
                    repairPreview.Add(new(item.Id, item.Title, "", null, "No open issue with a usable MAL ID."));
                    continue;
                }
                var result = await AdminApi.RepairMangaDexIdentityAsync(item.Id, true, detail.MyAnimeListId);
                var match = result.Value;
                repairPreview.Add(new(item.Id, item.Title, detail.MyAnimeListId, match?.Id,
                    match is null ? result.Error ?? "No verified match." : $"{match.Title} ({match.Id})"));
            }
        }
        finally { saving = false; }
    }

    private async Task ConfirmRepairsAsync()
    {
        if (!canManage || saving) return;
        saving = true;
        try
        {
            var results = new List<RepairPreview>();
            foreach (var repair in repairPreview.ToList())
            {
                if (repair.MatchId is null) { results.Add(repair); continue; }
                var result = await AdminApi.RepairMangaDexIdentityAsync(repair.IssueId, false, repair.MalId, repair.MatchId);
                results.Add(repair with { MatchId = null, Message = result.Value is { } linked
                    ? $"Linked {linked.Title}." : result.Error ?? "Link not changed." });
            }
            await LoadAsync();
            repairPreview = results;
        }
        finally { saving = false; }
    }
    private Task DismissCurrentBatchAsync() => ApplyBatchAsync("dismiss_current");
    private Task UseExternalBatchAsync() => ApplyBatchAsync("use_external");

    private async Task RecheckBatchAsync()
    {
        if (!canManage || saving) return;
        saving = true;
        try
        {
            var jobs = new HashSet<string>();
            foreach (var item in items.Where(item => checkedIssues.Contains(item.Id)))
            {
                switch (item.Kind)
                {
                    case "mangadex-release-stalled": jobs.Add("mangadex-release-stall-check"); break;
                    case "mangadex-identity-mismatch": jobs.Add("mangadex-identity-audit"); break;
                    case "mangadex-language-coverage": jobs.Add("mangadex-language-coverage-check"); break;
                    case "maintenance-failure":
                        var detail = await AdminApi.GetIssueAsync(item.Id);
                        if (detail is null) break;
                        using (var metadata = System.Text.Json.JsonDocument.Parse(detail.MetadataJson))
                        {
                            if (metadata.RootElement.TryGetProperty("Type", out var value)
                                && value.GetString() is { } job && RetryableMaintenanceJobTypes.Contains(job))
                                jobs.Add(job);
                        }
                        break;
                }
            }
            var queued = 0;
            foreach (var job in jobs)
                if (await AdminApi.QueueMaintenanceJobAsync(job) is not null) queued++;
            if (queued > 0) Messages.Info($"Queued {queued} maintenance checks.");
            else Messages.Info("No automated check was queued for the selection.");
        }
        finally { saving = false; }
    }

    private async Task ApplyBatchAsync(string action)
    {
        if (!canManage || saving || checkedIssues.Count == 0) return;
        saving = true;
        try
        {
            var changed = await AdminApi.ReviewIssuesAsync(checkedIssues.ToArray(), action, snoozeDays);
            if (action == "use_external")
                Messages.Info($"Updated {changed} of {checkedIssues.Count} issues. Titles without a valid configured external reader were left unchanged.");
            else if (changed > 0) Messages.Info($"Updated {changed} issues.");
            else Messages.Error("No selected issues were updated.");
            await LoadAsync();
        }
        finally { saving = false; }
    }

    private async Task LoadMoreAsync()
    {
        if (loading || !hasMore) return;
        var currentStatus = status;
        hasMore = false;
        var page = await AdminApi.GetIssuesAsync(currentStatus, items.Count, PageSize);
        if (currentStatus != status || loading) return;
        items.AddRange(page.Where(next => items.All(item => item.Id != next.Id)));
        hasMore = page.Count == PageSize;
    }
