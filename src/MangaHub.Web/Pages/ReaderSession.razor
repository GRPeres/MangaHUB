@page "/reader/session/{EntryId:guid}"
@using MangaHub.Web.API.DTOs
@using MangaHub.Web.API.Services
@implements IDisposable
@inject MangaApiService MangaApi
@inject NavigationManager Navigation

<PageTitle>Reader</PageTitle>

@if (loading)
{
    <MudPaper Elevation="0" Outlined="true" Class="mh-reader-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <MudText Typo="Typo.body1">Preparing reader...</MudText>
    </MudPaper>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@error</MudAlert>
}
else if (options is not null)
{
    <MudStack Spacing="2" Class="mh-reader-shell">
        <MudPaper Elevation="0" Outlined="true" Class="mh-reader-session-toolbar">
            <MudStack Spacing="0" Class="mh-reader-title">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Embedded reader preview</MudText>
                <MudText Typo="Typo.h2">@options.Title</MudText>
            </MudStack>

            <MudStack Row="true" Spacing="1" Class="mh-reader-actions flex-wrap">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToShelf">Shelf</MudButton>
                @if (!string.IsNullOrWhiteSpace(ExternalUrl))
                {
                    <MudButton Href="@ExternalUrl" Target="_blank" Rel="noopener noreferrer" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.OpenInNew">
                        Open tab
                    </MudButton>
                }
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(ExternalUrl))
        {
            <section class="mh-reader-frame-wrap" aria-label="External reader frame">
                <iframe title="@($"{options.Title} external reader")"
                        src="@ExternalUrl"
                        class="mh-reader-frame"
                        referrerpolicy="strict-origin-when-cross-origin"
                        @onload="ExternalFrameLoaded"></iframe>

                @if (!externalFrameLoaded)
                {
                    <div class="mh-reader-frame-loading">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        <MudText Typo="Typo.body2">Trying to load the source inside MangaHub...</MudText>
                    </div>
                }
            </section>
        }
    </MudStack>
}

@if (showExternalFallback)
{
    <div class="mh-modal-backdrop" @onclick="DismissFallback">
        <section class="mh-modal mh-reader-fallback-modal" role="dialog" aria-modal="true" aria-labelledby="reader-fallback-title" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mh-modal-header">
                    <MudStack Spacing="1">
                        <MudText id="reader-fallback-title" Typo="Typo.h2">Reader may be blocked</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            This source did not load inside MangaHub quickly enough. It probably blocks embedded readers.
                        </MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="DismissFallback" aria-label="Close reader fallback" />
                </MudStack>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Open it in a new tab to keep reading. MangaHub will stay open, but automatic progress tracking will not work for that external tab.
                </MudAlert>

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="flex-wrap">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="DismissFallback">Keep trying here</MudButton>
                    <MudButton Href="@ExternalUrl" Target="_blank" Rel="noopener noreferrer" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.OpenInNew">
                        Open in new tab
                    </MudButton>
                </MudStack>
            </MudStack>
        </section>
    </div>
}

@code {
    [Parameter] public Guid EntryId { get; set; }

    private readonly CancellationTokenSource timeoutCancellation = new();
    private ReadOptions? options;
    private bool loading = true;
    private bool externalFrameLoaded;
    private bool showExternalFallback;
    private bool fallbackDismissed;
    private string error = "";
    private string ExternalUrl => options?.HasMangaDex == true ? options.MangaDexUrl : "";

    protected override async Task OnInitializedAsync()
    {
        options = await MangaApi.GetReadOptionsAsync(EntryId);
        loading = false;

        if (options is null)
        {
            error = "Could not load read options.";
            return;
        }

        if (options.HasLocal)
        {
            Navigation.NavigateTo(options.LocalReaderUrl, replace: true);
            return;
        }

        if (!options.HasMangaDex)
        {
            error = "No MangaDex URL or local series is registered for this manga yet.";
            return;
        }

        _ = WatchForBlockedFrame(timeoutCancellation.Token);
    }

    private void ExternalFrameLoaded()
    {
        externalFrameLoaded = true;
    }

    private async Task WatchForBlockedFrame(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), cancellationToken);
            if (!externalFrameLoaded && !fallbackDismissed)
            {
                showExternalFallback = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void BackToShelf() => Navigation.NavigateTo("/library");

    private void DismissFallback()
    {
        fallbackDismissed = true;
        showExternalFallback = false;
    }

    public void Dispose()
    {
        timeoutCancellation.Cancel();
        timeoutCancellation.Dispose();
    }
}
