@page "/reset-password"
@inject AuthApiService AuthApi
@inject MessageService Messages
@using MangaHub.Web.API.Services

<PageTitle>Reset password</PageTitle>

<MudStack Spacing="3" Class="mh-reset-password">
    <MudStack Spacing="1" Class="mh-page-title">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Account recovery</MudText>
        <MudText Typo="Typo.h1">Choose a new password</MudText>
    </MudStack>
    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudStack Spacing="2">
            @if (string.IsNullOrWhiteSpace(Token))
            {
                <MudAlert Severity="Severity.Error">This reset link is incomplete.</MudAlert>
            }
            else
            {
                <MudTextField T="string" @bind-Value="password" Label="New password" InputType="InputType.Password" Variant="Variant.Outlined" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Use 10+ characters with uppercase, lowercase, and a number.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@isSaving" OnClick="Reset">Save new password</MudButton>
            }
            @if (!string.IsNullOrWhiteSpace(feedback))
            {
                <MudAlert Severity="@severity" Variant="Variant.Outlined">@feedback</MudAlert>
            }
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    private string password = "";
    private string feedback = "";
    private Severity severity = Severity.Info;
    private bool isSaving;

    private async Task Reset()
    {
        isSaving = true;
        try
        {
            var result = await AuthApi.ResetPasswordAsync(Token!, password);
            severity = result.Value is null ? Severity.Error : Severity.Success;
            feedback = result.Value is null ? result.Error : "Password updated. You can now log in.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
