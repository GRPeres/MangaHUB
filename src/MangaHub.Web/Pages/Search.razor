@page "/search"
@using Microsoft.AspNetCore.Components.Forms
@inject MangaHubApiClient Api

<PageTitle>Register Manga</PageTitle>

<MudStack Spacing="4">
    <MudStack Spacing="1" Class="mh-page-title">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Catalog controlled</MudText>
        <MudText Typo="Typo.h1">Register Manga</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Admins add manga to the shared catalog. Users add existing catalog manga to their own shelf.
        </MudText>
    </MudStack>

    @if (currentUser is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Sign in first to manage your shelf.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="9">
                    <MudTextField T="string" @bind-Value="catalogQuery" Label="Search catalog" Variant="Variant.Outlined" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" FullWidth="true" OnClick="SearchCatalog">Search Catalog</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="readingStatus" Label="Shelf status" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("reading")">Reading</MudSelectItem>
                        <MudSelectItem T="string" Value="@("done")">Done</MudSelectItem>
                        <MudSelectItem T="string" Value="@("paused")">Paused</MudSelectItem>
                        <MudSelectItem T="string" Value="@("planned")">Planned</MudSelectItem>
                        <MudSelectItem T="string" Value="@("dropped")">Dropped</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudTextField T="string" @bind-Value="currentChapter" Label="Chapter" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudNumericField T="int?" @bind-Value="score" Label="Score" Variant="Variant.Outlined" Min="1" Max="5" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" @bind-Value="category" Label="Type / genre" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudTextField T="string" @bind-Value="notes" Label="Shelf notes" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="summary" Label="Summary" Variant="Variant.Outlined" Lines="3" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h3">Import shelf CSV</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Uses Status, Name + Link, Chapter, Tipo, Rating, and Summary columns.</MudText>
                    </MudStack>
                    <MudSwitch T="bool" @bind-Value="createMissingCatalogEntries" Color="Color.Primary" Label="Create missing catalog entries" Disabled="@(!IsAdmin)" />
                </MudStack>
                <InputFile OnChange="ImportShelfCsv" accept=".csv,text/csv" />
                @if (!string.IsNullOrWhiteSpace(importMessage))
                {
                    <MudAlert Severity="@importSeverity" Variant="Variant.Outlined">@importMessage</MudAlert>
                }
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(catalogMessage))
        {
            <MudAlert Severity="@catalogSeverity" Variant="Variant.Outlined">@catalogMessage</MudAlert>
        }

        <MudGrid Spacing="3">
            @foreach (var item in catalogResults)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="0" Outlined="true" Class="mh-card">
                        @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                        {
                            <MudImage Src="@item.CoverUrl" Alt="@($"{item.Title} cover")" Class="mh-cover" />
                        }
                        <MudCardContent>
                            <MudText Typo="Typo.overline" Color="Color.Secondary">@item.FirstPublishYear</MudText>
                            <MudText Typo="Typo.h3">@item.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Authors</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@item.IsInMyShelf"
                                       FullWidth="true"
                                       OnClick="() => AddCatalogToShelf(item)">
                                @(item.IsInMyShelf ? "Already in shelf" : "Add to shelf")
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        @if (IsAdmin)
        {
            <MudDivider />
            <MudStack Spacing="1" Class="mh-page-title">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Admin</MudText>
                <MudText Typo="Typo.h2">Add catalog manga from OpenLibrary</MudText>
            </MudStack>

            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="9">
                        <MudTextField T="string" @bind-Value="openLibraryQuery" Label="Search OpenLibrary" Variant="Variant.Outlined" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" md="3" Class="d-flex align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ManageSearch" FullWidth="true" Disabled="@isSearchingOpenLibrary" OnClick="SearchOpenLibrary">
                            @(isSearchingOpenLibrary ? "Searching..." : "Search OpenLibrary")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="5">
                        <MudTextField T="string" @bind-Value="mangaDexUrl" Label="MangaDex URL" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="localSeriesIdText" Label="Local scanned series" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">None</MudSelectItem>
                            @foreach (var series in localSeries)
                            {
                                <MudSelectItem T="string" Value="@series.Id.ToString()">@series.Title</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @if (!string.IsNullOrWhiteSpace(openLibraryMessage))
            {
                <MudAlert Severity="@openLibrarySeverity" Variant="Variant.Outlined">@openLibraryMessage</MudAlert>
            }

            <MudGrid Spacing="3">
                @foreach (var item in openLibraryResults)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="0" Outlined="true" Class="mh-card">
                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                            {
                                <MudImage Src="@item.CoverUrl" Alt="@($"{item.Title} cover")" Class="mh-cover" />
                            }
                            <MudCardContent>
                                <MudText Typo="Typo.overline" Color="Color.Secondary">@item.FirstPublishYear</MudText>
                                <MudText Typo="Typo.h3">@item.Title</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Authors</MudText>
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="() => CreateCatalogEntry(item)">Add to catalog</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    }
</MudStack>

@code {
    private UserResponse? currentUser;
    private bool IsAdmin => string.Equals(currentUser?.Role, "admin", StringComparison.OrdinalIgnoreCase);

    private string catalogQuery = "";
    private string catalogMessage = "";
    private Severity catalogSeverity = Severity.Info;
    private List<CatalogMangaResponse> catalogResults = [];

    private string readingStatus = "planned";
    private string currentChapter = "";
    private int? score;
    private string category = "";
    private string summary = "";
    private string notes = "";
    private bool createMissingCatalogEntries = true;
    private string importMessage = "";
    private Severity importSeverity = Severity.Info;

    private string openLibraryQuery = "";
    private string openLibraryMessage = "";
    private Severity openLibrarySeverity = Severity.Info;
    private bool isSearchingOpenLibrary;
    private List<OpenLibraryResult> openLibraryResults = [];

    private string mangaDexUrl = "";
    private string localSeriesIdText = "";
    private List<SeriesResponse> localSeries = [];

    protected override async Task OnInitializedAsync()
    {
        currentUser = await Api.MeAsync();
        catalogResults = await Api.GetCatalogAsync();
        localSeries = IsAdmin ? await Api.GetSeriesAsync() : [];
    }

    private async Task SearchCatalog()
    {
        catalogResults = await Api.GetCatalogAsync(catalogQuery);
        catalogSeverity = catalogResults.Count == 0 ? Severity.Warning : Severity.Success;
        catalogMessage = catalogResults.Count == 0 ? "No catalog manga matched your search." : $"Found {catalogResults.Count} catalog entries.";
    }

    private async Task AddCatalogToShelf(CatalogMangaResponse item)
    {
        var created = await Api.AddToShelfAsync(new AddToShelfRequest(item.Id, readingStatus, currentChapter, score, category, summary, notes));
        catalogSeverity = created is null ? Severity.Error : Severity.Success;
        catalogMessage = created is null ? "Could not add manga to your shelf." : $"Added {created.Title} to your shelf.";
        catalogResults = await Api.GetCatalogAsync(catalogQuery);
    }

    private async Task ImportShelfCsv(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var csv = await reader.ReadToEndAsync();
            var result = await Api.ImportShelfAsync(new ShelfImportRequest(csv, createMissingCatalogEntries));
            importSeverity = result is null ? Severity.Error : Severity.Success;
            importMessage = result is null
                ? "Import failed."
                : $"Imported {result.Imported} rows, created {result.CreatedCatalogEntries} catalog entries, updated {result.UpdatedShelfEntries}, skipped {result.Skipped}.";
            if (result?.Messages.Count > 0)
            {
                importMessage += " " + string.Join(" ", result.Messages);
            }
            catalogResults = await Api.GetCatalogAsync(catalogQuery);
        }
        catch
        {
            importSeverity = Severity.Error;
            importMessage = "Could not read the CSV file.";
        }
    }

    private async Task SearchOpenLibrary()
    {
        if (string.IsNullOrWhiteSpace(openLibraryQuery))
        {
            openLibraryResults = [];
            openLibrarySeverity = Severity.Info;
            openLibraryMessage = "Type a title before searching OpenLibrary.";
            return;
        }

        isSearchingOpenLibrary = true;
        openLibraryMessage = "";
        try
        {
            openLibraryResults = await Api.SearchOpenLibraryAsync(openLibraryQuery);
            openLibrarySeverity = openLibraryResults.Count == 0 ? Severity.Warning : Severity.Success;
            openLibraryMessage = openLibraryResults.Count == 0
                ? "OpenLibrary returned no matches."
                : $"Found {openLibraryResults.Count} OpenLibrary matches.";
        }
        catch
        {
            openLibraryResults = [];
            openLibrarySeverity = Severity.Error;
            openLibraryMessage = "OpenLibrary search failed. Try again in a moment.";
        }
        finally
        {
            isSearchingOpenLibrary = false;
        }
    }

    private async Task CreateCatalogEntry(OpenLibraryResult item)
    {
        var localSeriesId = Guid.TryParse(localSeriesIdText, out var parsed) ? parsed : (Guid?)null;
        var request = new MangaEntryRequest(
            item.Title,
            item.Authors,
            "",
            item.CoverUrl,
            item.Key,
            item.FirstPublishYear,
            "",
            mangaDexUrl,
            localSeriesId,
            "");

        var created = await Api.CreateCatalogMangaAsync(request);
        openLibrarySeverity = created is null ? Severity.Error : Severity.Success;
        openLibraryMessage = created is null ? "Catalog registration failed. Admin permissions are required." : $"Added {created.Title} to the catalog.";
        catalogResults = await Api.GetCatalogAsync(catalogQuery);
    }
}
