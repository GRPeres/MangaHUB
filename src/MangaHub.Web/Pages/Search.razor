@page "/search"
@using Microsoft.AspNetCore.Components.Forms
@inject MangaHubApiClient Api
@inject AuthState Auth

<PageTitle>Add Manga</PageTitle>

<MudStack Spacing="4">
    <MudStack Spacing="1" Class="mh-page-title">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Shelf control</MudText>
        <MudText Typo="Typo.h1">Add Manga</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@PageHint</MudText>
    </MudStack>

    @if (currentUser is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Sign in first to manage your shelf.</MudAlert>
    }
    else
    {
        <MudTabs Rounded="true" Border="true" Elevation="0">
            <MudTabPanel Text="Add to shelf" Icon="@Icons.Material.Filled.AutoStories">
                @ShelfTab()
            </MudTabPanel>

            @if (IsAdmin)
            {
                <MudTabPanel Text="Catalog" Icon="@Icons.Material.Filled.LibraryAdd">
                    @CatalogTab()
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudStack>

@code {
    private UserResponse? currentUser;
    private bool IsAdmin => string.Equals(currentUser?.Role, "admin", StringComparison.OrdinalIgnoreCase);
    private string PageHint => IsAdmin
        ? "Add existing catalog manga to your shelf, or switch to Catalog to register shared entries."
        : "Search the shared catalog and add manga to your personal shelf.";

    private string catalogQuery = "";
    private string catalogMessage = "";
    private Severity catalogSeverity = Severity.Info;
    private List<CatalogMangaResponse> catalogResults = [];
    private CatalogMangaResponse? selectedCatalogManga;
    private int shelfWizardStep = 1;
    private bool IsDoneStatus => string.Equals(readingStatus, "done", StringComparison.OrdinalIgnoreCase);

    private string readingStatus = "planned";
    private string currentChapter = "";
    private int? score;
    private string category = "";
    private string summary = "";
    private string notes = "";
    private string importMessage = "";
    private Severity importSeverity = Severity.Info;
    private string catalogImportMessage = "";
    private Severity catalogImportSeverity = Severity.Info;

    private string openLibraryQuery = "";
    private string openLibraryMessage = "";
    private Severity openLibrarySeverity = Severity.Info;
    private bool isSearchingOpenLibrary;
    private List<OpenLibraryResult> openLibraryResults = [];
    private OpenLibraryResult? selectedOpenLibraryManga;
    private int catalogWizardStep = 1;

    private string mangaDexUrl = "";
    private string coverUrlOverride = "";
    private string localSeriesIdText = "";
    private List<SeriesResponse> localSeries = [];

    protected override async Task OnInitializedAsync()
    {
        currentUser = await Auth.GetCurrentUserAsync();
        if (currentUser is null)
        {
            return;
        }

        catalogResults = await Api.GetCatalogAsync();
        localSeries = IsAdmin ? await Api.GetSeriesAsync() : [];
    }

    private RenderFragment ShelfTab() => @<MudStack Spacing="4">
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                <MudChip T="string" Color="@(shelfWizardStep == 1 ? Color.Primary : Color.Default)" Variant="@(shelfWizardStep == 1 ? Variant.Filled : Variant.Outlined)">1. Choose manga</MudChip>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Secondary" />
                <MudChip T="string" Color="@(shelfWizardStep == 2 ? Color.Primary : Color.Default)" Variant="@(shelfWizardStep == 2 ? Variant.Filled : Variant.Outlined)">2. Reading info</MudChip>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="9">
                    <MudTextField T="string" @bind-Value="catalogQuery" Label="Search catalog" Variant="Variant.Outlined" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" FullWidth="true" OnClick="SearchCatalog">Search</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (shelfWizardStep == 1)
        {
            @if (!string.IsNullOrWhiteSpace(catalogMessage))
            {
                <MudAlert Severity="@catalogSeverity" Variant="Variant.Outlined">@catalogMessage</MudAlert>
            }

            <MudGrid Spacing="3">
                @foreach (var item in catalogResults)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="0" Outlined="true" Class="mh-card">
                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                            {
                                <MudImage Src="@item.CoverUrl" Alt="@($"{item.Title} cover")" Class="mh-cover" />
                            }
                            <MudCardContent>
                                <MudText Typo="Typo.overline" Color="Color.Secondary">@item.FirstPublishYear</MudText>
                                <MudText Typo="Typo.h3">@item.Title</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Authors</MudText>
                                @if (!string.IsNullOrWhiteSpace(item.Category))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mt-2">@item.Category</MudChip>
                                }
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="@item.IsInMyShelf"
                                           FullWidth="true"
                                           OnClick="() => SelectCatalogManga(item)">
                                    @(item.IsInMyShelf ? "Already in shelf" : "Choose")
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (shelfWizardStep == 2 && selectedCatalogManga is not null)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudStack Spacing="3">
                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start" Class="flex-wrap">
                        @if (!string.IsNullOrWhiteSpace(selectedCatalogManga.CoverUrl))
                        {
                            <MudImage Src="@selectedCatalogManga.CoverUrl" Alt="@($"{selectedCatalogManga.Title} cover")" Class="mh-wizard-cover" />
                        }
                        <MudStack Spacing="1" Class="flex-grow-1">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">Selected manga</MudText>
                            <MudText Typo="Typo.h2">@selectedCatalogManga.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@selectedCatalogManga.Authors</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToCatalog">Choose another</MudButton>
                        </MudStack>
                    </MudStack>

                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="4">
                            <MudSelect T="string" @bind-Value="readingStatus" Label="Status" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@("reading")">Reading</MudSelectItem>
                                <MudSelectItem T="string" Value="@("done")">Done</MudSelectItem>
                                <MudSelectItem T="string" Value="@("paused")">Paused</MudSelectItem>
                                <MudSelectItem T="string" Value="@("planned")">Planned</MudSelectItem>
                                <MudSelectItem T="string" Value="@("dropped")">Dropped</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        @if (readingStatus != "planned")
                        {
                            <MudItem xs="12" md="3">
                                <MudTextField T="string" @bind-Value="currentChapter" Label="Current chapter" Variant="Variant.Outlined" />
                            </MudItem>
                        }
                        @if (IsDoneStatus)
                        {
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int?" @bind-Value="score" Label="Rating" Variant="Variant.Outlined" Min="1" Max="5" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField T="string" @bind-Value="category" Label="Type / genre" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string" @bind-Value="summary" Label="Final thoughts / summary" Variant="Variant.Outlined" Lines="3" />
                            </MudItem>
                        }
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="notes" Label="Notes" Variant="Variant.Outlined" Lines="2" />
                        </MudItem>
                    </MudGrid>

                    @if (!string.IsNullOrWhiteSpace(catalogMessage))
                    {
                        <MudAlert Severity="@catalogSeverity" Variant="Variant.Outlined">@catalogMessage</MudAlert>
                    }

                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="AddSelectedToShelf">Add to shelf</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="BackToCatalog">Back</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h3">Import shelf CSV</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Adds rows to your shelf only when the manga already exists in the catalog.</MudText>
                </MudStack>
                <InputFile OnChange="ImportShelfCsv" accept=".csv,text/csv" />
                @if (!string.IsNullOrWhiteSpace(importMessage))
                            {
                    <MudAlert Severity="@importSeverity" Variant="Variant.Outlined">@importMessage</MudAlert>
                            }
            </MudStack>
        </MudPaper>
    </MudStack>;

    private RenderFragment CatalogTab() => @<MudStack Spacing="4">
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                <MudChip T="string" Color="@(catalogWizardStep == 1 ? Color.Primary : Color.Default)" Variant="@(catalogWizardStep == 1 ? Variant.Filled : Variant.Outlined)">1. Find metadata</MudChip>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Secondary" />
                <MudChip T="string" Color="@(catalogWizardStep == 2 ? Color.Primary : Color.Default)" Variant="@(catalogWizardStep == 2 ? Variant.Filled : Variant.Outlined)">2. Confirm entry</MudChip>
            </MudStack>
        </MudPaper>

        @if (catalogWizardStep == 1)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h3">Find the catalog manga</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Search OpenLibrary first so the catalog starts with a clean title, cover, category, and summary.</MudText>
                    </MudStack>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="9">
                            <MudTextField T="string" @bind-Value="openLibraryQuery" Label="Search OpenLibrary" Variant="Variant.Outlined" Immediate="true" />
                        </MudItem>
                        <MudItem xs="12" md="3" Class="d-flex align-center">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ManageSearch" FullWidth="true" Disabled="@isSearchingOpenLibrary" OnClick="SearchOpenLibrary">
                                @(isSearchingOpenLibrary ? "Searching..." : "Search")
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </MudPaper>

            @if (!string.IsNullOrWhiteSpace(openLibraryMessage))
            {
                <MudAlert Severity="@openLibrarySeverity" Variant="Variant.Outlined">@openLibraryMessage</MudAlert>
            }

            @if (openLibraryResults.Count == 0 && string.IsNullOrWhiteSpace(openLibraryMessage))
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Search OpenLibrary to pick the metadata for the catalog entry.</MudAlert>
            }

            <MudGrid Spacing="3">
                @foreach (var item in openLibraryResults)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="0" Outlined="true" Class="mh-card">
                            @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                            {
                                <MudImage Src="@item.CoverUrl" Alt="@($"{item.Title} cover")" Class="mh-cover" />
                            }
                            <MudCardContent>
                                <MudText Typo="Typo.overline" Color="Color.Secondary">@item.FirstPublishYear</MudText>
                                <MudText Typo="Typo.h3">@item.Title</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Authors</MudText>
                                @if (!string.IsNullOrWhiteSpace(item.Category))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mt-2">@item.Category</MudChip>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <MudText Typo="Typo.body2" Class="mt-2 mh-card-summary">@item.Description</MudText>
                                }
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="() => SelectOpenLibraryManga(item)">Review entry</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (catalogWizardStep == 2 && selectedOpenLibraryManga is not null)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudStack Spacing="3">
                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start" Class="flex-wrap">
                        @if (!string.IsNullOrWhiteSpace(FirstNonEmpty(coverUrlOverride, selectedOpenLibraryManga.CoverUrl)))
                        {
                            <MudImage Src="@FirstNonEmpty(coverUrlOverride, selectedOpenLibraryManga.CoverUrl)" Alt="@($"{selectedOpenLibraryManga.Title} cover")" Class="mh-wizard-cover" />
                        }
                        <MudStack Spacing="1" Class="flex-grow-1">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">Catalog candidate</MudText>
                            <MudText Typo="Typo.h2">@selectedOpenLibraryManga.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@selectedOpenLibraryManga.Authors</MudText>
                            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                @if (selectedOpenLibraryManga.FirstPublishYear is not null)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@selectedOpenLibraryManga.FirstPublishYear</MudChip>
                                }
                                @if (!string.IsNullOrWhiteSpace(selectedOpenLibraryManga.Category))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@selectedOpenLibraryManga.Category</MudChip>
                                }
                            </MudStack>
                            @if (!string.IsNullOrWhiteSpace(selectedOpenLibraryManga.Description))
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">@selectedOpenLibraryManga.Description</MudText>
                            }
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToOpenLibrarySearch">Choose another</MudButton>
                        </MudStack>
                    </MudStack>

                    <MudDivider />

                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="5">
                            <MudTextField T="string" @bind-Value="mangaDexUrl" Label="MangaDex URL" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="5">
                            <MudTextField T="string" @bind-Value="coverUrlOverride" Label="Cover image URL override" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="string" @bind-Value="localSeriesIdText" Label="Local scanned series" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@("")">None</MudSelectItem>
                                @foreach (var series in localSeries)
                                {
                                    <MudSelectItem T="string" Value="@series.Id.ToString()">@series.Title</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    @if (!string.IsNullOrWhiteSpace(openLibraryMessage))
                    {
                        <MudAlert Severity="@openLibrarySeverity" Variant="Variant.Outlined">@openLibraryMessage</MudAlert>
                    }

                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.LibraryAdd" OnClick="CreateSelectedCatalogEntry">Add to catalog</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="BackToOpenLibrarySearch">Back</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h3">Import CSV into catalog</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Creates missing catalog entries from the CSV, then adds those manga to your shelf.</MudText>
                </MudStack>
                <InputFile OnChange="ImportCatalogCsv" accept=".csv,text/csv" />
                @if (!string.IsNullOrWhiteSpace(catalogImportMessage))
                {
                    <MudAlert Severity="@catalogImportSeverity" Variant="Variant.Outlined">@catalogImportMessage</MudAlert>
                }
            </MudStack>
        </MudPaper>
    </MudStack>;

    private async Task SearchCatalog()
    {
        catalogResults = await Api.GetCatalogAsync(catalogQuery);
        catalogSeverity = catalogResults.Count == 0 ? Severity.Warning : Severity.Success;
        catalogMessage = catalogResults.Count == 0 ? "No catalog manga matched your search." : $"Found {catalogResults.Count} catalog entries.";
    }

    private void SelectCatalogManga(CatalogMangaResponse item)
    {
        selectedCatalogManga = item;
        shelfWizardStep = 2;
        catalogMessage = "";
        readingStatus = "planned";
        currentChapter = "";
        score = null;
        category = "";
        summary = "";
        notes = "";
    }

    private void BackToCatalog()
    {
        shelfWizardStep = 1;
        selectedCatalogManga = null;
        catalogMessage = "";
    }

    private async Task AddSelectedToShelf()
    {
        if (selectedCatalogManga is null)
        {
            catalogSeverity = Severity.Warning;
            catalogMessage = "Choose a manga first.";
            shelfWizardStep = 1;
            return;
        }

        var request = new AddToShelfRequest(
            selectedCatalogManga.Id,
            readingStatus,
            readingStatus == "planned" ? "" : currentChapter,
            IsDoneStatus ? score : null,
            IsDoneStatus ? category : "",
            IsDoneStatus ? summary : "",
            notes);

        var created = await Api.AddToShelfAsync(request);
        catalogSeverity = created is null ? Severity.Error : Severity.Success;
        catalogMessage = created is null ? "Could not add manga to your shelf." : $"Added {created.Title} to your shelf.";
        catalogResults = await Api.GetCatalogAsync(catalogQuery);
        if (created is not null)
        {
            BackToCatalog();
        }
    }

    private void SelectOpenLibraryManga(OpenLibraryResult item)
    {
        selectedOpenLibraryManga = item;
        catalogWizardStep = 2;
        openLibraryMessage = "";
    }

    private void BackToOpenLibrarySearch()
    {
        selectedOpenLibraryManga = null;
        catalogWizardStep = 1;
        openLibraryMessage = "";
    }

    private async Task ImportShelfCsv(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var csv = await reader.ReadToEndAsync();
            var result = await Api.ImportShelfAsync(new ShelfImportRequest(csv, false));
            importSeverity = result is null ? Severity.Error : Severity.Success;
            importMessage = result is null
                ? "Import failed."
                : $"Imported {result.Imported} rows, created {result.CreatedCatalogEntries} catalog entries, updated {result.UpdatedShelfEntries}, skipped {result.Skipped}.";
            if (result?.Messages.Count > 0)
            {
                importMessage += " " + string.Join(" ", result.Messages);
            }
            catalogResults = await Api.GetCatalogAsync(catalogQuery);
        }
        catch
        {
            importSeverity = Severity.Error;
            importMessage = "Could not read the CSV file.";
        }
    }

    private async Task ImportCatalogCsv(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var csv = await reader.ReadToEndAsync();
            var result = await Api.ImportShelfAsync(new ShelfImportRequest(csv, true));
            catalogImportSeverity = result is null ? Severity.Error : Severity.Success;
            catalogImportMessage = result is null
                ? "Catalog import failed."
                : $"Imported {result.Imported} rows, created {result.CreatedCatalogEntries} catalog entries, updated {result.UpdatedShelfEntries}, skipped {result.Skipped}.";
            if (result?.Messages.Count > 0)
            {
                catalogImportMessage += " " + string.Join(" ", result.Messages);
            }
            catalogResults = await Api.GetCatalogAsync(catalogQuery);
        }
        catch
        {
            catalogImportSeverity = Severity.Error;
            catalogImportMessage = "Could not read the CSV file.";
        }
    }

    private async Task SearchOpenLibrary()
    {
        if (string.IsNullOrWhiteSpace(openLibraryQuery))
        {
            openLibraryResults = [];
            openLibrarySeverity = Severity.Info;
            openLibraryMessage = "Type a title before searching OpenLibrary.";
            return;
        }

        isSearchingOpenLibrary = true;
        openLibraryMessage = "";
        try
        {
            openLibraryResults = await Api.SearchOpenLibraryAsync(openLibraryQuery);
            selectedOpenLibraryManga = null;
            catalogWizardStep = 1;
            openLibrarySeverity = openLibraryResults.Count == 0 ? Severity.Warning : Severity.Success;
            openLibraryMessage = openLibraryResults.Count == 0
                ? "OpenLibrary returned no matches."
                : $"Found {openLibraryResults.Count} OpenLibrary matches.";
        }
        catch
        {
            openLibraryResults = [];
            openLibrarySeverity = Severity.Error;
            openLibraryMessage = "OpenLibrary search failed. Try again in a moment.";
        }
        finally
        {
            isSearchingOpenLibrary = false;
        }
    }

    private async Task CreateSelectedCatalogEntry()
    {
        if (selectedOpenLibraryManga is null)
        {
            openLibrarySeverity = Severity.Warning;
            openLibraryMessage = "Choose an OpenLibrary result first.";
            catalogWizardStep = 1;
            return;
        }

        await CreateCatalogEntry(selectedOpenLibraryManga);
    }

    private async Task CreateCatalogEntry(OpenLibraryResult item)
    {
        var localSeriesId = Guid.TryParse(localSeriesIdText, out var parsed) ? parsed : (Guid?)null;
        var request = new MangaEntryRequest(
            item.Title,
            item.Authors,
            item.Category,
            item.Description,
            FirstNonEmpty(coverUrlOverride, item.CoverUrl),
            item.Key,
            item.FirstPublishYear,
            "",
            mangaDexUrl,
            localSeriesId,
            "");

        var created = await Api.CreateCatalogMangaAsync(request);
        openLibrarySeverity = created is null ? Severity.Error : Severity.Success;
        openLibraryMessage = created is null ? "Catalog registration failed. Admin permissions are required." : $"Added {created.Title} to the catalog.";
        catalogResults = await Api.GetCatalogAsync(catalogQuery);
        if (created is not null)
        {
            selectedOpenLibraryManga = null;
            catalogWizardStep = 1;
            openLibraryResults = [];
            openLibraryQuery = "";
            mangaDexUrl = "";
            coverUrlOverride = "";
            localSeriesIdText = "";
        }
    }

    private static string FirstNonEmpty(params string[] values) =>
        values.Select(x => x.Trim()).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "";
}
