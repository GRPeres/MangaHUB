@page "/search"
@inject MangaHubApiClient Api

<PageTitle>Register Manga</PageTitle>

<MudStack Spacing="4">
    <MudStack Spacing="1" Class="mh-page-title">
        <MudText Typo="Typo.overline" Color="Color.Secondary">OpenLibrary metadata</MudText>
        <MudText Typo="Typo.h1">Register Manga</MudText>
    </MudStack>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="9">
                <MudTextField T="string" @bind-Value="query" Label="Search OpenLibrary" Variant="Variant.Outlined" Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" FullWidth="true" OnClick="SearchNow">Search</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="readingStatus" Label="Status" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("reading")">Reading</MudSelectItem>
                    <MudSelectItem T="string" Value="@("done")">Done</MudSelectItem>
                    <MudSelectItem T="string" Value="@("planned")">Planned</MudSelectItem>
                    <MudSelectItem T="string" Value="@("dropped")">Dropped</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="5">
                <MudTextField T="string" @bind-Value="mangaDexUrl" Label="MangaDex URL" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="localSeriesIdText" Label="Local scanned series" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("")">None</MudSelectItem>
                    @foreach (var series in localSeries)
                    {
                        <MudSelectItem T="string" Value="@series.Id.ToString()">@series.Title</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="notes" Label="Notes" Variant="Variant.Outlined" Lines="2" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="3">
        @foreach (var item in results)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="0" Outlined="true" Class="mh-card">
                    @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                    {
                        <MudImage Src="@item.CoverUrl" Alt="@($"{item.Title} cover")" Class="mh-cover" />
                    }
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@item.FirstPublishYear</MudText>
                        <MudText Typo="Typo.h3">@item.Title</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Authors</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="() => Register(item)">Register</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="@messageSeverity" Variant="Variant.Outlined">@message</MudAlert>
    }
</MudStack>

@code {
    private string query = "";
    private string readingStatus = "planned";
    private string mangaDexUrl = "";
    private string localSeriesIdText = "";
    private string notes = "";
    private string message = "";
    private Severity messageSeverity = Severity.Info;
    private List<OpenLibraryResult> results = [];
    private List<SeriesResponse> localSeries = [];

    protected override async Task OnInitializedAsync()
    {
        localSeries = await Api.GetSeriesAsync();
    }

    private async Task SearchNow()
    {
        results = string.IsNullOrWhiteSpace(query) ? [] : await Api.SearchOpenLibraryAsync(query);
    }

    private async Task Register(OpenLibraryResult item)
    {
        var localSeriesId = Guid.TryParse(localSeriesIdText, out var parsed) ? parsed : (Guid?)null;
        var request = new MangaEntryRequest(
            item.Title,
            item.Authors,
            "",
            item.CoverUrl,
            item.Key,
            item.FirstPublishYear,
            readingStatus,
            mangaDexUrl,
            localSeriesId,
            notes);

        var created = await Api.CreateMangaEntryAsync(request);
        messageSeverity = created is null ? Severity.Error : Severity.Success;
        message = created is null ? "Registration failed." : $"Registered {created.Title}.";
    }
}
