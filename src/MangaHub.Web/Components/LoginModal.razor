@if (Open)
{
    <div class="mh-modal-backdrop" @onclick="Close">
        <section class="mh-modal mh-login-modal" role="dialog" aria-modal="true" aria-labelledby="login-modal-title" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mh-modal-header">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Account required</MudText>
                        <MudText id="login-modal-title" Typo="Typo.h2">Log in to continue</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Message</MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="Close" aria-label="Close login" />
                </MudStack>

                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="username" Label="Username or email" Variant="Variant.Outlined" AutoFocus="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" />
                    </MudItem>
                    @if (isRegistering)
                    {
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="email" Label="Recovery email" InputType="InputType.Email" Variant="Variant.Outlined" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Use 10+ characters with upper/lowercase letters and a number.</MudText>
                        </MudItem>
                    }
                </MudGrid>

                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    @if (isRegistering)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="@isBusy" OnClick="Register">Create account</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@isBusy" OnClick="ToggleRegister">I already have an account</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" Disabled="@isBusy" OnClick="Login">@(isBusy ? "Signing in..." : "Log in")</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="@isBusy" OnClick="ToggleRegister">Create account</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@isBusy" OnClick="ForgotPassword">Forgot password?</MudButton>
                    }
                </MudStack>
                <MudDivider />
                <MudButton Href="/auth/google" Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Custom.Brands.Google">Continue with Google</MudButton>

                @if (!string.IsNullOrWhiteSpace(feedback))
                {
                    <MudAlert Severity="@feedbackSeverity" Variant="Variant.Outlined">@feedback</MudAlert>
                }
            </MudStack>
        </section>
    </div>
}
