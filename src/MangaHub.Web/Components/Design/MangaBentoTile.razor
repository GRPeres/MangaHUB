<BzBentoItem ColSpan="@ColSpan" RowSpan="@RowSpan">
    <section class="@TileClass"
             role="@Role"
             tabindex="@TabIndex"
             aria-label="@AriaLabel"
             @onclick="OnClick"
             @onkeydown="HandleKeyDown">
        @if (!string.IsNullOrWhiteSpace(CornerIcon))
        {
            <MudIcon Icon="@CornerIcon" Class="mh-bento-corner-icon" />
        }

        @ChildContent
    </section>
</BzBentoItem>
