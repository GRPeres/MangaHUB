@if (Open)
{
    <div class="mh-modal-backdrop">
        <section class="mh-modal mh-reader-preparing-modal" role="status" aria-live="polite">
            <MudStack Spacing="3" AlignItems="AlignItems.Center">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h3">@Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Message</MudText>
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mh-reader-preparing-progress" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mh-reader-preparing-steps">
                    Loading MangaDex details - Downloading chapter pages - Building the local reader file
                </MudText>
            </MudStack>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = "Preparing your chapter";
    [Parameter] public string Message { get; set; } = "MangaHub is fetching the chapter into your local reader cache.";
}
