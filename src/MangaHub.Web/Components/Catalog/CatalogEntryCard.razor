<MudCard Elevation="0" Outlined="true" Class="mh-row-card">
    <MudGrid Spacing="0" Class="mh-row-grid">
        <MudItem xs="12" md="2">
            <MangaCoverBlock CoverUrl="@Entry.CoverUrl"
                             AltText="@($"{Entry.Title} cover")"
                             PlaceholderIcon="@Icons.Material.Filled.Inventory2" />
        </MudItem>

        <MudItem xs="12" md="10">
            <MudCardContent Class="mh-row-content mh-row-bento">
                <MangaBlockGrid Variant="card">
                    <MangaBlockItem Size="MangaBlockSize.Feature">
                        <MudPaper Elevation="0" Outlined="true" Class="mh-bento-summary">
                            <MangaSummaryBlock Title="@Entry.Title" Subtitle="@Entry.Authors" Summary="@Entry.Description" />
                        </MudPaper>
                    </MangaBlockItem>

                    @if (!string.IsNullOrWhiteSpace(SourceLabel))
                    {
                        <MangaBlockItem Size="MangaBlockSize.Tall">
                            <MangaInfoBlock Label="Source"
                                            Value="@SourceLabel"
                                            Icon="@Icons.Material.Filled.TravelExplore"
                                            Active="@IsSourceFilterActive"
                                            OnClick="FilterBySource" />
                        </MangaBlockItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(Entry.Category))
                    {
                        <MangaBlockItem Size="MangaBlockSize.Wide">
                            <MangaInfoBlock Label="Category" Value="@Entry.Category" Icon="@Icons.Material.Filled.Category" />
                        </MangaBlockItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(Entry.MediaType))
                    {
                        <MangaBlockItem>
                            <MangaInfoBlock Label="Format" Value="@Entry.MediaType" Icon="@Icons.Material.Filled.Style" />
                        </MangaBlockItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(Entry.PublishingStatus))
                    {
                        <MangaBlockItem Size="MangaBlockSize.Wide">
                            <MangaInfoBlock Label="Release" Value="@Entry.PublishingStatus" Icon="@Icons.Material.Filled.Update" Tone="progress" />
                        </MangaBlockItem>
                    }
                    @if (Entry.FirstPublishYear is not null)
                    {
                        <MangaBlockItem>
                            <MangaInfoBlock Label="First year" Value="@FirstPublishYearLabel" Icon="@Icons.Material.Filled.CalendarMonth" />
                        </MangaBlockItem>
                    }
                    @if (Entry.IsInMyShelf)
                    {
                        <MangaBlockItem Size="MangaBlockSize.Wide">
                            <MangaInfoBlock Label="Shelf" Value="In your list" Icon="@Icons.Material.Filled.CheckCircle" Tone="success" />
                        </MangaBlockItem>
                    }

                    @if (Entry.ChapterCount is not null)
                    {
                        <MangaBlockItem Size="MangaBlockSize.Wide">
                            <MangaInfoBlock Label="Chapters" Value="@ChapterCountLabel" Icon="@Icons.Material.Filled.FormatListNumbered" Tone="progress" />
                        </MangaBlockItem>
                    }
                    @if (Entry.VolumeCount is not null)
                    {
                        <MangaBlockItem>
                            <MangaInfoBlock Label="Volumes" Value="@VolumeCountLabel" Icon="@Icons.Material.Filled.CollectionsBookmark" />
                        </MangaBlockItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(AvailabilityLabel))
                    {
                        <MangaBlockItem Size="MangaBlockSize.Wide">
                            <MangaInfoBlock Label="Read from" Value="@AvailabilityLabel" Icon="@Icons.Material.Filled.AutoStories" />
                        </MangaBlockItem>
                    }

                    <MangaBlockItem Size="MangaBlockSize.Wide">
                        <MudPaper Elevation="0" Outlined="true" Class="mh-bento-actions">
                            <MangaCardActions>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="Edit">Edit metadata</MudButton>
                            </MangaCardActions>
                        </MudPaper>
                    </MangaBlockItem>
                </MangaBlockGrid>
            </MudCardContent>
        </MudItem>
    </MudGrid>
</MudCard>
