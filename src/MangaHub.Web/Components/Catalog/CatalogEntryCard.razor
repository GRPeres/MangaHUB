<MudCard Elevation="0" Outlined="true" Class="mh-row-card">
    <MudGrid Spacing="0" Class="mh-row-grid">
        <MudItem xs="12" md="2">
            <MangaCoverBlock CoverUrl="@Entry.CoverUrl"
                             AltText="@($"{Entry.Title} cover")"
                             PlaceholderIcon="@Icons.Material.Filled.Inventory2" />
        </MudItem>

        <MudItem xs="12" md="5">
            <MudCardContent Class="mh-row-content mh-row-content-main">
                <MangaSummaryBlock Title="@Entry.Title" Subtitle="@Entry.Authors" Summary="@Entry.Description" />
            </MudCardContent>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudCardContent Class="mh-row-content">
                <MangaBlockGrid>
                    @if (!string.IsNullOrWhiteSpace(SourceLabel))
                    {
                        <MangaInfoBlock Label="Source"
                                        Value="@SourceLabel"
                                        Icon="@Icons.Material.Filled.TravelExplore"
                                        Tone="source"
                                        Class="mh-lego-hero"
                                        Active="@IsSourceFilterActive"
                                        OnClick="FilterBySource" />
                    }
                    @if (!string.IsNullOrWhiteSpace(Entry.Category))
                    {
                        <MangaInfoBlock Label="Category" Value="@Entry.Category" Icon="@Icons.Material.Filled.Category" Class="mh-lego-wide" />
                    }
                    @if (!string.IsNullOrWhiteSpace(Entry.MediaType))
                    {
                        <MangaInfoBlock Label="Format" Value="@Entry.MediaType" Icon="@Icons.Material.Filled.Style" Class="mh-lego-small" />
                    }
                    @if (!string.IsNullOrWhiteSpace(Entry.PublishingStatus))
                    {
                        <MangaInfoBlock Label="Release" Value="@Entry.PublishingStatus" Icon="@Icons.Material.Filled.Update" Tone="progress" Class="mh-lego-wide" />
                    }
                    @if (Entry.FirstPublishYear is not null)
                    {
                        <MangaInfoBlock Label="First year" Value="@FirstPublishYearLabel" Icon="@Icons.Material.Filled.CalendarMonth" Class="mh-lego-small" />
                    }
                    @if (Entry.IsInMyShelf)
                    {
                        <MangaInfoBlock Label="Shelf" Value="In your list" Icon="@Icons.Material.Filled.CheckCircle" Tone="success" Class="mh-lego-wide" />
                    }
                </MangaBlockGrid>
            </MudCardContent>
        </MudItem>

        <MudItem xs="12" md="2">
            <MudCardContent Class="mh-row-content mh-row-side">
                <MangaBlockGrid Variant="side">
                    @if (Entry.ChapterCount is not null)
                    {
                        <MangaInfoBlock Label="Chapters" Value="@ChapterCountLabel" Icon="@Icons.Material.Filled.FormatListNumbered" Tone="progress" Class="mh-lego-wide" />
                    }
                    @if (Entry.VolumeCount is not null)
                    {
                        <MangaInfoBlock Label="Volumes" Value="@VolumeCountLabel" Icon="@Icons.Material.Filled.CollectionsBookmark" Class="mh-lego-small" />
                    }
                    @if (!string.IsNullOrWhiteSpace(AvailabilityLabel))
                    {
                        <MangaInfoBlock Label="Read from" Value="@AvailabilityLabel" Icon="@Icons.Material.Filled.AutoStories" Class="mh-lego-wide" />
                    }
                </MangaBlockGrid>

                <MangaCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="Edit">Edit metadata</MudButton>
                </MangaCardActions>
            </MudCardContent>
        </MudItem>
    </MudGrid>
</MudCard>
