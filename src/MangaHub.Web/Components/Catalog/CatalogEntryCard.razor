<MudCard Elevation="0" Outlined="true" Class="mh-row-card">
    <div class="mh-cover-frame">
        @if (!string.IsNullOrWhiteSpace(Entry.CoverUrl))
        {
            <MudImage Src="@Entry.CoverUrl" Alt="@($"{Entry.Title} cover")" Class="mh-row-cover" />
        }
        else
        {
            <div class="mh-cover-placeholder" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
            </div>
        }
        <div class="mh-cover-caption">
            <span>First published</span>
            <strong>@FirstYearLabel</strong>
        </div>
    </div>

    <MudCardContent Class="mh-bento-card-content">
        <MangaBento Columns="5" ItemMinHeight="52" RowHeight="52" Class="mh-entry-bento">
            <MangaBentoTile ColSpan="4" RowSpan="4" Scheme="soft">
                <div class="mh-entry-main">
                    <div class="mh-entry-topline">
                        <div class="mh-title-block">
                            <MudText Typo="Typo.h3" Class="mh-row-title">@Entry.Title</MudText>
                            @if (!string.IsNullOrWhiteSpace(Entry.Authors))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@Entry.Authors</MudText>
                            }
                        </div>

                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mh-primary-tags flex-wrap">
                            @if (!string.IsNullOrWhiteSpace(Entry.Category))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@Entry.Category</MudChip>
                            }
                        </MudStack>
                    </div>

                @if (!string.IsNullOrWhiteSpace(Entry.Description))
                {
                    <MudText Typo="Typo.body2" Class="mh-row-summary">@Entry.Description</MudText>
                }

                    <div class="mh-entry-context mh-mobile-hide">
                        <div>
                            <span>Catalog refs</span>
                            <strong>@CatalogReferenceLabel</strong>
                        </div>
                        <div>
                            <span>Reader setup</span>
                            <strong>@ReaderLinksLabel</strong>
                        </div>
                        <div>
                            <span>Shelf state</span>
                            <strong>@ShelfAvailabilityLabel</strong>
                        </div>
                    </div>

                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="@SourceScheme" OnClick="FilterBySource" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Source</MudText>
                    <MudText Typo="Typo.h3">@SourceLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">@SourceFilterHint</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="secondary" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Chapters</MudText>
                    <strong>@ChapterCountLabel</strong>
                    <span class="mh-mobile-hide">Current count</span>
                </div>
            </MangaBentoTile>

         @*    <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="soft" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Volumes</MudText>
                    <MudText Typo="Typo.h3">@VolumeCountLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Current count</MudText>
                </div>
            </MangaBentoTile> *@

            @* <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="primary" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Format</MudText>
                    <MudText Typo="Typo.h3">@FormatLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">@Entry.Category</MudText>
                </div>
            </MangaBentoTile> *@

            @* <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="warm" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Status</MudText>
                    <MudText Typo="Typo.h3">@PublishingLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Release</MudText>
                </div>
            </MangaBentoTile> *@

        </MangaBento>

        <MudCardActions Class="mh-bento-card-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="Edit">Edit metadata</MudButton>
        </MudCardActions>
    </MudCardContent>
</MudCard>
