<MudCard Elevation="0" Outlined="true" Class="mh-row-card">
    <MudCardContent Class="mh-bento-card-content">
        <MangaBento Columns="8" ItemMinHeight="52" RowHeight="52" Class="mh-entry-bento">
            <MangaBentoTile ColSpan="2" RowSpan="4" Scheme="ink" Class="mh-entry-cover-tile">
                <div class="mh-cover-frame">
                @if (!string.IsNullOrWhiteSpace(Entry.CoverUrl))
                {
                    <MudImage Src="@Entry.CoverUrl" Alt="@($"{Entry.Title} cover")" Class="mh-row-cover" />
                }
                else
                {
                    <div class="mh-cover-placeholder" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                    </div>
                }
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="4" RowSpan="4" Scheme="soft">
                <div class="mh-entry-main">
                    <div class="mh-entry-topline">
                        <div class="mh-title-block">
                            <MudText Typo="Typo.h3" Class="mh-row-title">@Entry.Title</MudText>
                            @if (!string.IsNullOrWhiteSpace(Entry.Authors))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@Entry.Authors</MudText>
                            }
                        </div>

                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mh-primary-tags flex-wrap">
                            @if (!string.IsNullOrWhiteSpace(SourceLabel))
                            {
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@SourceColor"
                                         Variant="@SourceVariant"
                                         Class="mh-click-chip"
                                         OnClick="FilterBySource">@SourceLabel</MudChip>
                            }
                            @if (!string.IsNullOrWhiteSpace(Entry.Category))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@Entry.Category</MudChip>
                            }
                            @if (Entry.IsInMyShelf)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">In shelf</MudChip>
                            }
                        </MudStack>
                    </div>

                    <MudStack Row="true" Spacing="1" Class="mh-chip-row mh-secondary-tags flex-wrap">
                        @if (!string.IsNullOrWhiteSpace(Entry.MediaType))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Entry.MediaType</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(Entry.PublishingStatus))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Entry.PublishingStatus</MudChip>
                        }
                        @if (Entry.FirstPublishYear is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Entry.FirstPublishYear</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(Entry.MangaDexUrl))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">MangaDex</MudChip>
                        }
                        @if (Entry.LocalSeriesId is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Local files</MudChip>
                        }
                    </MudStack>

                @if (!string.IsNullOrWhiteSpace(Entry.Description))
                {
                    <MudText Typo="Typo.body2" Class="mh-row-summary mh-mobile-hide">@Entry.Description</MudText>
                }
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="2" RowSpan="2" Scheme="@SourceScheme" CornerIcon="@Icons.Material.Filled.TravelExplore" OnClick="FilterBySource" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Source</MudText>
                    <MudText Typo="Typo.h3">@SourceLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Click to filter</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="2" RowSpan="2" Scheme="secondary" CornerIcon="@Icons.Material.Filled.FormatListNumbered">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Metadata</MudText>
                    <strong>@ChapterCountLabel</strong>
                    <span>@VolumeCountLabel</span>
                </div>
            </MangaBentoTile>
        </MangaBento>

        <MudCardActions Class="mh-bento-card-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="Edit">Edit metadata</MudButton>
        </MudCardActions>
    </MudCardContent>
</MudCard>
