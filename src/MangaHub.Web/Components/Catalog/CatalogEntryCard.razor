<MudCard Elevation="0" Outlined="true" Class="mh-row-card">
    <div class="mh-cover-frame">
        @if (!string.IsNullOrWhiteSpace(Entry.CoverUrl))
        {
            <MudImage Src="@Entry.CoverUrl" Alt="@($"{Entry.Title} cover")" Class="mh-row-cover" />
        }
        else
        {
            <div class="mh-cover-placeholder" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
            </div>
        }
        <div class="mh-cover-caption">
            <span>First published</span>
            <strong>@FirstYearLabel</strong>
        </div>
    </div>

    <button type="button" class="mh-mobile-entry-header" @onclick="OpenMetadata" aria-label="@($"Open metadata for {Entry.Title}")">
        <div class="mh-title-block">
            <MudText Typo="Typo.h4" Class="mh-row-title">@Entry.Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Entry.Authors))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Entry.Authors</MudText>
            }
        </div>

        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mh-primary-tags flex-wrap">
            @if (IsMissingMyAnimeListId)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.WarningAmber" Class="mh-card-chip mh-metadata-warning">MAL ID missing</MudChip>
            }
            @if (!string.IsNullOrWhiteSpace(VisibleCategoryLabel))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mh-card-chip">@VisibleCategoryLabel</MudChip>
            }
            @if (HasHiddenCategories)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mh-card-chip mh-count-chip">+@HiddenCategoryCount</MudChip>
            }
        </MudStack>
    </button>

    <MudCardContent Class="mh-bento-card-content">
        <MangaBento Columns="5" ItemMinHeight="52" RowHeight="52" Class="mh-entry-bento">
            <MangaBentoTile ColSpan="4" RowSpan="4" Scheme="soft" OnClick="OpenMetadata" AriaLabel="@($"Open metadata for {Entry.Title}")">
                <div class="mh-entry-main">
                    <div class="mh-entry-topline">
                        <div class="mh-title-block">
                            <MudText Typo="Typo.h3" Class="mh-row-title">@Entry.Title</MudText>
                            @if (!string.IsNullOrWhiteSpace(Entry.Authors))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@Entry.Authors</MudText>
                            }
                        </div>

                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mh-primary-tags flex-wrap">
                            @if (IsMissingMyAnimeListId)
                            {
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Warning"
                                         Variant="Variant.Filled"
                                         Icon="@Icons.Material.Filled.WarningAmber"
                                         Class="mh-card-chip mh-metadata-warning">
                                    MAL ID missing
                                </MudChip>
                            }
                            @if (!string.IsNullOrWhiteSpace(VisibleCategoryLabel))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mh-card-chip">@VisibleCategoryLabel</MudChip>
                            }
                            @if (HasHiddenCategories)
                            {
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Primary"
                                         Variant="Variant.Outlined"
                                         Class="mh-card-chip mh-count-chip">+@HiddenCategoryCount</MudChip>
                            }
                        </MudStack>
                    </div>

                @if (!string.IsNullOrWhiteSpace(Entry.Description))
                {
                    <div class="mh-row-summary">
                        @Entry.Description
                    </div>
                }

                    <div class="mh-entry-context mh-mobile-hide">
                        <div>
                            <span>Identity</span>
                            <strong>@IdentityLabel</strong>
                        </div>
                        <div>
                            <span>MangaDex sync</span>
                            <strong>@MangaDexSyncLabel</strong>
                        </div>
                        <div>
                            <span>Cached chapters</span>
                            <strong>@CachedChapterLabel</strong>
                        </div>
                        <div>
                            <span>MangaUpdates</span>
                            <strong>@MangaUpdatesStatusLabel</strong>
                        </div>
                    </div>

                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="@SourceScheme" OnClick="FilterBySource" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Source</MudText>
                    <MudText Typo="Typo.h3">@SourceLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">@SourceFilterHint</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="@SourceGapScheme" Class="@($"mh-entry-stat-tile mh-source-gap-tile {SourceGapClass}")">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">@SourceGapHeading</MudText>
                    <strong>@SourceGapValue</strong>
                    <span class="mh-mobile-hide">@SourceGapDetail</span>
                </div>
            </MangaBentoTile>

         @*    <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="soft" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Volumes</MudText>
                    <MudText Typo="Typo.h3">@VolumeCountLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Current count</MudText>
                </div>
            </MangaBentoTile> *@

            @* <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="primary" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Format</MudText>
                    <MudText Typo="Typo.h3">@FormatLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">@Entry.Category</MudText>
                </div>
            </MangaBentoTile> *@

            @* <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="warm" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Status</MudText>
                    <MudText Typo="Typo.h3">@PublishingLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Release</MudText>
                </div>
            </MangaBentoTile> *@

        </MangaBento>

        <MudCardActions Class="mh-bento-card-actions">
            @if (HasMangaDexLink)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="ManageCache">Manage cached chapters</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="Edit">Edit metadata</MudButton>
        </MudCardActions>
    </MudCardContent>
</MudCard>

@if (metadataOpen)
{
    <div class="mh-modal-backdrop" @onclick="CloseMetadata">
        <section class="mh-modal mh-card-metadata-modal" role="dialog" aria-modal="true" aria-labelledby="@MetadataTitleId" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mh-modal-header">
                    <MudStack Spacing="1">
                        <MudText id="@MetadataTitleId" Typo="Typo.h2">@Entry.Title</MudText>
                        @if (!string.IsNullOrWhiteSpace(Entry.Authors))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@Entry.Authors</MudText>
                        }
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="CloseMetadata" aria-label="Close catalog metadata" />
                </MudStack>

                @if (CategoryLabels.Count > 0)
                {
                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                        @foreach (var category in CategoryLabels)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@category</MudChip>
                        }
                    </MudStack>
                }

                @if (!string.IsNullOrWhiteSpace(Entry.Description))
                {
                    <MudText Typo="Typo.body1">@Entry.Description</MudText>
                }

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">MAL identity</MudText><MudText Typo="Typo.body2" Color="@(IsMissingMyAnimeListId ? Color.Warning : Color.Default)">@IdentityLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Source</MudText><MudText Typo="Typo.body2">@SourceLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Chapters</MudText><MudText Typo="Typo.body2">@ChapterCountLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Volumes</MudText><MudText Typo="Typo.body2">@VolumeCountLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Format</MudText><MudText Typo="Typo.body2">@FormatLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Status</MudText><MudText Typo="Typo.body2">@PublishingLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Reader setup</MudText><MudText Typo="Typo.body2">@ReaderLinksLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">MangaDex sync</MudText><MudText Typo="Typo.body2">@MangaDexSyncLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">MangaUpdates</MudText><MudText Typo="Typo.body2">@MangaUpdatesStatusLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Source coverage</MudText><MudText Typo="Typo.body2">@SourceGapModalDetail</MudText></MudItem>
                </MudGrid>
            </MudStack>
        </section>
    </div>
}
