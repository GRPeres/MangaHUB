@if (Open)
{
    <div class="mh-modal-backdrop" @onclick="Close">
        <section class="mh-modal" role="dialog" aria-modal="true" aria-labelledby="catalog-add-title" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mh-modal-header">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Catalog</MudText>
                        <MudText id="catalog-add-title" Typo="Typo.h2">@(IsEditMode ? "Edit catalog manga" : "Add catalog manga")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Type a title to see optional metadata suggestions, or complete the fields manually.</MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" Disabled="@isSaving" OnClick="Close" aria-label="Close catalog add form" />
                </MudStack>

                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <div class="mh-metadata-title-anchor">
                            <MangaDebouncedSearch @bind-Value="title"
                                                  Label="Title"
                                                  AriaLabel="Search metadata by manga title"
                                                  IsLoading="@(isSearchingMetadata || isMatchingMangaDex)"
                                                  Disabled="@isSaving"
                                                  OnSearch="SearchMetadata" />

                            <MudPopover Open="@(isSearchingMetadata || metadataResults.Count > 0 || !string.IsNullOrWhiteSpace(metadataMessage))"
                                        AnchorOrigin="Origin.BottomLeft"
                                        TransformOrigin="Origin.TopLeft"
                                        Class="mh-metadata-suggestions-popover">
                                <MudPaper Elevation="8" Outlined="true" Class="pa-2 mh-metadata-suggestions">
                                    <MudStack Spacing="1">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Metadata suggestions</MudText>
                                            @if (isSearchingMetadata)
                                            {
                                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Secondary" />
                                            }
                                        </MudStack>
                                        @if (metadataResults.Count > 0)
                                        {
                                            @foreach (var item in metadataResults.Take(5))
                                            {
                                                <MudButton Variant="Variant.Text"
                                                           Color="Color.Inherit"
                                                           FullWidth="true"
                                                           Class="justify-start text-left"
                                                           Disabled="@isMatchingMangaDex"
                                                           OnClick="() => ApplyMetadata(item)">
                                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="w-100">
                                                        @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                                                        {
                                                            <img src="@item.CoverUrl" alt="@($"{item.Title} cover")" class="mh-suggestion-cover" />
                                                        }
                                                        <MudStack Spacing="0" Class="flex-grow-1 overflow-hidden">
                                                            <MudText Typo="Typo.body2" Class="text-truncate">@item.Title</MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">@item.Authors @(!string.IsNullOrWhiteSpace(item.Source) ? $"- {item.Source}" : "")</MudText>
                                                        </MudStack>
                                                    </MudStack>
                                                </MudButton>
                                            }
                                        }
                                        else if (!isSearchingMetadata)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@metadataMessage</MudText>
                                        }
                                    </MudStack>
                                </MudPaper>
                            </MudPopover>
                        </div>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="authors" Label="Authors" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" @bind-Value="category" Label="Type / category" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField T="int?" @bind-Value="firstPublishYear" Label="First publish year" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" @bind-Value="openLibraryKey" Label="OpenLibrary key" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" @bind-Value="myAnimeListId" Label="MyAnimeList ID" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" @bind-Value="mediaType" Label="Media type" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" @bind-Value="publishingStatus" Label="Publishing status" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudNumericField T="int?" @bind-Value="chapterCount" Label="Chapters" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudNumericField T="int?" @bind-Value="volumeCount" Label="Volumes" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="coverUrl" Label="Cover image URL" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="mangaDexId" Label="MangaDex ID" Variant="Variant.Outlined" Disabled="@isMatchingMangaDex" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="fallbackReaderUrl" Label="Fallback reader URL" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="mangaUpdatesId" Label="MangaUpdates ID" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="localSeriesIdText" Label="Local scanned series" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("")">None</MudSelectItem>
                            @foreach (var series in LocalSeries)
                            {
                                <MudSelectItem T="string" Value="@series.Id.ToString()">@series.Title</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="description" Label="Summary / description" Variant="Variant.Outlined" Lines="4" />
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(isSaving ? null : Icons.Material.Filled.LibraryAdd)" Disabled="@isSaving" OnClick="Save">
                        @if (isSaving)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                        }
                        @(isSaving ? (IsEditMode ? "Saving..." : "Adding...") : (IsEditMode ? "Save catalog metadata" : "Add to catalog"))
                    </MudButton>
                </MudStack>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <MudAlert Severity="@messageSeverity" Variant="Variant.Outlined">@message</MudAlert>
                }
            </MudStack>
        </section>
    </div>
}
