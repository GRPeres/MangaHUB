@using MangaHub.Core.Services
@using MangaHub.Web.API.DTOs
@using MangaHub.Web.API.Services
@inject IssueApiService Issues
@inject MessageService Messages

@if (Open)
{
    <div class="mh-modal-backdrop" @onclick="Close">
        <section class="mh-modal mh-issue-report-modal" role="dialog" aria-modal="true" aria-labelledby="cover-image-report-title" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween"><MudStack Spacing="0"><MudText id="cover-image-report-title" Typo="Typo.h2">Report cover image</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">@Title</MudText></MudStack><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" aria-label="Close cover report" /></MudStack>
                <MudSelect T="string" @bind-Value="reason" Label="What is wrong?" Variant="Variant.Outlined"><MudSelectItem Value="@("missing")">Cover is missing</MudSelectItem><MudSelectItem Value="@("broken")">Image does not load</MudSelectItem><MudSelectItem Value="@("wrong-image")">Wrong cover</MudSelectItem><MudSelectItem Value="@("low-quality")">Poor quality</MudSelectItem><MudSelectItem Value="@("other")">Something else</MudSelectItem></MudSelect>
                <MudTextField T="string" @bind-Value="note" Label="Optional note" Lines="3" Variant="Variant.Outlined" MaxLength="800" />
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2"><MudButton Variant="Variant.Text" OnClick="Close">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@saving" OnClick="Submit">@(saving ? "Reporting..." : "Report image")</MudButton></MudStack>
            </MudStack>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public Guid MangaEntryId { get; set; }
    [Parameter] public string Title { get; set; } = "";
    private string reason = "missing";
    private string note = "";
    private bool saving;
    private Task Close() => OpenChanged.InvokeAsync(false);
    private async Task Submit()
    {
        if (saving || MangaEntryId == Guid.Empty) return;
        saving = true;
        try
        {
            var result = await Issues.ReportAsync(new(AdminIssueTypes.CoverImage, AdminIssueTypes.CatalogManga, MangaEntryId, reason, note));
            if (result is null) { Messages.Error("This cover could not be reported.", "Cover report"); return; }
            Messages.Success("Thanks. An admin can now review this shared cover.", "Cover reported");
            await Close();
        }
        finally { saving = false; }
    }
}
