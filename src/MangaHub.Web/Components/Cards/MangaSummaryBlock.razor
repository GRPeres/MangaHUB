<div class="mh-summary-block">
    <MudText Typo="Typo.h3" Class="mh-summary-title">@Title</MudText>
    @if (!string.IsNullOrWhiteSpace(Subtitle))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
    }

    @if (!string.IsNullOrWhiteSpace(Summary))
    {
        <MudText Typo="Typo.body2" Class="mh-summary-text">@Summary</MudText>
    }

    @if (!string.IsNullOrWhiteSpace(Notes))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mh-summary-notes">@Notes</MudText>
    }
</div>
