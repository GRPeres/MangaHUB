<div class="mh-cover-block">
    @if (!string.IsNullOrWhiteSpace(CoverUrl))
    {
        <MudImage Src="@CoverUrl" Alt="@AltText" Class="mh-cover-image" />
    }
    else
    {
        <div class="mh-cover-placeholder" aria-hidden="true">
            <MudIcon Icon="@PlaceholderIcon" />
        </div>
    }
</div>
