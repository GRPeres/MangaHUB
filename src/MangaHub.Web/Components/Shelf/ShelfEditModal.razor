@if (Entry is not null)
{
    <div class="mh-modal-backdrop" @onclick="Close">
        <section class="mh-modal" role="dialog" aria-modal="true" aria-labelledby="shelf-edit-title" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mh-modal-header">
                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start" Class="mh-selected-manga">
                        @if (!string.IsNullOrWhiteSpace(Entry.CoverUrl))
                        {
                            <MudImage Src="@Entry.CoverUrl" Alt="@($"{Entry.Title} cover")" Class="mh-modal-cover" />
                        }
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">Editing shelf entry</MudText>
                            <MudText id="shelf-edit-title" Typo="Typo.h2">@Entry.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@Entry.Authors</MudText>
                            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@Entry.ReadingStatus</MudChip>
                                @if (!string.IsNullOrWhiteSpace(Entry.CurrentChapter))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Ch. @Entry.CurrentChapter</MudChip>
                                }
                                @if (Entry.Score is not null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@($"{Entry.Score}/5")</MudChip>
                                }
                            </MudStack>
                        </MudStack>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" Disabled="@IsBusy" OnClick="Close" aria-label="Close editor" />
                </MudStack>

                <MudDivider />

                <MudGrid Spacing="3">
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" @bind-Value="editStatus" Label="Status" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("reading")">Reading</MudSelectItem>
                            <MudSelectItem T="string" Value="@("done")">Done</MudSelectItem>
                            <MudSelectItem T="string" Value="@("paused")">Paused</MudSelectItem>
                            <MudSelectItem T="string" Value="@("planned")">Planned</MudSelectItem>
                            <MudSelectItem T="string" Value="@("dropped")">Dropped</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField T="string" @bind-Value="editChapter" Label="Chapter" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudNumericField T="int?" @bind-Value="editScore" Label="Score" Variant="Variant.Outlined" Min="1" Max="5" />
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudTextField T="string" @bind-Value="editCategory" Label="Type / genre" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="editNotes" Label="Notes" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="editSummary" Label="Summary" Variant="Variant.Outlined" Lines="3" />
                    </MudItem>
                </MudGrid>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <MudAlert Severity="@messageSeverity" Variant="Variant.Outlined">@message</MudAlert>
                }

                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(isSaving ? null : Icons.Material.Filled.Save)" Disabled="@IsBusy" OnClick="SaveEdit">
                        @if (isSaving)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                        }
                        @(isSaving ? "Saving..." : "Save changes")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@(isRemoving ? null : Icons.Material.Filled.Delete)" Disabled="@IsBusy" OnClick="RemoveEntry">
                        @if (isRemoving)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                        }
                        @(isRemoving ? "Removing..." : "Remove from shelf")
                    </MudButton>
                </MudStack>
            </MudStack>
        </section>
    </div>
}
