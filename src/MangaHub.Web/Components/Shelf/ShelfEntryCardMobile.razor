<MudCard Elevation="0" Outlined="true" Class="@CardClass">
    <div class="mh-mobile-shelf-cover" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(Entry.CoverUrl))
        {
            <MudImage Src="@Entry.CoverUrl" Alt="" Class="mh-mobile-shelf-cover-image" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
        }
    </div>

    <div class="mh-mobile-shelf-header">
        <button type="button" class="mh-mobile-shelf-summary" @onclick="ToggleDetails" aria-expanded="@detailsOpen" aria-label="@($"Show reading details for {Entry.Title}")">
            <MudText Typo="Typo.h5" Class="mh-mobile-shelf-title">@Entry.Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Entry.Authors))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mh-mobile-shelf-subtitle">@Entry.Authors</MudText>
            }
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
                @if (!string.IsNullOrWhiteSpace(VisibleGenreLabel))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mh-mobile-shelf-chip">@VisibleGenreLabel</MudChip>
                }
                @if (HasHiddenGenres)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mh-mobile-shelf-chip">+@HiddenGenreCount</MudChip>
                }
            </MudStack>
        </button>

        @if (HasNewChapters)
        {
            <div class="mh-mobile-shelf-release" aria-label="@($"{NewChapterCount} new chapters, latest {LatestChapterValue}")">
                <span>New</span>
                <strong>+@NewChapterCount</strong>
            </div>
        }

        <div class="mh-mobile-shelf-actions">
            @if (CanRead)
            {
                @if (OpensExternalReader)
                {
                    <MudTooltip Text="Read in external reader"><MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Primary" Href="@Entry.FallbackReaderUrl" Target="_blank" Rel="noopener noreferrer" aria-label="Read in external reader" /></MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Read"><MudIconButton Icon="@Icons.Material.Filled.AutoStories" Color="Color.Primary" OnClick="Read" aria-label="Read" /></MudTooltip>
                }
                @if (ShowsExternalReaderAction)
                {
                    <MudTooltip Text="Open external reader"><MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Primary" Href="@Entry.FallbackReaderUrl" Target="_blank" Rel="noopener noreferrer" aria-label="Open external reader" /></MudTooltip>
                }
            }
            <MudTooltip Text="Edit shelf entry"><MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Secondary" OnClick="Edit" aria-label="Edit shelf entry" /></MudTooltip>
        </div>

    </div>

    @if (detailsOpen)
    {
        <MudCardContent Class="mh-mobile-shelf-details">
            <MangaBento Columns="2" ItemMinHeight="72" RowHeight="72" Class="mh-mobile-shelf-bento">
                @if (!string.IsNullOrWhiteSpace(DescriptionText))
                {
                    <MangaBentoTile ColSpan="2" RowSpan="1" Scheme="soft" OnClick="OpenMetadata" AriaLabel="@($"Open full metadata for {Entry.Title}")" Class="mh-mobile-shelf-description">
                        <div class="mh-mobile-shelf-stat"><MudText Typo="Typo.overline">Description</MudText><MudText Typo="Typo.body2">@DescriptionText</MudText></div>
                    </MangaBentoTile>
                }
                <MangaBentoTile ColSpan="1" RowSpan="1" Scheme="@StatusScheme" OnClick="FilterByStatus">
                    <div class="mh-mobile-shelf-stat"><MudText Typo="Typo.overline">Status</MudText><MudText Typo="Typo.h6">@StatusLabel</MudText></div>
                </MangaBentoTile>
                <MangaBentoTile ColSpan="1" RowSpan="1" Scheme="@ProgressScheme" Class="@(HasNewChapters ? "mh-mobile-shelf-release-tile" : "")">
                    <div class="mh-mobile-shelf-stat"><MudText Typo="Typo.overline">@(HasNewChapters ? "New" : "Progress")</MudText><MudText Typo="Typo.h6">@(HasNewChapters ? $"+{NewChapterCount}" : CurrentChapterValue)</MudText><MudText Typo="Typo.caption">@(HasNewChapters ? $"Latest {LatestChapterValue}" : ProgressHint)</MudText></div>
                </MangaBentoTile>
            </MangaBento>
            <MudCardActions Class="mh-mobile-shelf-rating" aria-label="@($"Rate {Entry.Title}")">
                <MudText Typo="Typo.overline">Your rating</MudText>
                <div class="mh-mobile-shelf-stars">
                    @for (var value = 1; value <= 5; value++)
                    {
                        var score = value;
                        var selected = IsStarSelected(score);
                        <MudIconButton Icon="@(selected ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" Color="@(selected ? Color.Secondary : Color.Default)" Size="Size.Medium" Disabled="@isSavingScore" OnClick="() => SetScore(score)" aria-label="@(selectedScore == score ? $"Clear {score}-star rating" : $"Rate {score} of 5")" />
                    }
                </div>
            </MudCardActions>
        </MudCardContent>
    }
</MudCard>

@if (metadataOpen)
{
    <div class="mh-modal-backdrop" @onclick="CloseMetadata">
        <section class="mh-modal mh-card-metadata-modal" role="dialog" aria-modal="true" aria-labelledby="@MetadataTitleId" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mh-modal-header"><MudText id="@MetadataTitleId" Typo="Typo.h2">@Entry.Title</MudText><MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="CloseMetadata" aria-label="Close manga metadata" /></MudStack>
                @if (GenreLabels.Count > 0) { <MudStack Row="true" Spacing="1" Class="flex-wrap">@foreach (var category in GenreLabels) { <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@category</MudChip> }</MudStack> }
                @if (!string.IsNullOrWhiteSpace(DescriptionText)) { <MudText Typo="Typo.body1">@DescriptionText</MudText> }
                <MudGrid Spacing="2"><MudItem xs="6"><MudText Typo="Typo.overline">Status</MudText><MudText Typo="Typo.body2">@StatusLabel</MudText></MudItem><MudItem xs="6"><MudText Typo="Typo.overline">Current</MudText><MudText Typo="Typo.body2">@CurrentChapterValue</MudText></MudItem><MudItem xs="6"><MudText Typo="Typo.overline">Newest</MudText><MudText Typo="Typo.body2">@LatestChapterValue</MudText></MudItem><MudItem xs="6"><MudText Typo="Typo.overline">Score</MudText><MudText Typo="Typo.body2">@ScoreLabel</MudText></MudItem></MudGrid>
            </MudStack>
        </section>
    </div>
}
