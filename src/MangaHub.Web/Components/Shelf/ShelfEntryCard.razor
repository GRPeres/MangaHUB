<div class="mh-card-desktop-view">
<MudCard Elevation="0" Outlined="true" Class="@CardClass">
    <div class="mh-cover-frame">
        @if (!string.IsNullOrWhiteSpace(Entry.CoverUrl))
        {
            <MudImage Src="@Entry.CoverUrl" Alt="@($"{Entry.Title} cover")" Class="mh-row-cover" />
        }
        else
        {
            <div class="mh-cover-placeholder" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
            </div>
        }
        <div class="mh-cover-caption">
            <span>Read from</span>
            <strong>@ReadSourceLabel</strong>
        </div>
    </div>

    <MudCardContent Class="mh-bento-card-content">
        <MangaBento Columns="5" ItemMinHeight="52" RowHeight="52" Class="mh-entry-bento">
            <MangaBentoTile ColSpan="4" RowSpan="4" Scheme="primary" OnClick="OpenMetadata" AriaLabel="@($"Open metadata for {Entry.Title}")">
                <div class="mh-entry-main">
                    <div class="mh-entry-topline">
                        <div class="mh-title-block">
                            <MudText Typo="Typo.h3" Class="mh-row-title">@Entry.Title</MudText>
                            @if (!string.IsNullOrWhiteSpace(Entry.Authors))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@Entry.Authors</MudText>
                            }
                        </div>

                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mh-primary-tags flex-wrap">
                            @if (!string.IsNullOrWhiteSpace(VisibleGenreLabel))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mh-card-chip">@VisibleGenreLabel</MudChip>
                            }
                            @if (HasHiddenGenres)
                            {
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Primary"
                                         Variant="Variant.Outlined"
                                         Class="mh-card-chip mh-count-chip">+@HiddenGenreCount</MudChip>
                            }
                        </MudStack>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(DescriptionText))
                    {
                        <div class="mh-row-summary">
                            @DescriptionText
                        </div>
                    }

                @if (!string.IsNullOrWhiteSpace(Entry.Notes))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mh-row-notes mh-mobile-hide">@Entry.Notes</MudText>
                }

                    <div class="mh-entry-context mh-mobile-hide">
                        @foreach (var fact in ContextFacts)
                        {
                            <div>
                                <span>@fact.Label</span>
                                <strong>@fact.Value</strong>
                            </div>
                        }
                    </div>

                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="@StatusScheme" OnClick="FilterByStatus" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Status</MudText>
                    <MudText Typo="Typo.h3">@StatusLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">@StatusFilterHint</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="@ProgressScheme" Class="@ProgressTileClass">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">@(HasNewChapters ? "New" : "Progress")</MudText>
                    <MudText Typo="Typo.h3">@(HasNewChapters ? $"+{NewChapterCount}" : CurrentChapterValue)</MudText>
                    <MudText Typo="Typo.caption" Class="@(HasNewChapters ? "" : "mh-mobile-hide")">@(HasNewChapters ? $"Latest {LatestChapterValue}" : ProgressHint)</MudText>
                </div>
            </MangaBentoTile>

           @*  <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="soft" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Newest</MudText>
                    <MudText Typo="Typo.h3">@LatestChapterValue</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Known chapter</MudText>
                </div>
            </MangaBentoTile> *@
            @* 
            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="primary" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Score</MudText>
                    <MudText Typo="Typo.h3">@ScoreLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Personal</MudText>
                </div>
            </MangaBentoTile> *@

           @*  <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="ink" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Next up</MudText>
                    <MudText Typo="Typo.h3">@NextChapterValue</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Reading queue</MudText>
                </div>
            </MangaBentoTile> *@
        </MangaBento>

        <MudCardActions Class="mh-bento-card-actions">
            <div class="mh-entry-score" role="group" aria-label="@($"Rate {Entry.Title}")">
                @for (var value = 1; value <= 5; value++)
                {
                    var score = value;
                    var selected = IsStarSelected(score);
                    <MudTooltip Text="@(selectedScore == score ? $"Clear {score}-star rating" : $"Rate {score} of 5")">
                        <MudIconButton Icon="@(selected ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                       Color="@(selected ? Color.Secondary : Color.Default)"
                                       Size="Size.Small"
                                       Disabled="@isSavingScore"
                                       OnClick="() => SetScore(score)"
                                       aria-label="@(selectedScore == score ? $"Clear {score}-star rating" : $"Rate {score} of 5")" />
                    </MudTooltip>
                }
            </div>
            <div class="mh-entry-action-buttons">
                @if (CanRead)
                {
                    @if (OpensExternalReader)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.OpenInNew"
                                   Href="@Entry.FallbackReaderUrl"
                                   Target="_blank"
                                   Rel="noopener noreferrer">
                            Read
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories" OnClick="Read">Read</MudButton>
                    }
                    @if (ShowsExternalReaderAction)
                    {
                        <MudTooltip Text="Open external reader">
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                           Color="Color.Primary"
                                           Href="@Entry.FallbackReaderUrl"
                                           Target="_blank"
                                           Rel="noopener noreferrer"
                                           aria-label="Open external reader" />
                        </MudTooltip>
                    }
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" OnClick="Edit">Edit</MudButton>
            </div>
        </MudCardActions>
    </MudCardContent>
</MudCard>
</div>

<ShelfEntryCardMobile Entry="@Entry"
                       ActiveStatusFilter="@ActiveStatusFilter"
                       CanRead="@CanRead"
                       OnRead="@OnRead"
                       OnEdit="@OnEdit"
                       OnStatusFilter="@OnStatusFilter"
                       OnScoreChanged="@OnScoreChanged" />

@if (metadataOpen)
{
    <div class="mh-modal-backdrop" @onclick="CloseMetadata">
        <section class="mh-modal mh-card-metadata-modal" role="dialog" aria-modal="true" aria-labelledby="@MetadataTitleId" @onclick:stopPropagation="true">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mh-modal-header">
                    <MudStack Spacing="1">
                        <MudText id="@MetadataTitleId" Typo="Typo.h2">@Entry.Title</MudText>
                        @if (!string.IsNullOrWhiteSpace(Entry.Authors))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@Entry.Authors</MudText>
                        }
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Secondary" OnClick="CloseMetadata" aria-label="Close manga metadata" />
                </MudStack>

                @if (GenreLabels.Count > 0)
                {
                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                        @foreach (var category in GenreLabels)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@category</MudChip>
                        }
                    </MudStack>
                }

                @if (!string.IsNullOrWhiteSpace(DescriptionText))
                {
                    <MudText Typo="Typo.body1">@DescriptionText</MudText>
                }

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Status</MudText><MudText Typo="Typo.body2">@StatusLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Current</MudText><MudText Typo="Typo.body2">@CurrentChapterValue</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Newest</MudText><MudText Typo="Typo.body2">@LatestChapterValue</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">MangaDex sync</MudText><MudText Typo="Typo.body2">@MangaDexSyncLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Score</MudText><MudText Typo="Typo.body2">@ScoreLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Format</MudText><MudText Typo="Typo.body2">@FormatLabel</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.overline">Read from</MudText><MudText Typo="Typo.body2">@ReadSourceLabel</MudText></MudItem>
                </MudGrid>
            </MudStack>
        </section>
    </div>
}
