<MudCard Elevation="0" Outlined="true" Class="mh-row-card">
    <div class="mh-cover-frame">
        @if (!string.IsNullOrWhiteSpace(Entry.CoverUrl))
        {
            <MudImage Src="@Entry.CoverUrl" Alt="@($"{Entry.Title} cover")" Class="mh-row-cover" />
        }
        else
        {
            <div class="mh-cover-placeholder" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
            </div>
        }
        <div class="mh-cover-caption">
            <span>Read from</span>
            <strong>@ReadSourceLabel</strong>
        </div>
    </div>

    <MudCardContent Class="mh-bento-card-content">
        <MangaBento Columns="7" ItemMinHeight="52" RowHeight="52" Class="mh-entry-bento">
            <MangaBentoTile ColSpan="4" RowSpan="4" Scheme="primary">
                <div class="mh-entry-main">
                    <div class="mh-entry-topline">
                        <div class="mh-title-block">
                            <MudText Typo="Typo.h3" Class="mh-row-title">@Entry.Title</MudText>
                            @if (!string.IsNullOrWhiteSpace(Entry.Authors))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@Entry.Authors</MudText>
                            }
                        </div>

                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mh-primary-tags flex-wrap">
                            @if (!string.IsNullOrWhiteSpace(GenreLabel))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@GenreLabel</MudChip>
                            }
                            @if (!string.IsNullOrWhiteSpace(Entry.MediaType))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Entry.MediaType</MudChip>
                            }
                        </MudStack>
                    </div>

                    <MudStack Row="true" Spacing="1" Class="mh-chip-row mh-secondary-tags flex-wrap">
                        @if (!string.IsNullOrWhiteSpace(Entry.PublishingStatus))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Entry.PublishingStatus</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(Entry.MangaDexUrl))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">MangaDex</MudChip>
                        }
                    </MudStack>

                @if (!string.IsNullOrWhiteSpace(Entry.Summary))
                {
                    <MudText Typo="Typo.body2" Class="mh-row-summary">@Entry.Summary</MudText>
                }
                else if (!string.IsNullOrWhiteSpace(Entry.Description))
                {
                    <MudText Typo="Typo.body2" Class="mh-row-summary">@Entry.Description</MudText>
                }

                @if (!string.IsNullOrWhiteSpace(Entry.Notes))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mh-row-notes mh-mobile-hide">@Entry.Notes</MudText>
                }

                    <div class="mh-entry-context mh-mobile-hide">
                        <div>
                            <span>Format</span>
                            <strong>@FormatLabel</strong>
                        </div>
                        <div>
                            <span>Published</span>
                            <strong>@FirstYearLabel</strong>
                        </div>
                        <div>
                            <span>Volumes</span>
                            <strong>@VolumeCountLabel</strong>
                        </div>
                    </div>

                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="@StatusScheme" OnClick="FilterByStatus" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Status</MudText>
                    <MudText Typo="Typo.h3">@StatusLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">@StatusFilterHint</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="secondary" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Current</MudText>
                    <MudText Typo="Typo.h3">@CurrentChapterValue</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Chapter</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="soft" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Newest</MudText>
                    <MudText Typo="Typo.h3">@LatestChapterValue</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Known chapter</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="primary" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Score</MudText>
                    <MudText Typo="Typo.h3">@ScoreLabel</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Personal</MudText>
                </div>
            </MangaBentoTile>

            <MangaBentoTile ColSpan="1" RowSpan="2" Scheme="ink" Class="mh-entry-stat-tile">
                <div class="mh-entry-stat">
                    <MudText Typo="Typo.overline">Next up</MudText>
                    <MudText Typo="Typo.h3">@NextChapterValue</MudText>
                    <MudText Typo="Typo.caption" Class="mh-mobile-hide">Reading queue</MudText>
                </div>
            </MangaBentoTile>
        </MangaBento>

        <MudCardActions Class="mh-bento-card-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories" OnClick="Read">Read</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" OnClick="Edit">Edit</MudButton>
        </MudCardActions>
    </MudCardContent>
</MudCard>
