<MudCard Elevation="0" Outlined="true" Class="mh-row-card">
    <MudGrid Spacing="0" Class="mh-row-grid">
        <MudItem xs="12" md="2">
            <MangaCoverBlock CoverUrl="@Entry.CoverUrl" AltText="@($"{Entry.Title} cover")" />
        </MudItem>

        <MudItem xs="12" md="10">
            <MudCardContent Class="mh-row-content mh-row-bento">
                <BentoBlock Variant="card">
                    <BentoItem Size="BentoBlockSize.Feature">
                        <MudPaper Elevation="0" Outlined="true" Class="mh-bento-summary">
                            <MangaSummaryBlock Title="@Entry.Title" Subtitle="@Entry.Authors" Summary="@SummaryText" Notes="@Entry.Notes" />
                        </MudPaper>
                    </BentoItem>

                    <BentoItem Size="BentoBlockSize.Tall">
                        <MangaInfoBlock Label="Status"
                                        Value="@StatusLabel"
                                        Icon="@StatusIcon"
                                        Tone="@StatusTone"
                                        Active="@IsStatusFilterActive"
                                        OnClick="FilterByStatus" />
                    </BentoItem>
                    @if (!string.IsNullOrWhiteSpace(GenreLabel))
                    {
                        <BentoItem Size="BentoBlockSize.Wide">
                            <MangaInfoBlock Label="Category" Value="@GenreLabel" Icon="@Icons.Material.Filled.Category" />
                        </BentoItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(SourceLabel))
                    {
                        <BentoItem>
                            <MangaInfoBlock Label="Source" Value="@SourceLabel" Icon="@Icons.Material.Filled.TravelExplore" />
                        </BentoItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(Entry.MediaType))
                    {
                        <BentoItem>
                            <MangaInfoBlock Label="Format" Value="@Entry.MediaType" Icon="@Icons.Material.Filled.Style" />
                        </BentoItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(Entry.PublishingStatus))
                    {
                        <BentoItem Size="BentoBlockSize.Wide">
                            <MangaInfoBlock Label="Release" Value="@Entry.PublishingStatus" Icon="@Icons.Material.Filled.Update" Tone="progress" />
                        </BentoItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(AvailabilityLabel))
                    {
                        <BentoItem Size="BentoBlockSize.Wide">
                            <MangaInfoBlock Label="Read from" Value="@AvailabilityLabel" Icon="@Icons.Material.Filled.AutoStories" />
                        </BentoItem>
                    }

                    <BentoItem Size="BentoBlockSize.Wide">
                        <MangaInfoBlock Label="Current" Value="@CurrentChapterLabel" Icon="@Icons.Material.Filled.Bookmark" Tone="progress" />
                    </BentoItem>
                    <BentoItem>
                        <MangaInfoBlock Label="Latest" Value="@LatestChapterLabel" Icon="@Icons.Material.Filled.NewReleases" Tone="progress" />
                    </BentoItem>
                    @if (Entry.Score is not null)
                    {
                        <BentoItem>
                            <MangaInfoBlock Label="Score" Value="@($"{Entry.Score}/5")" Icon="@Icons.Material.Filled.Star" Tone="success" />
                        </BentoItem>
                    }

                    <BentoItem Size="BentoBlockSize.Wide">
                        <MudPaper Elevation="0" Outlined="true" Class="mh-bento-actions">
                            <MangaCardActions>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories" OnClick="Read">Read</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" OnClick="Edit">Edit</MudButton>
                            </MangaCardActions>
                        </MudPaper>
                    </BentoItem>
                </BentoBlock>
            </MudCardContent>
        </MudItem>
    </MudGrid>
</MudCard>
