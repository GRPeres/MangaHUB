<span class="mh-nav-button-host">
    <MudTooltip Text="@Label" Placement="Placement.Right" Class="mh-nav-tooltip" Disabled="@Expanded">
        <MudButton Variant="Variant.Text"
                   Color="@(IsActive ? Color.Primary : Color.Inherit)"
                   StartIcon="@Icon"
                   Class="@ButtonClass"
                   FullWidth="true"
                   OnClick="HandleClick">
            @if (Expanded)
            {
                <span class="mh-nav-button-label">@Label</span>
            }
        </MudButton>
    </MudTooltip>
    @if (BadgeCount > 0)
    {
        <span class="mh-nav-attention-count" role="status" aria-label="@($"{BadgeCount} items need attention")">@BadgeCount</span>
    }
</span>
