DATABASE_URL=Host=postgres;Database=mangahub;Username=mangahub;Password=mangahub
JWT_SECRET=change-me-before-deploying-to-a-long-random-secret
LIBRARY_PATH=/library
MANGADEX_ENABLED=true
MangaHub__RemoteRequests__MangaDexApi__RequestsPerSecond=2
MangaHub__RemoteRequests__MangaDexPages__RequestsPerSecond=1
MangaHub__RemoteRequests__MangaUpdates__RequestsPerSecond=0.5
MangaHub__RemoteRequests__MyAnimeList__RequestsPerSecond=1
MangaHub__RemoteRequests__OpenLibrary__RequestsPerSecond=0.5
ASPNETCORE_ENVIRONMENT=Production
